     public abstract boolean performTest(Map<AbilityKey, Object> runParams);
 
+    // CR 805.4d: a shared team turn's step is run once for each player of the active team. An ability that triggers at
+    // the beginning of "each player's" step triggers for each of them only if it refers to that player; otherwise it
+    // triggers once, on the run of the first active player it matches
+    protected final boolean firesForTeamRun(final Map<AbilityKey, Object> runParams) {
+        final forge.game.Game game = getHostCard().getGame();
+        final Object p = runParams.get(AbilityKey.Player);
+        if (!game.getRules().hasSharedTeamTurns() || !(p instanceof Player) || refersToTriggeredPlayer()) {
+            return true;
+        }
+        for (final Player member : game.getPhaseHandler().getActiveTeam()) {
+            if (member.equals(p)) {
+                return true;
+            }
+            if (matchesValidParam("ValidPlayer", member)) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    // the trigger condition, its intervening "if" or its effect names that player: TriggeredPlayer, or that step's active
+    // player (CR 805.9)
+    private boolean refersToTriggeredPlayer() {
+        final Card host = getHostCard();
+        final Deque<String> todo = new ArrayDeque<>();
+        for (final Map.Entry<String, String> param : getMapParams().entrySet()) {
+            if (!param.getKey().endsWith("Description")) {
+                todo.push(param.getValue());
+            }
+        }
+        for (SpellAbility sa = getOverridingAbility(); sa != null; sa = sa.getSubAbility()) {
+            for (final Map.Entry<String, String> param : sa.getMapParams().entrySet()) {
+                if (!param.getKey().endsWith("Description")) {
+                    todo.push(param.getValue());
+                }
+            }
+        }
+        final Set<String> seen = new HashSet<>();
+        while (!todo.isEmpty() && seen.size() < 200) {
+            final String text = todo.pop();
+            if (text.contains("TriggeredPlayer") || text.contains("ActivePlayer")) {
+                return true;
+            }
+            for (final String token : text.split("[^A-Za-z0-9_]+")) {
+                if (!token.isEmpty() && seen.add(token) && host.hasSVar(token)) {
+                    todo.push(host.getSVar(token));
+                }
+            }
+        }
+        return false;
+    }
+
+    // house rule (2HG): a life gain or loss by a teammate of this trigger's controller counts as the controller's own
+    protected final boolean matchesValidLifePlayer(final Object o) {
+        if (matchesValidParam("ValidPlayer", o)) {
+            return true;
+        }
+        final Player you = getHostCard().getController();
+        return o instanceof Player p && p != you && you != null && p.lifeEventTeam().contains(you)
+                && matchesValidParam("ValidPlayer", you);
+    }
+
     /**
      * <p>
      * setTriggeringObjects.
