+    // The defender choice's share of an attack declaration's budget (AiAttackController.choosePreferredDefenderPlayer):
+    // while it runs, the combat deadline is half of what is left, so its combat predictions stop there and the
+    // declaration itself (doAssault and the rest) keeps the other half. Returns the deadline to put back.
+    private static final java.util.concurrent.atomic.AtomicLong COMBAT_SHARES = new java.util.concurrent.atomic.AtomicLong();
+    public static long getCombatShares() {
+        return COMBAT_SHARES.get();
+    }
+    public long halveCombatDeadline() {
+        final long outer = combatDeadline;
+        final long now = System.currentTimeMillis();
+        // (one already passed stays as it is: moved to "now" it would count as not passed yet)
+        if (outer != Long.MAX_VALUE && outer > now) {
+            combatDeadline = now + (outer - now) / 2;
+            COMBAT_SHARES.incrementAndGet();
+        }
+        return outer;
+    }
+    public void restoreCombatDeadline(final long outer) {
+        combatDeadline = outer;
+    }
