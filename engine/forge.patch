diff --git a/forge-game/src/main/java/forge/game/staticability/StaticSourceScope.java b/forge-game/src/main/java/forge/game/staticability/StaticSourceScope.java
new file mode 100644
index 00000000..6a5138ad
--- /dev/null
+++ b/forge-game/src/main/java/forge/game/staticability/StaticSourceScope.java
@@ -0,0 +1,142 @@
+package forge.game.staticability;
+
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+
+import forge.game.Game;
+import forge.game.card.Card;
+import forge.game.card.CardCollection;
+import forge.game.zone.ZoneType;
+
+// A caller that checks many abilities against one unchanged board (the harness's action list) opens a scope: within
+// it the loops over every card's static abilities visit only the cards that have a static of the mode they look for,
+// in the same order. A card without one adds nothing to those loops, so the result is the same. The lead card (the
+// ability's host) is always read live. Without a scope the lists are built as before.
+public final class StaticSourceScope {
+    private static final ThreadLocal<Map<String, Sources>> SCOPE = new ThreadLocal<>();
+
+    private record Sources(List<Card> all, Map<Card, Integer> at, List<Card> having) {
+    }
+
+    private StaticSourceScope() {
+    }
+
+    public static boolean begin() {
+        if (SCOPE.get() != null) {
+            return false;
+        }
+        SCOPE.set(new HashMap<>());
+        return true;
+    }
+
+    // after something that can change which cards have which static abilities (stack statics applied)
+    public static void clear() {
+        final Map<String, Sources> scope = SCOPE.get();
+        if (scope != null) {
+            scope.clear();
+        }
+    }
+
+    public static void end() {
+        SCOPE.remove();
+    }
+
+    // CostAdjustment's cards: the battlefield, the stack and the command zone, then the host if none of them has it
+    public static Iterable<Card> costSources(final Game game, final Card host, final StaticAbilityMode... modes) {
+        final Map<String, Sources> scope = SCOPE.get();
+        if (scope == null) {
+            final CardCollection cards = costCards(game);
+            if (!cards.contains(host)) {
+                cards.add(host);
+            }
+            return cards;
+        }
+        final Sources s = scope.computeIfAbsent("cost:" + Arrays.toString(modes), k -> index(costCards(game), modes));
+        final Integer hostAt = s.at().get(host);
+        final List<Card> out = new ArrayList<>(s.having().size() + 1);
+        if (hostAt == null) {
+            out.addAll(s.having());
+            out.add(host);
+            return out;
+        }
+        final Card listed = s.all().get(hostAt);
+        boolean placed = false;
+        for (final Card c : s.having()) {
+            if (!placed && s.at().get(c) >= hostAt) {
+                out.add(listed);
+                placed = true;
+                if (c.equals(listed)) {
+                    continue;
+                }
+            }
+            out.add(c);
+        }
+        if (!placed) {
+            out.add(listed);
+        }
+        return out;
+    }
+
+    // Game.getStaticSourceCards(lead): the lead first, then the static source zones without it
+    public static Iterable<Card> staticSources(final Game game, final Card lead, final StaticAbilityMode... modes) {
+        final Map<String, Sources> scope = SCOPE.get();
+        if (scope == null) {
+            return game.getStaticSourceCards(lead);
+        }
+        final Sources s = scope.computeIfAbsent("src:" + Arrays.toString(modes),
+                k -> index(new ArrayList<>(game.getCardsIn(ZoneType.STATIC_ABILITIES_SOURCE_ZONES)), modes));
+        final List<Card> out = new ArrayList<>(s.having().size() + 1);
+        out.add(lead);
+        for (final Card c : s.having()) {
+            if (!c.equals(lead)) {
+                out.add(c);
+            }
+        }
+        return out;
+    }
+
+    // the static source zones, as Game.getCardsIn(STATIC_ABILITIES_SOURCE_ZONES)
+    public static Iterable<Card> staticSources(final Game game, final StaticAbilityMode... modes) {
+        final Map<String, Sources> scope = SCOPE.get();
+        if (scope == null) {
+            return game.getCardsIn(ZoneType.STATIC_ABILITIES_SOURCE_ZONES);
+        }
+        return scope.computeIfAbsent("src:" + Arrays.toString(modes),
+                k -> index(new ArrayList<>(game.getCardsIn(ZoneType.STATIC_ABILITIES_SOURCE_ZONES)), modes)).having();
+    }
+
+    private static CardCollection costCards(final Game game) {
+        final CardCollection cards = new CardCollection(game.getCardsIn(ZoneType.Battlefield));
+        cards.addAll(game.getCardsIn(ZoneType.Stack));
+        cards.addAll(game.getCardsIn(ZoneType.Command));
+        return cards;
+    }
+
+    private static Sources index(final List<Card> all, final StaticAbilityMode[] modes) {
+        final List<Card> list = new ArrayList<>(all);
+        final Map<Card, Integer> at = new HashMap<>();
+        final List<Card> having = new ArrayList<>();
+        for (int i = 0; i < list.size(); i++) {
+            final Card c = list.get(i);
+            at.putIfAbsent(c, i);
+            if (hasMode(c, modes)) {
+                having.add(c);
+            }
+        }
+        return new Sources(list, at, having);
+    }
+
+    private static boolean hasMode(final Card c, final StaticAbilityMode[] modes) {
+        for (final StaticAbility st : c.getStaticAbilities()) {
+            for (final StaticAbilityMode mode : modes) {
+                if (st.checkMode(mode)) {
+                    return true;
+                }
+            }
+        }
+        return false;
+    }
+}
