@@ -0,0 +1,120 @@
+package forge.game.zone;
+
+import java.util.EnumSet;
+import java.util.Map;
+import java.util.Set;
+
+import org.apache.commons.lang3.StringUtils;
+
+import forge.game.Game;
+import forge.game.ability.ApiType;
+import forge.game.card.Card;
+import forge.game.replacement.ReplacementEffect;
+import forge.game.replacement.ReplacementType;
+import forge.game.spellability.SpellAbility;
+import forge.game.trigger.Trigger;
+import forge.game.trigger.TriggerType;
+import forge.game.trigger.WrappedAbility;
+
+/**
+ * Big turns (mtg-tts docs/big-turns.md): a run of identical stack items resolved back to back. After the top item
+ * resolves, up to {@link #MAX_FOLLOWING} items below it that are alike ({@link #alike}) resolve at once, each through
+ * the usual AbilityUtils.resolve with its own source, with no priority round, no state-based-action check and no
+ * static-ability pass between them; those run once after the last, as after any resolution.
+ *
+ * <p>Two things must hold, and both are checked here, not assumed:
+ * <ul>
+ * <li>No player loses a decision. The gate ({@link Gate}, set by the host) says how many more items may resolve
+ * before some player must be asked again: the mtg-tts harness allows a merge only when every player still in the
+ * game is a person holding a pass for the whole stack (an "exhaust" pass) and only up to where that pass ends. With
+ * no gate nothing is merged.</li>
+ * <li>Nothing can see the difference. The allowlist below holds only effects whose result is the same whether or not
+ * the game stops between them: nothing triggers on them, nothing replaces them, they ask nobody anything, and they
+ * cannot cause a state-based action.</li>
+ * </ul>
+ *
+ * <p>The allowlist (v1), each entry with why it is safe:
+ * <ul>
+ * <li><b>GainLife, untargeted, "you", a fixed number</b> (Soul Warden, Soul's Attendant, Essence Warden's own player,
+ * Bloodfell Caves): gaining life never causes a state-based action (704.5a is life 0 or less), the amount is a number
+ * and does not read the board, and each item still calls Player.gainLife with its own source, so life gained this
+ * turn and the times gained count each one. Not merged when anything could watch: a LifeGained or AbilityResolves
+ * trigger that is active or delayed (Ajani's Pridemate, a "whenever you gain life" emblem: in the usual order each
+ * one's trigger goes on the stack above the rest of the run), a GainLife replacement anywhere (Boon Reflection, Rhox
+ * Faithmender: a replacement may ask which applies first), an optional trigger (it asks), a trigger with an
+ * intervening "if" or a resolving check (it reads the board between items), conditions, unless costs, remembering,
+ * a sub-ability or a controller change.</li>
+ * </ul>
+ * Left out on purpose: token creation (a batch of tokens is one "one or more" event, and copies of a token differ by
+ * source, so merging changes what triggers), life loss (players can leave the game between items), damage (each has
+ * its own source and lifelink/infect watchers), counters (Hardened Scales-style replacements per event), drawing
+ * (Alms Collector-style "two or more" replacements, and an empty library is a state-based action).
+ */
+public final class StackMerge {
+    private StackMerge() {}
+
+    /** How many more items may resolve without a priority round after the one that just resolved (0: none). */
+    public interface Gate {
+        int allowed(Game game);
+    }
+
+    /** With the top item, 20 per merge: the same size as the harness's held pass. */
+    public static final int MAX_FOLLOWING = 19;
+
+    private static final Set<TriggerType> WATCHERS = EnumSet.of(TriggerType.LifeGained, TriggerType.AbilityResolves);
+    private static final Set<String> TRIGGER_CHECKS = Set.of("IsPresent", "IsPresent2", "CheckSVar", "CheckSecondSVar",
+            "ResolvingCheck", "OptionalDecider");
+    private static final String[] PARAM_PREFIXES = {"Condition", "Unless", "Remember", "Imprint", "Optional"};
+
+    /** Whether this stack item is on the allowlist. */
+    public static boolean eligible(final SpellAbility sa) {
+        if (!(sa instanceof WrappedAbility wrapped) || wrapped.getDecider() != null || sa.getApi() != ApiType.GainLife) {
+            return false;
+        }
+        if (sa.getSubAbility() != null || sa.usesTargeting() || sa.isOptionalTrigger() || sa.getControlledByPlayer() != null) {
+            return false;
+        }
+        final Trigger trigger = wrapped.getTrigger();
+        if (trigger == null) {
+            return false;
+        }
+        for (final String key : TRIGGER_CHECKS) {
+            if (trigger.hasParam(key)) {
+                return false;
+            }
+        }
+        final Map<String, String> params = wrapped.getWrappedAbility().getMapParams();
+        for (final String key : params.keySet()) {
+            for (final String prefix : PARAM_PREFIXES) {
+                if (key.startsWith(prefix)) {
+                    return false;
+                }
+            }
+        }
+        final String defined = params.get("Defined");
+        return StringUtils.isNumeric(params.get("LifeAmount")) && (defined == null || "You".equals(defined));
+    }
+
+    /** Whether next is the same effect as first: both on the allowlist, the same player, the same amount. */
+    public static boolean alike(final SpellAbility first, final SpellAbility next) {
+        return eligible(next) && next.getApi() == first.getApi()
+                && next.getActivatingPlayer() == first.getActivatingPlayer()
+                && StringUtils.equals(next.getParam("LifeAmount"), first.getParam("LifeAmount"))
+                && StringUtils.equals(next.getParam("Defined"), first.getParam("Defined"));
+    }
+
+    /** Whether anything in the game could see life being gained one item at a time. */
+    public static boolean watched(final Game game) {
+        if (game.getTriggerHandler().watches(WATCHERS)) {
+            return true;
+        }
+        for (final Card c : game.getCardsInGame()) {
+            for (final ReplacementEffect re : c.getReplacementEffects()) {
+                if (re.getMode() == ReplacementType.GainLife) {
+                    return true;
+                }
+            }
+        }
+        return false;
+    }
+}
