+            }
+            poisoned.add(members.size() > 1 ? pc.chooseSingleEntityForEffect(members, sa,
+                    Localizer.getInstance().getMessage("lblChoosePlayer"), null) : chosen);
+        }
+        return poisoned;
+    }
