+    /** The real block declaration (AiController.declareBlockersFor): the assignment, then past the budget the chump
+     * blocks below. A prediction of a combat (ComputerUtil.predictNextCombatsRemainingLife and the like) is only the
+     * assignment: past the budget its answer is "in danger" anyway, and the chump pass is the attackers times the
+     * blockers. */
+    public void declareBlockers(final Combat combat) {
+        assignBlockersForCombat(combat, null);
+        if (AiController.evalDeadlinePassed(ai)) {
+            makeChumpBlocksPastDeadline(combat, ai.getCreaturesInPlay());
+        }
+    }
+
+    // Past the declaration's budget the steps above stop where they are, and on a big board that can be before the
+    // first block: an AI at 6 life facing 30 attackers blocked nothing. When what is still unblocked would kill, chump
+    // with the least valuable blockers left, the biggest attackers first, until it wouldn't. Its cost is the attackers
+    // times the blockers, with no combat prediction.
+    private void makeChumpBlocksPastDeadline(final Combat combat, final List<Card> possibleBlockers) {
+        final List<Card> unblocked = new ArrayList<>();
+        int damage = 0;
+        for (final Card attacker : combat.getAttackersOf(ai)) {
+            if (combat.getBlockers(attacker).isEmpty()) {
+                unblocked.add(attacker);
+                damage += ComputerUtilCombat.damageIfUnblocked(attacker, ai, combat, false);
+            }
+        }
+        if (ai.cantLoseForZeroOrLessLife()) {
+            return;
+        }
+        unblocked.sort((a, b) -> Integer.compare(ComputerUtilCombat.damageIfUnblocked(b, ai, combat, false), ComputerUtilCombat.damageIfUnblocked(a, ai, combat, false)));
+        final List<Card> free = new ArrayList<>();
+        for (final Card b : possibleBlockers) {
+            if (!combat.isBlocking(b) && CombatUtil.canBlock(b, combat)) {
+                free.add(b);
+            }
+        }
+        free.sort((a, b) -> Integer.compare(ComputerUtilCard.evaluateCreature(a), ComputerUtilCard.evaluateCreature(b)));
+        for (final Card attacker : unblocked) {
+            if (damage < ai.getLife()) {
+                break;
+            }
+            for (final Card blocker : free) {
+                if (CombatUtil.canBlock(attacker, blocker, combat)) {
+                    combat.addBlocker(attacker, blocker);
+                    free.remove(blocker);
+                    final int dealt = ComputerUtilCombat.damageIfUnblocked(attacker, ai, combat, false);
+                    damage -= attacker.hasKeyword(Keyword.TRAMPLE) ? Math.min(dealt, Math.max(0, blocker.getNetToughness())) : dealt;
+                    break;
+                }
+            }
+        }
