+            if (id.equals(e.getAsJsonObject().get("id").getAsString())) {
+                return e.getAsJsonObject();
+            }
+        }
+        throw new AssertionError("no attack target " + id + " in " + input.getAsJsonArray("attackTargets"));
+    }
+
+    private static Card creature(final String name, final Player p) {
+        final Card c = add(name, p, ZoneType.Battlefield);
+        c.setSickness(false);
+        return c;
+    }
+
+    private static Card add(final String name, final Player p, final ZoneType zone) {
+        IPaperCard paper = FModel.getMagicDb().getCommonCards().getCard(name);
