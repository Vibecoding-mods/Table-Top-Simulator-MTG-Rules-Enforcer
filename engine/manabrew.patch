+    @SuppressWarnings("unchecked")
+    private static List<Card> triggeredHosts(final Fixture f) throws Exception {
+        final List<Card> hosts = new ArrayList<>();
+        final Field waiting = MagicStack.class.getDeclaredField("simultaneousStackEntryList");
+        waiting.setAccessible(true);
+        for (final SpellAbility sa : (List<SpellAbility>) waiting.get(f.game.getStack())) {
+            hosts.add(sa.getHostCard());
+        }
+        for (final SpellAbilityStackInstance si : f.game.getStack()) {
+            hosts.add(si.getSourceCard());
+        }
+        return hosts;
+    }
