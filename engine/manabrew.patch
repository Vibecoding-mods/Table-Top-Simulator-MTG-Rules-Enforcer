+        check("anotherGameStillTakesRestorePoints", PlanechaseTest::anotherGameStillTakesRestorePoints);
+        System.out.println(failed == 0 ? "PASS PlanechaseTest" : "FAIL PlanechaseTest: " + failed + " failed");
