+            check.run();
+            System.out.println("ok " + name);
+        } catch (final Throwable failure) {
+            failed++;
+            System.out.println("FAIL " + name + ": " + failure);
+        }
+    }
+
+    private static void aLandsOnlyDeckIsPassive() {
+        final Deck deck = deckOf("Plains", "Island", "Mountain");
+        deck.getOrCreate(DeckSection.Commander).add(paper("Pramikon, Sky Rampart"), 1);
+        expect(PassiveLobbyPlayerAi.isLandsOnly(deck), "a deck of lands with a commander is not passive");
+    }
+
+    private static void aDeckWithASpellIsNotPassive() {
+        expect(!PassiveLobbyPlayerAi.isLandsOnly(deckOf("Plains", "Island", "Counterspell")), "a deck with a spell is passive");
+    }
+
+    private static void anEmptyDeckIsNotPassive() {
+        expect(!PassiveLobbyPlayerAi.isLandsOnly(new Deck()), "an empty deck is passive");
+    }
+
+    private static void theAiCastsWhatThePassiveAiHolds() {
+        for (int attempt = 0; attempt < 10; attempt++) {
+            final Fixture f = new Fixture(new LobbyPlayerAi("p1", null));
