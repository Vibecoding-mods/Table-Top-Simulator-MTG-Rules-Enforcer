+        check("aTimeoutOnANewTurnStartsTheCountOver", BigTurnsTest::aTimeoutOnANewTurnStartsTheCountOver);
+        check("aLateAnswerToATimedOutQuestionIsDropped", BigTurnsTest::aLateAnswerToATimedOutQuestionIsDropped);
+        check("theSnapshotSaysWhyTheGameIsADraw", BigTurnsTest::theSnapshotSaysWhyTheGameIsADraw);
+        check("aStuckLoopAsksAfterSixtySeconds", BigTurnsTest::aStuckLoopAsksAfterSixtySeconds);
+        check("aTriggerOrACardIsProgress", BigTurnsTest::aTriggerOrACardIsProgress);
+        check("anAbilityResolvingChecksTheWatchdog", BigTurnsTest::anAbilityResolvingChecksTheWatchdog);
+        check("aResolutionStartingIsProgress", BigTurnsTest::aResolutionStartingIsProgress);
+        check("aReplacementRunChecksTheWatchdog", BigTurnsTest::aReplacementRunChecksTheWatchdog);
+        check("aStuckLoopNobodyAnswersIsADraw", BigTurnsTest::aStuckLoopNobodyAnswersIsADraw);
+        check("aStuckLoopWithNoPersonIsADraw", BigTurnsTest::aStuckLoopWithNoPersonIsADraw);
+        check("anAnsweredActionIsProgress", BigTurnsTest::anAnsweredActionIsProgress);
+        check("theSessionAsksTheActivePlayerInPlainWords", BigTurnsTest::theSessionAsksTheActivePlayerInPlainWords);
+        check("theSessionsNoIsADraw", BigTurnsTest::theSessionsNoIsADraw);
+        check("aGameWithNoPersonDrawsAtTheCap", BigTurnsTest::aGameWithNoPersonDrawsAtTheCap);
+        check("aMergeResolvesTwentyAndCountsEveryGain", BigTurnsTest::aMergeResolvesTwentyAndCountsEveryGain);
