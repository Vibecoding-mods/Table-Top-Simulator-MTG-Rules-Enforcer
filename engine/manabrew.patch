+            throw new AssertionError("White's extra turns played stayed " + f.white.getExtraTurnsPlayed());
+        }
+    }
+
+    private static void rewindIntoAnExtraTurnKeepsItsState() throws Exception {
+        final Fixture f = new Fixture();
+        f.white.setExtraTurn(true);
+        f.white.incrementExtraTurnsPlayed();
+        f.handler.addExtraTurn(f.white);
+        f.handler.addExtraTurn(f.white);
+        f.recordCheckpoint();
+        f.white.setExtraTurn(false);
+        f.white.incrementExtraTurnsPlayed();
+        f.handler.addExtraTurn(f.blue);
+        f.restoreFirstCheckpoint();
+        if (!f.white.isExtraTurn()) {
+            throw new AssertionError("White's extra turn in progress at the checkpoint is no longer marked");
+        }
+        if (f.white.getExtraTurnsPlayed() != 1) {
+            throw new AssertionError("White's extra turns played is " + f.white.getExtraTurnsPlayed() + ", not 1");
+        }
+        if (f.white.getExtraTurnCount() != 2) {
+            throw new AssertionError("White's Forge count is " + f.white.getExtraTurnCount() + ", not 2");
+        }
+        expect(f.counts(), "2 0", "after the rewind");
+    }
+
+    private static void expect(final String actual, final String wanted, final String what) {
+        if (!wanted.equals(actual)) {
+            throw new AssertionError(what + ": extraTurnCount White Blue = " + actual + ", wanted " + wanted);
+        }
+    }
+
+    private static final class Fixture {
+        final ManaBrewInteractiveSession session = new ManaBrewInteractiveSession("extra-turn-rewind-test");
+        final Game game = newGame();
+        final PhaseHandler handler = game.getPhaseHandler();
+        final Player white = game.getPlayers().get(0);
+        final Player blue = game.getPlayers().get(1);
+
+        Fixture() {
+            session.attach(game.getMatch(), game, Set.of(), true);
+        }
+
+        String counts() {
+            final JsonObject view = JsonParser.parseString(session.getSnapshotJson(0)).getAsJsonObject();
+            final List<String> counts = new ArrayList<>();
+            for (final JsonElement player : view.getAsJsonArray("players")) {
+                counts.add(player.getAsJsonObject().get("extraTurnCount").getAsString());
+            }
+            return String.join(" ", counts);
+        }
+
+        void recordCheckpoint() throws Exception {
+            final Method record = ManaBrewInteractiveSession.class.getDeclaredMethod("recordCheckpoint");
+            record.setAccessible(true);
+            record.invoke(session);
+            if (checkpoints().isEmpty()) {
+                throw new AssertionError("no checkpoint was recorded");
+            }
+        }
+
+        void restoreFirstCheckpoint() throws Exception {
+            final Object first = checkpoints().peekFirst();
+            for (final Method method : ManaBrewInteractiveSession.class.getDeclaredMethods()) {
+                if (method.getName().equals("restore") && method.getParameterCount() == 1) {
+                    method.setAccessible(true);
+                    method.invoke(session, first);
+                    return;
+                }
+            }
+            throw new AssertionError("no restore method");
+        }
+
+        private Deque<?> checkpoints() throws Exception {
+            final Field field = ManaBrewInteractiveSession.class.getDeclaredField("checkpoints");
+            field.setAccessible(true);
+            return (Deque<?>) field.get(session);
+        }
+
+        private Game newGame() {
+            final List<RegisteredPlayer> players = new ArrayList<>();
+            final Deck deck = new Deck();
+            players.add(new RegisteredPlayer(deck).setPlayer(new ManaBrewInteractiveLobbyPlayer("White", session)));
+            players.add(new RegisteredPlayer(deck).setPlayer(new LobbyPlayerAi("Blue", null)));
+            final GameRules rules = new GameRules(GameType.Constructed);
+            final Game created = new Game(players, rules, new Match(rules, players, "ExtraTurnRewindTest"));
+            created.setAge(GameStage.Play);
+            created.getPhaseHandler().devModeSet(PhaseType.MAIN1, created.getPlayers().get(0));
+            created.getPhaseHandler().onStackResolved();
+            return created;
+        }
+    }
+}
