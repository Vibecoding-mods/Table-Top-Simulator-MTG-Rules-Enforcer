+    private static void putPrintedCounters(final Card card) {
+        if (card.isPlaneswalker() && card.getCurrentLoyalty() == 0) {
+            card.setCounters(CounterType.getType("LOYALTY"),
+                    AbilityUtils.calculateAmount(card, card.getCurrentState().getBaseLoyalty(), null));
+        }
+        if (card.isBattle() && card.getCurrentDefense() == 0) {
+            card.setCounters(CounterType.getType("DEFENSE"),
+                    AbilityUtils.calculateAmount(card, card.getCurrentState().getBaseDefense(), null));
+        }
+    }
