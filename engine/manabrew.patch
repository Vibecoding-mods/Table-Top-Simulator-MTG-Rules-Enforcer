+    private static final class Joint {
+        final Fixture f;
+        final Card a;
+        final Card b;
+        final Card x;
+        final Card y;
+
+        Joint(final boolean sharedTurns) {
+            f = new Fixture(sharedTurns);
+            a = creature("Grizzly Bears", f.white);
+            b = creature("Hill Giant", sharedTurns ? f.red : f.white);
+            x = creature("Wall of Wood", f.yellow);
+            y = creature("Centaur Courser", f.blue);
+            final Combat combat = combatOf(f, f.white);
+            combat.addAttacker(a, f.yellow);
+            combat.addAttacker(b, f.yellow);
+        }
+
+        Map<Card, Card> block(final Card blocker, final Card attacker) {
+            return Map.of(blocker, attacker);
+        }
+    }
+
+    private static Blocks script(final Fixture f, final Map<Player, List<Map<Card, Card>>> answers) {
+        final Blocks out = new Blocks();
+        for (final Player p : f.game.getPlayers()) {
+            final List<Map<Card, Card>> mine = answers.getOrDefault(p, List.of(Map.of()));
+            p.dangerouslySetController(new PlayerControllerAi(f.game, p, p.getLobbyPlayer()) {
+                private int asks;
+
+                @Override
+                public void declareBlockers(final Player defender, final Combat combat) {
+                    out.asked.add(defender);
+                    for (final Card own : new ArrayList<>(combat.getAllBlockers())) {
+                        if (own.getController() == defender) {
+                            combat.undoBlockingAssignment(own);
+                        }
+                    }
+                    for (final Map.Entry<Card, Card> e : mine.get(asks++ % mine.size()).entrySet()) {
+                        combat.addBlocker(e.getValue(), e.getKey());
+                    }
+                }
+
+                @Override
+                public void notifyOfValue(final SpellAbility sa, final GameObject target, final String value) {
+                    out.told.add(p.getName() + ": " + value);
+                }
+            });
+        }
+        return out;
+    }
