+        for (final Card card : f.white.getCardsIn(ZoneType.Hand)) {
+            if (!card.getDrawnThisTurn()) {
+                throw new AssertionError(card.getName() + " is not marked drawn");
+            }
+        }
+        expect("the card left", "Grizzly Bears", f.white.getCardsIn(ZoneType.Library).get(0).getName());
+    }
+
+    private static void drawFiresDrawTriggers() throws Exception {
+        final Fixture f = new Fixture();
+        f.library("player-0", "Grizzly Bears");
+        f.apply("{\"op\":\"createCard\",\"name\":\"Chasm Skulker\",\"player\":\"player-0\",\"zone\":\"battlefield\"},"
+                + "{\"op\":\"draw\",\"player\":\"player-0\",\"n\":1}");
+        f.expectApplied();
+        expect("triggers on the stack", 1, f.game.getStack().size());
+    }
+
+    private static void millPutsTheTopCardsIntoTheGraveyardAsMilled() throws Exception {
+        final Fixture f = new Fixture();
+        f.library("player-0", "Grizzly Bears", "Shock", "Opt", "Island");
+        f.apply("{\"op\":\"mill\",\"player\":\"player-0\",\"n\":3}");
