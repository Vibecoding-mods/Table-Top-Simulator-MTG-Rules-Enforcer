+import java.util.concurrent.locks.ReentrantLock;
+
+public final class AttackDefenderChoiceTest {
+    private AttackDefenderChoiceTest() {}
+
+    public static void main(final String[] args) throws Exception {
+        GuiBase.setInterface(new HeadlessGuiBase("forge/forge-gui/"));
+        FModel.initialize(null, prefs -> {
+            prefs.setPref(FPref.LOAD_CARD_SCRIPTS_LAZILY, true);
+            prefs.setPref(FPref.UI_LANGUAGE, "en-US");
+            return null;
+        });
+
+        check("eachTokenNamesItsOwnAttacker", AttackDefenderChoiceTest::eachTokenNamesItsOwnAttacker);
+        check("aChoiceWithNoAttackerNamesNoCard", AttackDefenderChoiceTest::aChoiceWithNoAttackerNamesNoCard);
+        System.out.println(failed == 0 ? "PASS AttackDefenderChoiceTest" : "FAIL AttackDefenderChoiceTest: " + failed + " failed");
+        System.exit(failed == 0 ? 0 : 1);
+    }
+
+    private interface Check {
+        void run() throws Exception;
+    }
+
+    private static int failed;
+
+    private static void check(final String name, final Check check) {
+        try {
+            check.run();
+            System.out.println("ok " + name);
+        } catch (final Throwable thrown) {
+            failed++;
+            System.out.println("FAIL " + name + ": " + thrown);
+        }
+    }
+
+    private static void eachTokenNamesItsOwnAttacker() throws Exception {
+        final Fixture f = new Fixture();
+        final Card hero = add("Hero of Bladehold", f.white, ZoneType.Battlefield);
+        final Card jace = add("Jace Beleren", f.ai, ZoneType.Battlefield);
+        jace.setCounters(CounterType.getType("LOYALTY"), 3);
+        f.game.getPhaseHandler().devModeSet(PhaseType.COMBAT_DECLARE_ATTACKERS, f.white);
+        final Combat combat = new Combat(f.white);
+        combat.addAttacker(hero, f.ai);
+        f.game.getPhaseHandler().setCombat(combat);
+        final SpellAbility tokens = AbilityFactory.getAbility(hero.getSVar("TrigToken"), hero);
+        tokens.setActivatingPlayer(f.white);
+
+        final Throwable[] failure = new Throwable[1];
+        final Thread resolver = new Thread(() -> {
+            f.lock.lock();
+            try {
+                AbilityUtils.resolve(tokens);
+            } catch (final Throwable thrown) {
+                failure[0] = thrown;
+            } finally {
+                f.lock.unlock();
+            }
+        }, "resolve-hero-tokens");
+        resolver.setDaemon(true);
+        resolver.start();
+
+        final List<String> attackerIds = new ArrayList<>();
+        final List<GameEntity> answered = new ArrayList<>();
+        long seen = -1;
+        final long deadline = System.currentTimeMillis() + 60_000;
+        while (resolver.isAlive() && System.currentTimeMillis() < deadline) {
+            final String json = f.session.getLatestPromptJson();
+            final JsonObject prompt = json == null ? null : JsonParser.parseString(json).getAsJsonObject();
+            if (prompt == null || prompt.get("promptId").getAsLong() == seen) {
+                Thread.sleep(20);
+                continue;
+            }
+            seen = prompt.get("promptId").getAsLong();
+            final JsonObject input = prompt.getAsJsonObject("input");
+            if (!"chooseFromSelection".equals(input.get("type").getAsString())) {
+                throw new AssertionError("expected the defender choice, got " + input);
+            }
+            final JsonObject presentation = input.getAsJsonObject("presentation");
+            final String description = presentation.has("description") ? presentation.get("description").getAsString() : null;
+            if (!"Choose which defender to attack with Soldier Token".equals(description)) {
+                throw new AssertionError("Forge's question is not sent: " + presentation);
+            }
+            final JsonArray targets = presentation.getAsJsonArray("targets");
+            if (targets == null || targets.size() != 1 || !"card".equals(targets.get(0).getAsJsonObject().get("kind").getAsString())) {
+                throw new AssertionError("the attacking token is not named: " + presentation);
+            }
+            attackerIds.add(targets.get(0).getAsJsonObject().get("id").getAsString());
+            final List<String> labels = new ArrayList<>();
+            for (final JsonElement option : input.getAsJsonArray("options")) {
+                labels.add(option.getAsJsonObject().get("label").getAsString());
+            }
+            final GameEntity pick = attackerIds.size() == 1 ? jace : f.ai;
+            final int index = labels.indexOf(pick.toString());
+            if (index < 0) {
+                throw new AssertionError(pick + " is not offered: " + labels);
+            }
+            answered.add(pick);
+            f.session.submitAction("{\"type\":\"chooseFromSelection\",\"output\":{\"type\":\"selectionDecision\",\"chosenIndices\":[" + index + "]}}");
+        }
+        resolver.join(5_000);
+        if (failure[0] != null) {
+            throw new AssertionError("resolving Hero of Bladehold's tokens failed", failure[0]);
+        }
+        if (attackerIds.size() != 2) {
+            throw new AssertionError("expected one defender question a token, got " + attackerIds.size());
+        }
+        if (attackerIds.get(0).equals(attackerIds.get(1))) {
+            throw new AssertionError("both questions name the same token: " + attackerIds);
+        }
+        for (int i = 0; i < 2; i++) {
+            final Card token = cardById(f.white, attackerIds.get(i));
+            if (token == null || !token.isToken() || !"Soldier Token".equals(token.getName())) {
+                throw new AssertionError("question " + (i + 1) + " names " + attackerIds.get(i) + ", not a Soldier token on the battlefield");
+            }
+            if (!combat.getAttackersOf(answered.get(i)).contains(token)) {
+                throw new AssertionError("the token named in question " + (i + 1) + " does not attack " + answered.get(i)
+                        + ": it attacks " + combat.getDefenderByAttacker(token));
+            }
+        }
+    }
+
+    private static void aChoiceWithNoAttackerNamesNoCard() throws Exception {
+        final Fixture f = new Fixture();
+        final Card jace = add("Jace Beleren", f.ai, ZoneType.Battlefield);
+        final FCollection<GameEntity> options = new FCollection<>();
+        options.add(f.ai);
+        options.add(jace);
+        f.session.submitAction("{\"type\":\"chooseFromSelection\",\"output\":{\"type\":\"selectionDecision\",\"chosenIndices\":[1]}}");
+        f.lock.lock();
+        final GameEntity chosen;
+        try {
+            chosen = f.white.getController().chooseSingleEntityForEffect(options, null, "Choose a player or planeswalker", false, Map.of());
+        } finally {
+            f.lock.unlock();
+        }
+        final JsonObject presentation = JsonParser.parseString(f.session.getLatestPromptJson()).getAsJsonObject()
+                .getAsJsonObject("input").getAsJsonObject("presentation");
+        if (presentation.has("targets") && presentation.getAsJsonArray("targets").size() > 0) {
+            throw new AssertionError("a choice with no attacker names a card: " + presentation);
+        }
+        if (chosen != jace) {
