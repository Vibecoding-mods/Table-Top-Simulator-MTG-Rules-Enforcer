+import forge.model.FModel;
+
+import java.io.IOException;
+import java.lang.reflect.Field;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.Paths;
+import java.util.ArrayList;
+import java.util.EnumSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.TreeMap;
+import java.util.TreeSet;
+import java.util.concurrent.locks.ReentrantLock;
+import java.util.stream.Stream;
+
+public final class ArchenemySchemeSweepTest {
+    private ArchenemySchemeSweepTest() {}
+
+    private static final Path CARDS = Paths.get("forge/forge-gui/res/cardsfolder");
+    private static final List<String> FILLER = List.of("Roots of All Evil", "Look Skyward and Despair");
+    private static final long TIMEOUT_MS = 60_000;
+    private static final int MAX_ANSWERS = 200;
+
+    public static void main(final String[] args) throws Exception {
+        GuiBase.setInterface(new HeadlessGuiBase("forge/forge-gui/"));
+        FModel.initialize(null, prefs -> {
+            prefs.setPref(FPref.LOAD_CARD_SCRIPTS_LAZILY, true);
+            prefs.setPref(FPref.UI_LANGUAGE, "en-US");
+            return null;
+        });
+        final Set<String> only = Set.of(args);
+        final Map<String, Boolean> selfTriggers = schemeScripts();
+        final List<String> schemes = new ArrayList<>(selfTriggers.keySet());
+        final Map<String, String> failures = new TreeMap<>();
+        final Map<String, Set<String>> promptsSeen = new TreeMap<>();
+        int ran = 0;
+        for (final String scheme : schemes) {
+            if (!only.isEmpty() && !only.contains(scheme)) {
+                continue;
+            }
+            ran++;
+            final Set<String> prompts = new TreeSet<>();
+            try {
+                sweep(scheme, selfTriggers.get(scheme), prompts);
+                System.out.println("ok " + scheme + (prompts.isEmpty() ? "" : " prompts " + prompts));
+            } catch (final Throwable failure) {
+                failures.put(scheme, String.valueOf(failure));
+                System.out.println("FAIL " + scheme + ": " + failure);
+            }
+            promptsSeen.put(scheme, prompts);
+        }
+        final Set<String> allPrompts = new TreeSet<>();
+        promptsSeen.values().forEach(allPrompts::addAll);
+        System.out.println("swept " + ran + " of " + schemes.size() + " schemes; prompt types answered " + allPrompts);
+        for (final Map.Entry<String, String> failure : failures.entrySet()) {
+            System.out.println("failed: " + failure.getKey() + ": " + failure.getValue());
+        }
+        System.out.println(failures.isEmpty() ? "PASS ArchenemySchemeSweepTest" : "FAIL ArchenemySchemeSweepTest: " + failures.size() + " failed");
+        System.exit(failures.isEmpty() && ran > 0 ? 0 : 1);
+    }
+
+    static Map<String, Boolean> schemeScripts() throws IOException {
+        final Map<String, Boolean> names = new TreeMap<>();
+        try (Stream<Path> files = Files.walk(CARDS)) {
+            for (final Path file : (Iterable<Path>) files.filter(p -> p.toString().endsWith(".txt"))::iterator) {
+                String name = null;
+                boolean scheme = false;
+                boolean selfTrigger = false;
+                for (final String line : Files.readAllLines(file, StandardCharsets.UTF_8)) {
+                    if (line.startsWith("Name:") && name == null) {
+                        name = line.substring(5).trim();
+                    } else if (line.startsWith("Types:")) {
+                        final String types = line.substring(6).trim();
+                        scheme = types.equals("Scheme") || types.equals("Ongoing Scheme");
+                    } else if (line.startsWith("T:Mode$ SetInMotion") && line.contains("ValidCard$ Card.Self")) {
+                        selfTrigger = true;
+                    }
+                }
+                if (scheme && name != null) {
+                    names.put(name, selfTrigger);
+                }
+            }
+        }
+        if (names.size() < 50) {
+            throw new AssertionError("found only " + names.size() + " scheme scripts under " + CARDS);
+        }
+        return names;
+    }
+
+    private static void sweep(final String name, final boolean selfTrigger, final Set<String> prompts) throws Exception {
+        final Fixture f = new Fixture();
+        final Card scheme = add(name, f.white, ZoneType.SchemeDeck);
+        final List<Card> filler = new ArrayList<>();
+        for (final String other : FILLER) {
+            if (!other.equals(name)) {
+                filler.add(add(other, f.white, ZoneType.SchemeDeck));
+            }
+        }
+        final boolean ongoing = scheme.getType().toString().contains("Ongoing");
+        expect(scheme.isScheme(), name + " is not a scheme card");
+        expect(f.white.getCardsIn(ZoneType.SchemeDeck).get(0) == scheme, "the swept scheme is not on top of the scheme deck");
+        f.run(prompts, () -> {
+            f.white.setSchemeInMotion(null);
+            f.settle();
+        });
+        expect(!selfTrigger || f.resolved.contains(name), "its \"when you set this scheme in motion\" ability never resolved; resolved " + f.resolved);
+        if (ongoing) {
+            final Card inCommand = f.inCommand(name);
+            expect(inCommand != null, "the ongoing scheme left the command zone before it was abandoned: scheme deck "
+                    + names(f.white.getCardsIn(ZoneType.SchemeDeck)));
+            f.run(prompts, () -> {
+                final SpellAbility abandon = AbilityFactory.getAbility("DB$ Abandon", inCommand);
+                abandon.setActivatingPlayer(f.white);
+                AbilityUtils.resolve(abandon);
+                f.settle();
