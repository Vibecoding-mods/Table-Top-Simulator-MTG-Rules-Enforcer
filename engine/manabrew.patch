+import java.util.List;
+import java.util.Set;
+
+public final class BigTurnTimingTest {
+    private BigTurnTimingTest() {}
+
+    public static void main(final String[] args) throws Exception {
+        GuiBase.setInterface(new HeadlessGuiBase("forge/forge-gui/"));
+        FModel.initialize(null, prefs -> {
+            prefs.setPref(FPref.LOAD_CARD_SCRIPTS_LAZILY, true);
+            prefs.setPref(FPref.UI_LANGUAGE, "en-US");
+            return null;
+        });
+        final int[] sizes = args.length > 0 ? parse(args[0]) : new int[] {25, 50, 100, 200, 400};
+        warmUp();
+        for (final int n : sizes) {
+            landfall(n);
+        }
+        for (final int n : sizes) {
+            secondHarvest(n);
+        }
+        System.out.println("PASS BigTurnTimingTest");
+        System.exit(0);
+    }
+
+    private static int[] parse(final String list) {
+        final String[] parts = list.split(",");
+        final int[] out = new int[parts.length];
+        for (int i = 0; i < parts.length; i++) {
+            out[i] = Integer.parseInt(parts[i].trim());
+        }
+        return out;
+    }
+
+    private static void warmUp() {
+        final Board b = new Board(10);
+        b.snapshotMs();
+        b.actionsMs();
+    }
+
+    private static void landfall(final int n) throws Exception {
+        final Board b = new Board(n);
+        final double actions = b.actionsMs();
+        final double snap = b.snapshotMs();
+        final int bytes = b.session.getSnapshotJson(0).length();
+        final Card island = add("Island", b.blue, ZoneType.Hand);
+        long t0 = System.nanoTime();
+        b.game.getAction().moveToPlay(island, null, null);
+        b.game.getAction().checkStateEffects(true);
+        b.game.getStack().addAllTriggeredAbilitiesToStack();
+        final double order = ms(t0);
+        final int triggers = b.game.getStack().size();
+        final int resolveCount = Math.min(triggers, 20);
+        t0 = System.nanoTime();
+        for (int i = 0; i < resolveCount; i++) {
+            b.game.getStack().resolveStack();
+            b.game.getAction().checkStateEffects(true);
+            b.game.getStack().addAllTriggeredAbilitiesToStack();
+        }
+        final double perTrigger = ms(t0) / Math.max(1, resolveCount);
+        final double actionsAfter = b.actionsMs();
+        final double snapAfter = b.snapshotMs();
+        System.out.println(String.format(
+                "time landfall n=%d triggers=%d putOnStackMs=%.1f resolveMsPerTrigger=%.1f actionsMs=%.1f->%.1f snapshotMs=%.1f->%.1f snapshotBytes=%d tokensNow=%d triggersFired=%d",
+                n, triggers, order, perTrigger, actions, actionsAfter, snap, snapAfter, bytes,
+                b.blue.getCardsIn(ZoneType.Battlefield).size(), b.triggersFired()));
+    }
+
+    private static void secondHarvest(final int n) throws Exception {
+        final Board b = new Board(n);
+        final Card harvest = add("Second Harvest", b.blue, ZoneType.Hand);
+        final SpellAbility sa = harvest.getFirstSpellAbility();
+        sa.setActivatingPlayer(b.blue);
+        final int before = b.blue.getCardsIn(ZoneType.Battlefield).size();
+        final long t0 = System.nanoTime();
+        AbilityUtils.resolve(sa);
+        b.game.getAction().checkStateEffects(true);
+        final double resolveMs = ms(t0);
+        final long t1 = System.nanoTime();
+        b.game.getStack().addAllTriggeredAbilitiesToStack();
+        final double order = ms(t1);
+        final int after = b.blue.getCardsIn(ZoneType.Battlefield).size();
+        System.out.println(String.format(
+                "time secondHarvest n=%d resolveMs=%.1f perNewTokenMs=%.2f putOnStackMs=%.1f created=%d stack=%d triggersFired=%d cardsCreated=%d snapshotMs=%.1f",
+                n, resolveMs, resolveMs / Math.max(1, after - before), order, after - before,
+                b.game.getStack().size(), b.triggersFired(), b.cardsCreated(), b.snapshotMs()));
+    }
+
+    private static double ms(final long t0) {
+        return (System.nanoTime() - t0) / 1_000_000.0;
+    }
+
+    private static final class Board {
+        final ManaBrewInteractiveSession session = new ManaBrewInteractiveSession("big-turn-timing");
+        final Game game;
+        final Player blue;
+
+        Board(final int scutes) {
+            final List<RegisteredPlayer> players = new ArrayList<>();
+            final Deck deck = new Deck();
+            players.add(new RegisteredPlayer(deck).setPlayer(new LobbyPlayerAi("Blue", null)));
+            players.add(new RegisteredPlayer(deck).setPlayer(new LobbyPlayerAi("Yellow", null)));
+            final GameRules rules = new GameRules(GameType.Constructed);
+            game = new Game(players, rules, new Match(rules, players, "BigTurnTimingTest"));
+            game.setAge(GameStage.Play);
+            game.getPhaseHandler().devModeSet(PhaseType.MAIN1, game.getPlayers().get(0));
+            game.getPhaseHandler().onStackResolved();
+            blue = game.getPlayers().get(0);
+            for (int i = 0; i < 7; i++) {
+                add("Forest", blue, ZoneType.Battlefield);
+            }
+            add("Adrix and Nev, Twincasters", blue, ZoneType.Battlefield);
+            for (int i = 0; i < scutes; i++) {
+                final Card c = add("Scute Swarm", blue, ZoneType.Battlefield);
+                c.setGamePieceType(GamePieceType.TOKEN);
+            }
+            game.getAction().checkStateEffects(true);
+            session.attach(game.getMatch(), game, Set.of(), true);
+        }
+
+        double actionsMs() {
+            final long t0 = System.nanoTime();
+            ActionSpace.getPossibleActions(blue, true, true);
+            return ms(t0);
+        }
+
+        double snapshotMs() {
+            final long t0 = System.nanoTime();
+            for (int v = 0; v < 2; v++) {
+                session.getSnapshotJson(v);
+            }
+            return ms(t0) / 2;
+        }
+
+        int triggersFired() throws Exception {
+            return counter("triggersFiredThisTurn");
+        }
+
+        int cardsCreated() throws Exception {
+            return counter("cardsCreatedThisTurn");
+        }
+
+        private int counter(final String name) throws Exception {
+            final Field f = Game.class.getDeclaredField(name);
+            f.setAccessible(true);
+            return f.getInt(game);
+        }
+    }
+
+    private static Card add(final String name, final Player p, final ZoneType zone) {
+        IPaperCard paper = FModel.getMagicDb().getCommonCards().getCard(name);
+        if (paper == null) {
+            StaticData.instance().attemptToLoadCard(name);
+            paper = FModel.getMagicDb().getCommonCards().getCard(name);
+        }
+        final Card card = Card.fromPaperCard(paper, p);
+        card.setGameTimestamp(p.getGame().getNextTimestamp());
+        p.getZone(zone).add(card);
+        return card;
+    }
+}
