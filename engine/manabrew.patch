+    private boolean playFree(final JsonObject op) {
+        final Player player = statePlayer(op.get("player").getAsString());
+        if (PLANAR_OPS.contains(op.get("op").getAsString())) {
+            return Planechase.applyOp(game, player, op);
+        }
+        final Card card = stateCard(op.get("card").getAsString());
+        final ManaBrewInteractiveController controller = (ManaBrewInteractiveController) player.getController();
+        switch (op.get("op").getAsString()) {
+            case "freeLand": {
+                final SpellAbility land = controller.getAbilityToPlay(card, freeLands(card, player));
+                if (land == null) {
+                    return false;
+                }
+                card.setSplitStateToPlayAbility(land);
+                final Card played = game.getAction().moveToPlay(card, player, null, null);
+                game.getTriggerHandler().runWaitingTriggers();
+                return played != null && played.isInZone(ZoneType.Battlefield);
+            }
+            case "freeCast": {
+                final SpellAbility spell = controller.getAbilityToPlay(card, freeSpells(card, player));
+                return spell != null && controller.playFree(spell);
+            }
+            default: {
+                final List<SpellAbility> abilities = freeAbilities(card);
+                final SpellAbility picked = pickedAbility(op, abilities);
+                final SpellAbility ability = picked != null ? picked : controller.getAbilityToPlay(card, abilities);
+                return ability != null && controller.playFree(ability);
+            }
+        }
+    }
