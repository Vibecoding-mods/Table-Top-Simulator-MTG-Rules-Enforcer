+    private static void eachPlayerDrawsActiveTeamFirst() throws Exception {
+        for (final boolean shared : new boolean[] {true, false}) {
+            final Fixture f = new Fixture(shared);
+            f.game.getPhaseHandler().devModeSet(PhaseType.MAIN1, f.yellow, 2);
+            final Card skeins = add("Vision Skeins", f.white, ZoneType.Hand);
+            resolve(f, skeins.getFirstSpellAbility(), f.white);
+            final List<Player> order = drawOrder(f);
+            expect(order.equals(List.of(f.yellow, f.blue, f.white, f.red)),
+                    (shared ? "" : "level 1: ") + "each player drew in the order " + order + ", not the active team Yellow + Blue first");
+        }
+    }
+
+    private static List<Player> drawOrder(final Fixture f) {
+        final List<Card> drawn = new ArrayList<>();
+        for (final Player p : f.game.getPlayers()) {
+            for (final Card c : p.getCardsIn(ZoneType.Hand)) {
+                if (!"Vision Skeins".equals(c.getName())) {
+                    drawn.add(c);
+                }
+            }
+        }
+        drawn.sort((a, b) -> Long.compare(a.getGameTimestamp(), b.getGameTimestamp()));
+        final List<Player> order = new ArrayList<>();
+        for (final Card c : drawn) {
+            if (!order.contains(c.getOwner())) {
+                order.add(c.getOwner());
+            }
+        }
+        return order;
+    }
