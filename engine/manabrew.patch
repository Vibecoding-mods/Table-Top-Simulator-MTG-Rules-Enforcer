@@ -0,0 +1,139 @@
+package forge.harness.host;
+
+import forge.StaticData;
+import forge.ai.LobbyPlayerAi;
+import forge.deck.Deck;
+import forge.game.Game;
+import forge.game.GameRules;
+import forge.game.GameStage;
+import forge.game.GameType;
+import forge.game.Match;
+import forge.game.ability.AbilityFactory;
+import forge.game.ability.AbilityUtils;
+import forge.game.card.Card;
+import forge.game.phase.PhaseType;
+import forge.game.player.Player;
+import forge.game.player.RegisteredPlayer;
+import forge.game.spellability.SpellAbility;
+import forge.game.zone.ZoneType;
+import forge.gui.GuiBase;
+import forge.harness.common.ActionSpace;
+import forge.harness.common.HeadlessGuiBase;
+import forge.item.IPaperCard;
+import forge.localinstance.properties.ForgePreferences.FPref;
+import forge.model.FModel;
+
+import java.lang.reflect.Field;
+import java.lang.reflect.Method;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.List;
+import java.util.Locale;
+import java.util.Set;
+import java.util.concurrent.locks.ReentrantLock;
+
+public final class HeldPassBench {
+    private HeldPassBench() {}
+
+    public static void main(final String[] args) throws Exception {
+        GuiBase.setInterface(new HeadlessGuiBase("forge/forge-gui/"));
+        FModel.initialize(null, prefs -> {
+            prefs.setPref(FPref.LOAD_CARD_SCRIPTS_LAZILY, true);
+            prefs.setPref(FPref.UI_LANGUAGE, "en-US");
+            return null;
+        });
+        bench(0, 0, "w_1_1_soldier");
+        bench(500, 0, "w_1_1_soldier");
+        bench(500, 500, "w_1_1_soldier");
+        bench(500, 0, "c_a_clue_draw");
+        bench(500, 500, "c_a_treasure_sac");
+    }
+
+    private static void bench(final int mine, final int theirs, final String script) throws Exception {
+        final ManaBrewInteractiveSession session = new ManaBrewInteractiveSession("held-pass-bench");
+        final List<RegisteredPlayer> players = new ArrayList<>();
+        final Deck deck = new Deck();
+        players.add(new RegisteredPlayer(deck).setPlayer(new ManaBrewInteractiveLobbyPlayer("Blue", session)));
+        players.add(new RegisteredPlayer(deck).setPlayer(new LobbyPlayerAi("Yellow", null)));
+        final GameRules rules = new GameRules(GameType.Constructed);
+        final Game game = new Game(players, rules, new Match(rules, players, "HeldPassBench"));
+        game.setAge(GameStage.Play);
+        final Player blue = game.getPlayers().get(0);
+        game.getPhaseHandler().devModeSet(PhaseType.MAIN1, blue);
+        game.getPhaseHandler().onStackResolved();
+        session.attach(game.getMatch(), game, Set.of(), false);
+        final Field lock = ManaBrewInteractiveSession.class.getDeclaredField("gameLock");
+        lock.setAccessible(true);
+        ((ReentrantLock) lock.get(session)).lock();
+        add("Mountain", blue, ZoneType.Battlefield);
+        add("Lightning Bolt", blue, ZoneType.Hand);
+        if (mine > 0) {
+            make(blue, mine, script);
+        }
+        if (theirs > 0) {
+            make(game.getPlayers().get(1), theirs, script);
+        }
+        for (int i = 0; i < 5; i++) {
+            add("Soul Warden", blue, ZoneType.Battlefield);
+        }
+        game.getAction().checkStateEffects(true);
+        game.getAction().moveToPlay(add("Grizzly Bears", blue, ZoneType.Hand), null, null);
+        game.getAction().checkStateEffects(true);
+        game.getStack().addAllTriggeredAbilitiesToStack();
+        final ManaBrewInteractiveController c = (ManaBrewInteractiveController) blue.getController();
+        hold(c, game, blue);
+        for (int i = 0; i < 5; i++) {
+            c.heldResolutionsLeft();
+        }
+        final Field stamp = ManaBrewInteractiveController.class.getDeclaredField("heldCheckStamp");
+        stamp.setAccessible(true);
+        final int runs = 30;
+        final long[] fresh = new long[runs];
+        final long[] again = new long[runs];
+        for (int i = 0; i < runs; i++) {
+            stamp.set(c, null);
+            long t0 = System.nanoTime();
+            c.heldResolutionsLeft();
+            fresh[i] = System.nanoTime() - t0;
+            t0 = System.nanoTime();
+            c.heldResolutionsLeft();
+            again[i] = System.nanoTime() - t0;
+        }
+        Arrays.sort(fresh);
+        Arrays.sort(again);
+        System.out.println(String.format(Locale.ROOT, "time held check: %d %s mine, %d theirs, %d on the battlefield: new state median %.2f ms, max %.2f ms; same state median %.2f ms, max %.2f ms",
+                mine, script, theirs, game.getCardsIn(ZoneType.Battlefield).size(), fresh[runs / 2] / 1e6, fresh[runs - 1] / 1e6, again[runs / 2] / 1e6, again[runs - 1] / 1e6));
+    }
+
+    private static void hold(final ManaBrewInteractiveController c, final Game game, final Player blue) throws Exception {
+        final Field stack = ManaBrewInteractiveController.class.getDeclaredField("exhaustStackIds");
+        stack.setAccessible(true);
+        stack.set(c, PriorityFastForward.stackIds(game));
+        final List<SpellAbility> now = ActionSpace.getPossibleActions(blue, true, true);
+        final Method ids = ManaBrewInteractiveController.class.getDeclaredMethod("responseIds", List.class);
+        ids.setAccessible(true);
+        final Field held = ManaBrewInteractiveController.class.getDeclaredField("heldActionIds");
+        held.setAccessible(true);
+        held.set(c, ids.invoke(null, now));
+    }
+
+    private static void make(final Player p, final int amount, final String script) {
+        final Card host = add("Grizzly Bears", p, ZoneType.Hand);
+        final SpellAbility sa = AbilityFactory.getAbility("DB$ Token | TokenAmount$ " + amount + " | TokenScript$ " + script, host);
+        sa.setActivatingPlayer(p);
+        AbilityUtils.resolve(sa);
+        p.getZone(ZoneType.Hand).remove(host);
+    }
+
+    private static Card add(final String name, final Player p, final ZoneType zone) {
+        IPaperCard paper = FModel.getMagicDb().getCommonCards().getCard(name);
+        if (paper == null) {
+            StaticData.instance().attemptToLoadCard(name);
+            paper = FModel.getMagicDb().getCommonCards().getCard(name);
+        }
+        final Card card = Card.fromPaperCard(paper, p);
+        card.setGameTimestamp(p.getGame().getNextTimestamp());
+        p.getZone(zone).add(card);
+        return card;
+    }
+}
