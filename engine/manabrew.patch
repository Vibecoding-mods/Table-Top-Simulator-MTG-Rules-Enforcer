+
+public final class ApplyStateCreateCardTest {
+    private ApplyStateCreateCardTest() {}
+
+    public static void main(final String[] args) throws Exception {
+        GuiBase.setInterface(new HeadlessGuiBase("forge/forge-gui/"));
+        FModel.initialize(null, prefs -> {
+            prefs.setPref(FPref.LOAD_CARD_SCRIPTS_LAZILY, true);
+            prefs.setPref(FPref.UI_LANGUAGE, "en-US");
+            return null;
+        });
+
+        check("planeswalkerEntersWithItsPrintedLoyalty", ApplyStateCreateCardTest::planeswalkerEntersWithItsPrintedLoyalty);
+        check("walkersOnEitherSideKeepTheirLoyalty", ApplyStateCreateCardTest::walkersOnEitherSideKeepTheirLoyalty);
+        check("battleEntersWithItsPrintedDefense", ApplyStateCreateCardTest::battleEntersWithItsPrintedDefense);
+        check("creatureEntersWithNoCounters", ApplyStateCreateCardTest::creatureEntersWithNoCounters);
+        System.out.println(failed == 0 ? "PASS ApplyStateCreateCardTest" : "FAIL ApplyStateCreateCardTest: " + failed + " failed");
+        System.exit(failed == 0 ? 0 : 1);
+    }
+
+    private interface Check {
+        void run() throws Exception;
+    }
+
+    private static int failed;
+
+    private static void check(final String name, final Check check) {
+        try {
+            check.run();
+            System.out.println("ok " + name);
+        } catch (final Throwable failure) {
+            failed++;
+            System.out.println("FAIL " + name + ": " + failure);
+        }
+    }
+
+    private static void planeswalkerEntersWithItsPrintedLoyalty() throws Exception {
+        final Fixture f = new Fixture();
+        f.create("Jace Beleren", "player-1");
+        final Card jace = f.onBattlefield(f.blue, "Jace Beleren");
+        if (jace.getCounters(CounterEnumType.LOYALTY) != 3) {
+            throw new AssertionError("Jace Beleren has " + jace.getCounters(CounterEnumType.LOYALTY) + " loyalty, not 3");
+        }
+    }
+
+    private static void walkersOnEitherSideKeepTheirLoyalty() throws Exception {
+        final Fixture f = new Fixture();
+        f.game.getPhaseHandler().devModeSet(PhaseType.MAIN2, f.blue);
+        final String[][] walkers = {
+            {"Jace Beleren", "player-0", "3"},
+            {"Chandra, Torch of Defiance", "player-0", "4"},
+            {"Nissa, Who Shakes the World", "player-1", "5"},
+            {"Teferi, Hero of Dominaria", "player-1", "4"},
+        };
+        for (final String[] w : walkers) {
+            f.create(w[0], w[1]);
+        }
+        f.game.getAction().checkStateEffects(true);
+        for (final String[] w : walkers) {
+            final Card walker = f.onBattlefield("player-0".equals(w[1]) ? f.white : f.blue, w[0]);
+            if (walker.getCounters(CounterEnumType.LOYALTY) != Integer.parseInt(w[2])) {
+                throw new AssertionError(w[0] + " has " + walker.getCounters(CounterEnumType.LOYALTY) + " loyalty, not " + w[2]);
+            }
+        }
+    }
+
+    private static void battleEntersWithItsPrintedDefense() throws Exception {
+        final Fixture f = new Fixture();
+        f.create("Invasion of Zendikar", "player-0");
+        final Card battle = f.onBattlefield(f.white, "Invasion of Zendikar");
+        if (battle.getCounters(CounterEnumType.DEFENSE) != 3) {
+            throw new AssertionError("Invasion of Zendikar has " + battle.getCounters(CounterEnumType.DEFENSE) + " defense, not 3");
+        }
+    }
+
+    private static void creatureEntersWithNoCounters() throws Exception {
+        final Fixture f = new Fixture();
+        f.create("Grizzly Bears", "player-0");
+        final Card bears = f.onBattlefield(f.white, "Grizzly Bears");
+        if (!bears.getCounters().isEmpty()) {
+            throw new AssertionError("Grizzly Bears has counters " + bears.getCounters());
+        }
+    }
+
+    private static final class Fixture {
+        final ManaBrewInteractiveSession session = new ManaBrewInteractiveSession("apply-state-create-card-test");
+        final Game game = newGame();
+        final Player white = game.getPlayers().get(0);
+        final Player blue = game.getPlayers().get(1);
+
+        Fixture() {
+            session.attach(game.getMatch(), game, Set.of(), true);
+        }
+
+        void create(final String name, final String player) throws Exception {
+            final JsonObject action = JsonParser.parseString("{\"fixId\":1,\"ops\":[{\"op\":\"createCard\",\"name\":\"" + name
+                    + "\",\"player\":\"" + player + "\",\"zone\":\"battlefield\"}]}").getAsJsonObject();
+            final Method apply = ManaBrewInteractiveSession.class.getDeclaredMethod("applyState", JsonObject.class);
+            apply.setAccessible(true);
+            apply.invoke(session, action);
+        }
+
+        Card onBattlefield(final Player player, final String name) {
+            for (final Card card : player.getCardsIn(ZoneType.Battlefield)) {
+                if (card.getName().equals(name)) {
+                    return card;
+                }
+            }
+            for (final Card card : player.getCardsIn(ZoneType.Graveyard)) {
+                if (card.getName().equals(name)) {
+                    throw new AssertionError(name + " went to the graveyard");
+                }
+            }
+            throw new AssertionError(name + " is not on the battlefield");
+        }
+
+        private Game newGame() {
+            final List<RegisteredPlayer> players = new ArrayList<>();
+            final Deck deck = new Deck();
+            players.add(new RegisteredPlayer(deck).setPlayer(new ManaBrewInteractiveLobbyPlayer("White", session)));
+            players.add(new RegisteredPlayer(deck).setPlayer(new LobbyPlayerAi("Blue", null)));
+            final GameRules rules = new GameRules(GameType.Constructed);
+            final Game created = new Game(players, rules, new Match(rules, players, "ApplyStateCreateCardTest"));
+            created.setAge(GameStage.Play);
+            created.getPhaseHandler().devModeSet(PhaseType.MAIN1, created.getPlayers().get(0));
+            created.getPhaseHandler().onStackResolved();
+            return created;
+        }
+    }
+}
