+    private static boolean canPayWithChoices(
+            final List<List<ManaOption>> choices, final int index, final List<Integer> units, final int extraGeneric,
+            final List<ManaCostShard> colored, final int generic) {
+        if (index == choices.size()) {
+            return units.size() >= colored.size() + generic + extraGeneric && matchesColored(units, colored);
+        }
+        for (final ManaOption option : choices.get(index)) {
+            final List<Integer> next = new ArrayList<>(units);
+            next.addAll(option.units);
+            if (canPayWithChoices(choices, index + 1, next, extraGeneric + option.genericCost, colored, generic)) {
+                return true;
+            }
+        }
+        return canPayWithChoices(choices, index + 1, units, extraGeneric, colored, generic);
+    }
