+    private static void resolve(final Fixture f, final SpellAbility sa, final Player activator) throws Exception {
+        sa.setActivatingPlayer(activator);
+        withoutPrompts(f, "resolving " + sa.getHostCard(), () -> AbilityUtils.resolve(sa));
+    }
+
+    private static void withoutPrompts(final Fixture f, final String what, final Runnable step) throws Exception {
+        final Throwable[] failure = new Throwable[1];
+        final Thread runner = new Thread(() -> {
+            try {
+                step.run();
+            } catch (final Throwable thrown) {
+                failure[0] = thrown;
+            }
+        }, what);
+        runner.setDaemon(true);
+        runner.start();
+        runner.join(60_000);
+        if (runner.isAlive()) {
+            throw new AssertionError(what + " asked " + f.session.getLatestPromptJson());
+        }
+        if (failure[0] != null) {
+            throw new AssertionError(what + " failed", failure[0]);
+        }
+    }
+
+    private static void expect(final boolean condition, final String message) {
+        if (!condition) {
+            throw new AssertionError(message);
+        }
+    }
+
+    private static Card add(final String name, final Player p, final ZoneType zone) {
+        IPaperCard paper = FModel.getMagicDb().getCommonCards().getCard(name);
+        if (paper == null) {
+            StaticData.instance().attemptToLoadCard(name);
+            paper = FModel.getMagicDb().getCommonCards().getCard(name);
+        }
+        final Card card = Card.fromPaperCard(paper, p);
+        card.setGameTimestamp(p.getGame().getNextTimestamp());
+        p.getZone(zone).add(card);
+        return card;
+    }
+
+    private static final class Fixture {
+        final ManaBrewInteractiveSession session = new ManaBrewInteractiveSession("team-game-test");
+        final Game game;
+        final Player white;
+        final Player red;
+        final Player yellow;
+        final Player blue;
+
+        Fixture(final boolean shared, final GameType type, final int life) {
+            this(shared, shared, type, life);
+        }
+
+        Fixture(final boolean teams, final boolean shared, final GameType type, final int life) {
+            this(teams, shared, type, life, false);
+        }
+
+        Fixture(final boolean teams, final boolean shared, final GameType type, final int life, final boolean recording) {
+            final List<RegisteredPlayer> players = new ArrayList<>();
+            final String[] names = {"White", "Red", "Yellow", "Blue"};
+            for (int i = 0; i < 4; i++) {
+                final RegisteredPlayer rp = new RegisteredPlayer(new Deck()).setPlayer(new LobbyPlayerAi(names[i], null));
+                rp.setStartingLife(life);
+                if (teams) {
+                    rp.setTeamNumber(i < 2 ? 1 : 2);
+                }
+                players.add(rp);
+            }
+            final GameRules rules = new GameRules(type);
+            rules.setAppliedVariants(EnumSet.of(type));
+            rules.setSharedTeamLife(shared);
+            game = new Game(players, rules, new Match(rules, players, "TeamGameTest"));
+            game.setAge(GameStage.Play);
+            game.getPhaseHandler().devModeSet(PhaseType.MAIN1, game.getPlayers().get(0));
+            game.getPhaseHandler().onStackResolved();
+            white = game.getPlayers().get(0);
+            red = game.getPlayers().get(1);
+            yellow = game.getPlayers().get(2);
+            blue = game.getPlayers().get(3);
+            session.attach(game.getMatch(), game, Set.of(), recording);
+        }
+
+        JsonObject view(final int viewer) {
+            return JsonParser.parseString(session.getSnapshotJson(viewer)).getAsJsonObject();
+        }
+    }
+
+    static String id(final Card card) {
+        return SnapshotExtractor.javaCardId(card);
+    }
+}
