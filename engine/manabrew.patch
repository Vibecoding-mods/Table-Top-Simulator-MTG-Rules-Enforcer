+            expect(f.inCommand(name) == null, "the abandoned scheme is still in the command zone");
+            expect(f.inSchemeDeck(name), "the abandoned scheme is not in the scheme deck: " + names(f.white.getCardsIn(ZoneType.SchemeDeck)));
+        } else {
+            expect(f.inCommand(name) == null, "the non-ongoing scheme stayed in the command zone");
+            final List<Card> deck = new ArrayList<>(f.white.getCardsIn(ZoneType.SchemeDeck));
+            final int at = indexOf(deck, name);
+            expect(at >= 0, "the non-ongoing scheme did not go back to the scheme deck: " + names(deck));
+            for (int i = at + 1; i < deck.size(); i++) {
+                expect(!filler.contains(deck.get(i)), "the non-ongoing scheme is not on the bottom: " + names(deck));
