+    }
+
+    private static void controllerSeesTheControlledHand() throws Exception {
+        final Fixture f = new Fixture();
+        f.ai.addController(f.game.getNextTimestamp(), f.human);
+        if (!"visible".equals(f.aiHandVisibility(0))) {
