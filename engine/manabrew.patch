+    private static void stepTo(final Fixture f, final PhaseType target) throws Exception {
+        final PhaseHandler ph = f.game.getPhaseHandler();
+        final Method end = PhaseHandler.class.getDeclaredMethod("onPhaseEnd");
+        final Method advance = PhaseHandler.class.getDeclaredMethod("advanceToNextPhase");
+        final Method begin = PhaseHandler.class.getDeclaredMethod("onPhaseBegin");
+        end.setAccessible(true);
+        advance.setAccessible(true);
+        begin.setAccessible(true);
+        for (int i = 0; i < 16; i++) {
+            withoutPrompts(f, "stepping from " + ph.getPhase(), () -> {
+                invoke(end, ph);
+                invoke(advance, ph);
+                invoke(begin, ph);
+            });
+            if (ph.getPhase() == target) {
+                return;
+            }
+            clearStack(f);
+        }
+        throw new AssertionError("never reached " + target + ", at " + ph.getPhase());
+    }
+
+    private static void clearStack(final Fixture f) throws Exception {
+        final Field waiting = MagicStack.class.getDeclaredField("simultaneousStackEntryList");
+        waiting.setAccessible(true);
+        ((List<?>) waiting.get(f.game.getStack())).clear();
+        f.game.getStack().clear();
+    }
+
+    private static void invoke(final Method m, final Object target) {
+        try {
