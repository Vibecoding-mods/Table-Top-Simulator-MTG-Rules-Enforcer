+
+    private static void planeswalkOpMovesTheNamedPlane() throws Exception {
+        final Fixture f = new Fixture(true);
+        f.plane("Naya", f.white);
+        final Card akoum = f.plane("Akoum", f.blue);
+        f.apply("{\"op\":\"planeswalk\",\"player\":\"player-0\",\"name\":\"Akoum\"}");
+        expectApplied(f);
+        final JsonObject view = f.view();
+        expect(names(view.getAsJsonArray("activePlaneNames")).equals(List.of("Akoum")), "activePlaneNames " + view.get("activePlaneNames"));
+        final JsonObject planar = view.getAsJsonObject("planar");
+        expect(names(planar.getAsJsonArray("planeIds")).equals(List.of(SnapshotExtractor.javaCardId(f.commandCard("Akoum")))),
+                "planeIds " + planar.get("planeIds"));
+        expect(planar.getAsJsonObject("deckCounts").get("player-1").getAsInt() == 0, "Akoum is still in a planar deck");
+        expect(f.commandCard("Akoum").getZone().is(ZoneType.Command), "Akoum is not in a command zone");
+        expect(akoum.getOwner() == f.blue, "Akoum changed owner");
+    }
+
+    private static void planeswalkOpToAPlaneInNoDeckIsRefused() throws Exception {
+        final Fixture f = new Fixture(true);
+        f.plane("Naya", f.white);
+        f.apply("{\"op\":\"planeswalk\",\"player\":\"player-0\",\"name\":\"Akoum\"}");
+        expectRefused(f);
+    }
+
+    private static void planarOpsAreRefusedOutsidePlanechase() throws Exception {
+        final Fixture f = new Fixture(false);
+        f.apply("{\"op\":\"chaos\",\"player\":\"player-0\"}");
+        expectRefused(f);
+    }
+
+    private static void chaosOpIsApplied() throws Exception {
+        final Fixture f = new Fixture(true);
+        f.plane("Naya", f.white);
+        f.apply("{\"op\":\"chaos\",\"player\":\"player-0\"}");
+        expectApplied(f);
+    }
+
+    private static void aRollIsNotedOnceForEverySeat() throws Exception {
+        final Fixture f = new Fixture(true);
+        f.white.roll();
+        Planechase.noteRoll(f.white, "Planar dice result: Chaos");
+        Planechase.noteRoll(f.white, "Planar dice result: Chaos");
+        JsonObject roll = f.view().getAsJsonObject("planar").getAsJsonObject("lastRoll");
+        expect("player-0".equals(roll.get("playerId").getAsString()), "playerId " + roll.get("playerId"));
+        expect("chaos".equals(roll.get("result").getAsString()), "result " + roll.get("result"));
+        expect(roll.get("seq").getAsInt() == 1, "two seats' notices made seq " + roll.get("seq"));
+        f.white.roll();
+        Planechase.noteRoll(f.white, "Planar dice result: Planeswalk");
+        roll = f.view().getAsJsonObject("planar").getAsJsonObject("lastRoll");
+        expect("planeswalk".equals(roll.get("result").getAsString()) && roll.get("seq").getAsInt() == 2,
+                "the second roll reads " + roll);
+    }
+
+    private static void aPlanechaseGameTakesNoRestorePoints() throws Exception {
+        final Fixture f = new Fixture(true);
+        f.recordCheckpoint();
+        expect(f.view().getAsJsonArray("checkpoints").isEmpty(), "a Planechase game took a restore point");
+    }
+
+    private static void anotherGameStillTakesRestorePoints() throws Exception {
+        final Fixture f = new Fixture(false);
+        f.recordCheckpoint();
+        expect(f.view().getAsJsonArray("checkpoints").size() == 1, "a game without Planechase took no restore point");
+    }
+
+    private static List<String> names(final JsonArray array) {
+        final List<String> names = new ArrayList<>();
+        for (final JsonElement name : array) {
+            names.add(name.getAsString());
+        }
+        return names;
+    }
+
+    private static void expectApplied(final Fixture f) {
+        final JsonObject fix = f.view().getAsJsonObject("stateFix");
+        expect(fix != null && fix.get("applied").getAsBoolean(), "the fix was not applied: " + fix);
+        expect(!fix.has("dropped") || fix.getAsJsonArray("dropped").isEmpty(), "the fix dropped " + fix.get("dropped"));
+    }
+
+    private static void expectRefused(final Fixture f) {
+        final JsonObject fix = f.view().getAsJsonObject("stateFix");
+        expect(fix != null && !fix.get("applied").getAsBoolean(), "the fix was applied: " + fix);
+    }
+
+    private static void expect(final boolean condition, final String message) {
+        if (!condition) {
+            throw new AssertionError(message);
+        }
+    }
+
+    private static final class Fixture {
+        final ManaBrewInteractiveSession session = new ManaBrewInteractiveSession("planechase-test");
+        final Game game;
+        final Player white;
+        final Player blue;
+        private int fixId;
+
+        Fixture(final boolean planechase) {
+            game = newGame(planechase);
+            white = game.getPlayers().get(0);
+            blue = game.getPlayers().get(1);
+            session.attach(game.getMatch(), game, Set.of(), true);
+        }
+
+        Card plane(final String name, final Player owner) {
+            PaperCard paper = StaticData.instance().fetchCard(name);
+            if (paper == null) {
+                StaticData.instance().attemptToLoadCard(name);
+                paper = StaticData.instance().fetchCard(name);
+            }
+            final Card card = Card.fromPaperCard(paper, owner);
+            owner.getZone(ZoneType.PlanarDeck).add(card);
+            return card;
+        }
+
+        Card commandCard(final String name) {
+            for (final Player player : game.getPlayers()) {
+                for (final Card card : player.getCardsIn(ZoneType.Command)) {
+                    if (card.getName().equals(name)) {
+                        return card;
+                    }
+                }
+            }
+            throw new AssertionError(name + " is in no command zone");
+        }
+
+        void apply(final String op) throws Exception {
+            final JsonObject action = JsonParser.parseString("{\"fixId\":" + (++fixId) + ",\"ops\":[" + op + "]}").getAsJsonObject();
+            final Method apply = ManaBrewInteractiveSession.class.getDeclaredMethod("applyState", JsonObject.class);
+            apply.setAccessible(true);
+            apply.invoke(session, action);
+        }
+
+        void recordCheckpoint() throws Exception {
+            final Method record = ManaBrewInteractiveSession.class.getDeclaredMethod("recordCheckpoint");
+            record.setAccessible(true);
+            record.invoke(session);
+        }
+
+        JsonObject view() {
+            return JsonParser.parseString(session.getSnapshotJson(0)).getAsJsonObject();
+        }
+
+        private Game newGame(final boolean planechase) {
+            final List<RegisteredPlayer> players = new ArrayList<>();
+            final Deck deck = new Deck();
+            players.add(new RegisteredPlayer(deck).setPlayer(new ManaBrewInteractiveLobbyPlayer("White", session)));
+            players.add(new RegisteredPlayer(deck).setPlayer(new LobbyPlayerAi("Blue", null)));
+            final GameRules rules = new GameRules(GameType.Constructed);
+            rules.setAppliedVariants(planechase
+                    ? EnumSet.of(GameType.Constructed, GameType.Planechase)
+                    : EnumSet.of(GameType.Constructed));
+            final Game created = new Game(players, rules, new Match(rules, players, "PlanechaseTest"));
+            created.setAge(GameStage.Play);
+            created.getPhaseHandler().devModeSet(PhaseType.MAIN1, created.getPlayers().get(0));
+            created.getPhaseHandler().onStackResolved();
+            return created;
+        }
+    }
+}
