+
+                @Override
+                public void declareBlockers(final Player defender, final Combat combat) {
+                    final Player changer = combat.getTeamBlockChangedBy();
+                    asked.add(defender.getName() + (combat.getTeamBlockRound() > 0 ? " after " + (changer == null ? "nobody" : changer.getName()) : ""));
+                    for (final Card own : new ArrayList<>(combat.getAllBlockers())) {
+                        if (own.getController() == defender) {
+                            combat.undoBlockingAssignment(own);
