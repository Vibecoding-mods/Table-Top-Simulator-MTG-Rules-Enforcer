+            for (final Method method : ManaBrewInteractiveSession.class.getDeclaredMethods()) {
+                if (method.getName().equals("restore") && method.getParameterCount() == 1) {
+                    method.setAccessible(true);
+                    method.invoke(session, first);
+                    return;
+                }
+            }
+            throw new AssertionError("no restore method");
+        }
+
+        void requestRestore(final int requester) throws Exception {
+            final Object first = checkpoints().peekFirst();
+            final Field id = first.getClass().getDeclaredField("id");
+            id.setAccessible(true);
+            final Method request = ManaBrewInteractiveSession.class.getDeclaredMethod("requestRestore", int.class, int.class);
+            request.setAccessible(true);
+            request.invoke(session, requester, id.getInt(first));
+        }
+
+        Set<Integer> awaiting() throws Exception {
+            final Field voteField = ManaBrewInteractiveSession.class.getDeclaredField("restoreVote");
+            voteField.setAccessible(true);
+            final Object vote = voteField.get(session);
+            if (vote == null) {
+                throw new AssertionError("no vote was opened");
+            }
+            final Field awaiting = vote.getClass().getDeclaredField("awaiting");
+            awaiting.setAccessible(true);
+            @SuppressWarnings("unchecked")
+            final Set<Integer> seats = (Set<Integer>) awaiting.get(vote);
+            return new TreeSet<>(seats);
+        }
+
+        private Deque<?> checkpoints() throws Exception {
+            final Field field = ManaBrewInteractiveSession.class.getDeclaredField("checkpoints");
+            field.setAccessible(true);
+            return (Deque<?>) field.get(session);
+        }
+
+        private Game newGame(final GameType type) {
+            final List<RegisteredPlayer> players = new ArrayList<>();
+            final Deck deck = new Deck();
+            players.add(new RegisteredPlayer(deck).setPlayer(new ManaBrewInteractiveLobbyPlayer("White", session)));
+            players.add(new RegisteredPlayer(deck).setPlayer(new ManaBrewInteractiveLobbyPlayer("Blue", session)));
+            players.add(new RegisteredPlayer(deck).setPlayer(new LobbyPlayerAi("Red", null)));
+            final GameRules rules = new GameRules(type);
+            final Game created = new Game(players, rules, new Match(rules, players, "RejoinRewindTest"));
+            created.setAge(GameStage.Play);
+            created.getPhaseHandler().devModeSet(PhaseType.MAIN1, created.getPlayers().get(0));
+            created.getPhaseHandler().onStackResolved();
+            return created;
+        }
+    }
+
+    private static Card add(final String name, final Player p, final ZoneType zone) {
+        IPaperCard paper = FModel.getMagicDb().getCommonCards().getCard(name);
+        if (paper == null) {
+            StaticData.instance().attemptToLoadCard(name);
+            paper = FModel.getMagicDb().getCommonCards().getCard(name);
+        }
+        final Card card = Card.fromPaperCard(paper, p);
+        card.setGameTimestamp(p.getGame().getNextTimestamp());
+        p.getZone(zone).add(card);
+        return card;
+    }
+}
