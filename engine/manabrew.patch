+    private static void sharedTurnsSetsBothFlags() {
+        final GameRules turns = rulesFor("sharedTurns");
+        expect(turns.hasSharedTeamTurns(), "sharedTurns did not set shared team turns");
+        expect(turns.hasSharedTeamLife(), "sharedTurns did not set shared team life (rule 810.4)");
+        expect(turns.getPoisonCountersToLose() == 15, "sharedTurns poison to lose " + turns.getPoisonCountersToLose());
+        final GameRules life = rulesFor("sharedLife");
+        expect(!life.hasSharedTeamTurns(), "level 1 sharedLife set shared team turns");
+        expect(life.hasSharedTeamLife(), "level 1 sharedLife lost shared life");
+    }
+
+    private static GameRules rulesFor(final String teamRules) {
+        final StringBuilder players = new StringBuilder();
+        for (int i = 0; i < 4; i++) {
+            players.append(i == 0 ? "" : ",").append("{\"name\":\"P").append(i)
+                    .append("\",\"deck\":[{\"name\":\"Forest\"}],\"team\":").append(i < 2 ? 1 : 2).append("}");
+        }
+        final ManaBrewEngineAdapter.StartGameRequest request = ManaBrewEngineAdapter.parseStartGameRequest(
+                "{\"gameId\":\"shared-turns-test\",\"variant\":\"Constructed\",\"teamRules\":\"" + teamRules
+                        + "\",\"players\":[" + players + "]}");
+        final GameRules rules = new GameRules(GameType.Constructed);
+        rules.setAppliedVariants(EnumSet.of(GameType.Constructed));
+        ManaBrewEngineAdapter.configureTeamRules(rules, request, GameType.Constructed);
+        return rules;
+    }
