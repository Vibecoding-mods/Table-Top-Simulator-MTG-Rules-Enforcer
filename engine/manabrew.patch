+    private static Thread answerTheNextQuestion(final Seated f, final String before) {
+        final Thread t = new Thread(() -> {
+            final long until = System.nanoTime() + 10_000_000_000L;
+            while (System.nanoTime() < until) {
+                final String now = f.session.getLatestPromptJson();
+                if (now != null && !now.equals(before) && now.contains("This turn passed the engine's limit")) {
+                    f.session.submitAction("{\"type\":\"chooseBoolean\",\"output\":{\"type\":\"chooseBooleanDecision\",\"value\":true}}");
+                    return;
+                }
+                try {
+                    Thread.sleep(20);
+                } catch (final InterruptedException e) {
+                    return;
+                }
+            }
+        });
+        t.setDaemon(true);
+        t.start();
+        return t;
+    }
