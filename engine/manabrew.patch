+package forge.harness.host;
+
+import forge.game.Game;
+import forge.game.phase.ExtraTurn;
+import forge.game.phase.PhaseHandler;
+import forge.game.player.Player;
+import forge.game.player.PlayerStatistics;
+
+import java.lang.reflect.Field;
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Stack;
+
+final class ExtraTurnState {
+    private static final Field QUEUE = field(PhaseHandler.class, "extraTurns");
+    private static final Field PLAYED = field(PlayerStatistics.class, "extraTurnsPlayed");
+
+    private final List<ExtraTurn> queue;
+    private final Map<Player, PlayerTurns> players = new LinkedHashMap<>();
+
+    private static final class PlayerTurns {
+        private final int count;
+        private final boolean taking;
+        private final int played;
+
+        private PlayerTurns(final Player player) {
+            count = player.getExtraTurnCount();
+            taking = player.isExtraTurn();
+            played = player.getExtraTurnsPlayed();
+        }
+    }
+
+    ExtraTurnState(final Game game) {
+        queue = new ArrayList<>(queue(game.getPhaseHandler()));
+        for (final Player player : game.getRegisteredPlayers()) {
+            players.put(player, new PlayerTurns(player));
+        }
+    }
+
+    void restore(final Game game) {
+        final Stack<ExtraTurn> live = queue(game.getPhaseHandler());
+        live.clear();
+        live.addAll(queue);
+        for (final Map.Entry<Player, PlayerTurns> entry : players.entrySet()) {
+            final Player player = entry.getKey();
+            final PlayerTurns saved = entry.getValue();
+            player.setExtraTurnCount(saved.count);
+            player.setExtraTurn(saved.taking);
+            try {
+                PLAYED.setInt(player.getStats(), saved.played);
+            } catch (final IllegalAccessException e) {
+                throw new IllegalStateException(e);
+            }
+        }
+    }
+
+    static int queuedFor(final Game game, final Player player) {
+        final Stack<ExtraTurn> turns = queue(game.getPhaseHandler());
+        int count = 0;
+        for (int i = 1; i < turns.size(); i++) {
+            if (turns.get(i).getPlayer().equals(player)) {
+                count++;
+            }
+        }
+        return count;
+    }
+
+    @SuppressWarnings("unchecked")
+    private static Stack<ExtraTurn> queue(final PhaseHandler handler) {
+        try {
+            return (Stack<ExtraTurn>) QUEUE.get(handler);
+        } catch (final IllegalAccessException e) {
+            throw new IllegalStateException(e);
+        }
+    }
+
+    private static Field field(final Class<?> owner, final String name) {
+        try {
+            final Field field = owner.getDeclaredField(name);
+            field.setAccessible(true);
+            return field;
+        } catch (final NoSuchFieldException e) {
+            throw new IllegalStateException(e);
+        }
+    }
+}
