+        expect(f.white.getLife() == white && f.red.getLife() == red && f.yellow.getLife() == yellow && f.blue.getLife() == blue,
+                "life " + f.white.getLife() + "/" + f.red.getLife() + "/" + f.yellow.getLife() + "/" + f.blue.getLife()
+                        + ", expected " + white + "/" + red + "/" + yellow + "/" + blue);
