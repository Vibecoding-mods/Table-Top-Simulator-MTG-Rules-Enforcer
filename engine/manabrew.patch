+    private void applyLibraryOp(final JsonObject op) {
+        final Player player = statePlayer(op.get("player").getAsString());
+        final int n = op.get("n").getAsInt();
+        if ("draw".equals(op.get("op").getAsString())) {
+            player.drawCards(n);
+            return;
+        }
+        final SpellAbility mill = new SpellAbility.EmptySa(ApiType.Mill, stateOpHost(player), player);
+        final Map<AbilityKey, Object> moveParams = AbilityKey.newMap();
+        final CardZoneTable table = AbilityKey.addCardZoneTableParams(moveParams, mill);
+        game.getAction().mill(new PlayerCollection(player), n, ZoneType.Graveyard, mill, moveParams);
+        table.triggerChangesZoneAll(game, mill);
+        game.getTriggerHandler().runWaitingTriggers();
+    }
