@@ -0,0 +1,185 @@
+package forge.harness.host;
+
+import com.google.gson.JsonObject;
+import forge.StaticData;
+import forge.game.Game;
+import forge.game.GameType;
+import forge.game.ability.AbilityKey;
+import forge.game.card.Card;
+import forge.game.card.CardCollection;
+import forge.game.player.Player;
+import forge.game.trigger.TriggerType;
+import forge.game.zone.ZoneType;
+import forge.harness.common.SnapshotExtractor;
+import forge.harness.host.ManaBrewEngineAdapter.CardIdentity;
+import forge.item.PaperCard;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import java.util.Random;
+import java.util.WeakHashMap;
+
+final class Planechase {
+    private Planechase() {}
+
+    private static final Map<Game, Map<String, Object>> LAST_ROLLS = Collections.synchronizedMap(new WeakHashMap<>());
+
+    static boolean isPlanechase(final Game game) {
+        return game.getRules().hasAppliedVariant(GameType.Planechase);
+    }
+
+    static List<List<PaperCard>> planarDecks(final List<List<CardIdentity>> requested, final long seed) {
+        boolean any = false;
+        boolean everyHasAPlane = true;
+        final List<List<PaperCard>> own = new ArrayList<>();
+        for (final List<CardIdentity> cards : requested) {
+            final List<PaperCard> deck = new ArrayList<>();
+            for (final CardIdentity card : cards) {
+                deck.add(planeCard(card.getName()));
+            }
+            any |= !deck.isEmpty();
+            everyHasAPlane &= deck.stream().anyMatch(card -> !isPhenomenon(card));
+            own.add(deck);
+        }
+        if (!any) {
+            return null;
+        }
+        if (everyHasAPlane) {
+            return own;
+        }
+        final List<PaperCard> planes = new ArrayList<>();
+        final List<PaperCard> phenomena = new ArrayList<>();
+        for (final List<PaperCard> deck : own) {
+            for (final PaperCard card : deck) {
+                (isPhenomenon(card) ? phenomena : planes).add(card);
+            }
+        }
+        if (planes.size() < requested.size()) {
+            throw new IllegalArgumentException("Planechase needs at least one plane per player: "
+                    + planes.size() + " planes for " + requested.size() + " players");
+        }
+        final Random rng = new Random(seed);
+        Collections.shuffle(planes, rng);
+        Collections.shuffle(phenomena, rng);
+        final List<List<PaperCard>> dealt = new ArrayList<>();
+        for (int i = 0; i < requested.size(); i++) {
+            dealt.add(new ArrayList<>());
+        }
+        int seat = 0;
+        for (final PaperCard card : planes) {
+            dealt.get(seat++ % dealt.size()).add(card);
+        }
+        for (final PaperCard card : phenomena) {
+            dealt.get(seat++ % dealt.size()).add(card);
+        }
+        return dealt;
+    }
+
+    private static boolean isPhenomenon(final PaperCard card) {
+        return card.getRules().getType().isPhenomenon();
+    }
+
+    private static PaperCard planeCard(final String name) {
+        PaperCard card = StaticData.instance().fetchCard(name);
+        if (card == null) {
+            StaticData.instance().attemptToLoadCard(name);
+            card = StaticData.instance().fetchCard(name);
+        }
+        if (card == null || !(card.getRules().getType().isPlane() || isPhenomenon(card))) {
+            throw new IllegalArgumentException("no plane or phenomenon named " + name);
+        }
+        return card;
+    }
+
+    static Map<String, Object> planarState(final Game game) {
+        if (!isPlanechase(game)) {
+            return null;
+        }
+        final Map<String, Object> state = new LinkedHashMap<>();
+        final List<String> planeIds = new ArrayList<>();
+        Player controller = game.getPhaseHandler().getPlayerTurn();
+        if (game.getActivePlanes() != null) {
+            for (final Card plane : game.getActivePlanes()) {
+                planeIds.add(SnapshotExtractor.javaCardId(plane));
+                controller = plane.getController() != null ? plane.getController() : controller;
+            }
+        }
+        state.put("controllerId", controller == null ? "" : "player-" + SnapshotExtractor.playerIndex(game, controller));
+        state.put("planeIds", planeIds);
+        state.put("dieRollsThisTurn", game.getPhaseHandler().getPlanarDiceSpecialActionThisTurn());
+        final Map<String, Integer> deckCounts = new LinkedHashMap<>();
+        for (final Player player : game.getRegisteredPlayers()) {
+            deckCounts.put("player-" + SnapshotExtractor.playerIndex(game, player),
+                    player.getCardsIn(ZoneType.PlanarDeck).size());
+        }
+        state.put("deckCounts", deckCounts);
+        final Map<String, Object> lastRoll = LAST_ROLLS.get(game);
+        if (lastRoll != null) {
+            state.put("lastRoll", lastRoll);
+        }
+        return state;
+    }
+
+    static void noteRoll(final Player roller, final String message) {
+        final Game game = roller.getGame();
+        final String result = message.substring(message.lastIndexOf(' ') + 1).toLowerCase(Locale.ROOT);
+        final String playerId = "player-" + SnapshotExtractor.playerIndex(game, roller);
+        final int turn = game.getPhaseHandler().getTurn();
+        final int roll = roller.getNumRollsThisTurn();
+        synchronized (LAST_ROLLS) {
+            final Map<String, Object> last = LAST_ROLLS.get(game);
+            if (last != null && playerId.equals(last.get("playerId"))
+                    && Integer.valueOf(turn).equals(last.get("turn")) && Integer.valueOf(roll).equals(last.get("roll"))) {
+                return;
+            }
+            final Map<String, Object> next = new LinkedHashMap<>();
+            next.put("playerId", playerId);
+            next.put("result", result);
+            next.put("seq", last == null ? 1 : (Integer) last.get("seq") + 1);
+            next.put("turn", turn);
+            next.put("roll", roll);
+            LAST_ROLLS.put(game, next);
+        }
+    }
+
+    static String opError(final Game game, final Player player, final JsonObject op) {
+        if (!isPlanechase(game)) {
+            return "this is not a Planechase game";
+        }
+        if ("planeswalk".equals(op.get("op").getAsString()) && planarDeckCard(game, op.get("name").getAsString()) == null) {
+            return "no plane named " + op.get("name").getAsString() + " in a planar deck";
+        }
+        return null;
+    }
+
+    static boolean applyOp(final Game game, final Player player, final JsonObject op) {
+        if ("chaos".equals(op.get("op").getAsString())) {
+            game.getTriggerHandler().runTrigger(TriggerType.ChaosEnsues, AbilityKey.mapFromPlayer(player), false);
+            return true;
+        }
+        final Card destination = planarDeckCard(game, op.get("name").getAsString());
+        if (destination == null) {
+            return false;
+        }
+        for (final Player p : game.getPlayers()) {
+            p.leaveCurrentPlane();
+        }
+        player.planeswalkTo(null, new CardCollection(destination));
+        return true;
+    }
+
+    private static Card planarDeckCard(final Game game, final String name) {
+        for (final Player player : game.getRegisteredPlayers()) {
+            for (final Card card : player.getCardsIn(ZoneType.PlanarDeck)) {
+                if (name.equals(card.getName())) {
+                    return card;
+                }
+            }
+        }
+        return null;
+    }
+}
