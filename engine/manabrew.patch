+import forge.item.PaperCard;
+import forge.localinstance.properties.ForgePreferences.FPref;
+import forge.model.FModel;
+
+import java.lang.reflect.Method;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Set;
+import java.util.TreeSet;
+
+public final class FirstPlayerTest {
+    private FirstPlayerTest() {}
+
+    private static final int TRIES = 12;
+    private static final List<String> SCHEMES = List.of("A Display of My Dark Power", "A Premonition of Your Demise",
+            "A Reckoning Approaches", "All Shall Smolder in My Wake", "Approach My Molten Realm", "Behold My Grandeur",
+            "Behold the Power of Destruction", "Chaos Is My Plaything", "Choose Your Champion", "Choose Your Demise");
+
+    public static void main(final String[] args) throws Exception {
+        GuiBase.setInterface(new HeadlessGuiBase("forge/forge-gui/"));
+        FModel.initialize(null, prefs -> {
+            prefs.setPref(FPref.LOAD_CARD_SCRIPTS_LAZILY, true);
+            prefs.setPref(FPref.UI_LANGUAGE, "en-US");
+            return null;
+        });
+        check("theNamedFirstPlayerTakesTheFirstTurn", FirstPlayerTest::theNamedFirstPlayerTakesTheFirstTurn);
+        check("theArchenemyTakesTheFirstTurnWhenNoneIsNamed", FirstPlayerTest::theArchenemyTakesTheFirstTurnWhenNoneIsNamed);
+        check("aNamedFirstPlayerBeatsTheArchenemyDefault", FirstPlayerTest::aNamedFirstPlayerBeatsTheArchenemyDefault);
+        check("withoutTheFieldTheFirstPlayerStaysRandom", FirstPlayerTest::withoutTheFieldTheFirstPlayerStaysRandom);
+        check("aFirstPlayerThatIsNoSeatIsRefused", FirstPlayerTest::aFirstPlayerThatIsNoSeatIsRefused);
+        check("aFirstPlayerThatDisagreesWithGoesFirstIsRefused", FirstPlayerTest::aFirstPlayerThatDisagreesWithGoesFirstIsRefused);
+        check("goesFirstStillWorksAlone", FirstPlayerTest::goesFirstStillWorksAlone);
+        System.out.println(failed == 0 ? "PASS FirstPlayerTest" : "FAIL FirstPlayerTest: " + failed + " failed");
+        System.exit(failed == 0 ? 0 : 1);
+    }
+
+    private interface Check {
+        void run() throws Exception;
+    }
+
+    private static int failed;
+
+    private static void check(final String name, final Check check) {
+        try {
+            check.run();
+            System.out.println("ok " + name);
+        } catch (final Throwable failure) {
+            failed++;
+            System.out.println("FAIL " + name + ": " + failure);
+        }
+    }
+
+    private static void theNamedFirstPlayerTakesTheFirstTurn() throws Exception {
+        expect(firsts(json(4, ",\"firstPlayer\":2", -1, -1)).equals(Set.of(2)), "with firstPlayer 2 the first turns went to seats " + firsts(json(4, ",\"firstPlayer\":2", -1, -1)));
+        expect(firsts(json(4, ",\"firstPlayer\":0", -1, -1)).equals(Set.of(0)), "with firstPlayer 0 the first turns went to seats " + firsts(json(4, ",\"firstPlayer\":0", -1, -1)));
+    }
+
+    private static void theArchenemyTakesTheFirstTurnWhenNoneIsNamed() throws Exception {
+        final Set<Integer> firsts = firsts(json(4, "", 2, -1));
+        expect(firsts.equals(Set.of(2)), "with the archenemy on seat 2 the first turns went to seats " + firsts + " (rule 904.6)");
+        final Fixture f = new Fixture(json(4, "", 2, -1));
+        expect(f.rules.getStartingPlayer() == 2, "the start request names seat " + f.rules.getStartingPlayer() + " to go first, not the archenemy's seat 2");
+    }
+
+    private static void aNamedFirstPlayerBeatsTheArchenemyDefault() throws Exception {
+        final Set<Integer> firsts = firsts(json(4, ",\"firstPlayer\":1", 2, -1));
+        expect(firsts.equals(Set.of(1)), "with firstPlayer 1 and the archenemy on seat 2 the first turns went to seats " + firsts);
+    }
+
+    private static void withoutTheFieldTheFirstPlayerStaysRandom() throws Exception {
+        final Fixture f = new Fixture(json(4, "", -1, -1));
+        expect(f.rules.getStartingPlayer() == -1, "a start request without firstPlayer names seat " + f.rules.getStartingPlayer());
+        final Set<Integer> firsts = firsts(json(4, "", -1, -1));
+        expect(firsts.size() > 1, "without firstPlayer every one of " + TRIES + " starts went to seat " + firsts);
+    }
+
+    private static void aFirstPlayerThatIsNoSeatIsRefused() {
+        expectRefused(json(4, ",\"firstPlayer\":4", -1, -1), "firstPlayer 4 is not a seat: the seats are 0 to 3");
+        expectRefused(json(4, ",\"firstPlayer\":-1", -1, -1), "firstPlayer -1 is not a seat");
+    }
+
+    private static void aFirstPlayerThatDisagreesWithGoesFirstIsRefused() {
+        expectRefused(json(4, ",\"firstPlayer\":1", -1, 3), "firstPlayer 1 disagrees with goesFirst on seat 3");
+        new Fixture(json(4, ",\"firstPlayer\":3", -1, 3));
+    }
+
+    private static void goesFirstStillWorksAlone() throws Exception {
+        final Set<Integer> firsts = firsts(json(4, "", -1, 3));
+        expect(firsts.equals(Set.of(3)), "with goesFirst on seat 3 the first turns went to seats " + firsts);
+    }
+
+    private static Set<Integer> firsts(final String json) throws Exception {
+        final Set<Integer> seats = new TreeSet<>();
+        for (int i = 0; i < TRIES; i++) {
+            final Fixture f = new Fixture(json);
+            seats.add(f.game.getPlayers().indexOf(f.firstTurnPlayer()));
+        }
+        return seats;
+    }
+
+    private static void expectRefused(final String json, final String message) {
+        try {
+            new Fixture(json);
+        } catch (final IllegalArgumentException refused) {
+            expect(refused.getMessage().contains(message), "refused with \"" + refused.getMessage() + "\", not \"" + message + "\"");
+            return;
+        }
+        throw new AssertionError("a start was accepted that should be refused with \"" + message + "\"");
+    }
+
+    private static String json(final int players, final String extra, final int archenemy, final int goesFirst) {
+        final String[] names = {"White", "Blue", "Red", "Yellow"};
+        final StringBuilder out = new StringBuilder("{\"gameId\":\"first-player-test\",\"variant\":\"Constructed\"").append(extra).append(",\"players\":[");
+        for (int i = 0; i < players; i++) {
+            out.append(i == 0 ? "" : ",").append("{\"name\":\"").append(names[i]).append("\",\"deck\":[{\"name\":\"Plains\"}]");
+            if (i == goesFirst) {
+                out.append(",\"goesFirst\":true");
+            }
+            if (i == archenemy) {
+                out.append(",\"schemes\":[");
+                for (int j = 0; j < 20; j++) {
+                    out.append(j == 0 ? "" : ",").append("{\"name\":\"").append(SCHEMES.get(j / 2)).append("\"}");
+                }
+                out.append("]");
+            }
+            out.append("}");
+        }
+        return out.append("]}").toString();
+    }
+
+    private static void expect(final boolean condition, final String message) {
+        if (!condition) {
+            throw new AssertionError(message);
+        }
+    }
+
+    private static final class Fixture {
+        final GameRules rules;
+        final Game game;
+
+        Fixture(final String json) {
+            final ManaBrewEngineAdapter.StartGameRequest request = ManaBrewEngineAdapter.parseStartGameRequest(json);
+            final List<List<PaperCard>> schemeDecks = Archenemy.schemeDecks(request);
+            final boolean archenemyGame = Archenemy.isArchenemyGame(request, schemeDecks);
+            final Set<GameType> variants = ManaBrewEngineAdapter.appliedVariants(GameType.Constructed, false, archenemyGame);
+            rules = new GameRules(GameType.Constructed);
+            rules.setAppliedVariants(variants);
+            ManaBrewEngineAdapter.configureStart(rules, request, GameType.Constructed, schemeDecks);
+            final List<RegisteredPlayer> registered = new ArrayList<>();
+            for (int i = 0; i < request.getPlayers().size(); i++) {
+                final ManaBrewEngineAdapter.PlayerConfig config = request.getPlayers().get(i);
+                final Deck deck = new Deck(config.getName());
+                deck.getMain().add("Plains", 20);
+                final RegisteredPlayer rp = ManaBrewEngineAdapter.registeredPlayer(request.getPlayers().size(), variants, deck, null, schemeDecks.get(i));
+                ManaBrewEngineAdapter.configurePlayer(rp, config, request, GameType.Constructed);
+                Archenemy.seat(rp, config, schemeDecks.get(i), archenemyGame, GameType.Constructed);
+                rp.setPlayer(new LobbyPlayerAi(config.getName(), null));
+                registered.add(rp);
+            }
+            game = new Game(registered, rules, new Match(rules, registered, "FirstPlayerTest"));
+            for (int i = 0; i < registered.size(); i++) {
+                game.getPlayers().get(i).initVariantsZones(registered.get(i));
+            }
+        }
+
+        Player firstTurnPlayer() throws Exception {
+            final Method decide = GameAction.class.getDeclaredMethod("determineFirstTurnPlayer", GameOutcome.class);
+            decide.setAccessible(true);
+            return (Player) decide.invoke(game.getAction(), (GameOutcome) null);
+        }
+    }
+}
