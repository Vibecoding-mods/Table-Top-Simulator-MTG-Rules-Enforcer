+import forge.harness.common.SnapshotExtractor;
+import forge.localinstance.properties.ForgePreferences.FPref;
+import forge.model.FModel;
+
+import java.lang.reflect.Method;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Set;
+
+public final class DungeonStateTest {
+    private DungeonStateTest() {}
+
+    public static void main(final String[] args) throws Exception {
+        GuiBase.setInterface(new HeadlessGuiBase("forge/forge-gui/"));
+        FModel.initialize(null, prefs -> {
+            prefs.setPref(FPref.LOAD_CARD_SCRIPTS_LAZILY, true);
+            prefs.setPref(FPref.UI_LANGUAGE, "en-US");
+            return null;
+        });
+
+        check("noDungeonSendsNoStateAndAnEmptyCompletedList", DungeonStateTest::noDungeonSendsNoStateAndAnEmptyCompletedList);
+        check("dungeonStateNamesTheCardAndItsRooms", DungeonStateTest::dungeonStateNamesTheCardAndItsRooms);
+        check("aLastRoomLeadsNowhere", DungeonStateTest::aLastRoomLeadsNowhere);
+        check("aDungeonEnteredWithNoRoomHasAnEmptyRoom", DungeonStateTest::aDungeonEnteredWithNoRoomHasAnEmptyRoom);
+        check("aDungeonSetAtItsLastRoomIsCompleted", DungeonStateTest::aDungeonSetAtItsLastRoomIsCompleted);
+        check("completedDungeonsAreListedByName", DungeonStateTest::completedDungeonsAreListedByName);
+        check("initiativeOpGivesTheInitiativeWithoutVenturing", DungeonStateTest::initiativeOpGivesTheInitiativeWithoutVenturing);
+        check("anUnknownDungeonIsRefused", DungeonStateTest::anUnknownDungeonIsRefused);
+        check("anUnknownRoomIsRefused", DungeonStateTest::anUnknownRoomIsRefused);
+        check("aSecondDungeonIsRefused", DungeonStateTest::aSecondDungeonIsRefused);
+        System.out.println(failed == 0 ? "PASS DungeonStateTest" : "FAIL DungeonStateTest: " + failed + " failed");
+        System.exit(failed == 0 ? 0 : 1);
+    }
+
+    private interface Check {
+        void run() throws Exception;
+    }
+
+    private static int failed;
+
+    private static void check(final String name, final Check check) {
+        try {
+            check.run();
+            System.out.println("ok " + name);
+        } catch (final Throwable failure) {
+            failed++;
+            System.out.println("FAIL " + name + ": " + failure);
+        }
+    }
+
+    private static void noDungeonSendsNoStateAndAnEmptyCompletedList() throws Exception {
+        final Fixture f = new Fixture();
+        final JsonObject white = f.player(0);
+        expect(!white.has("dungeonState"), "a player in no dungeon has a dungeonState: " + white.get("dungeonState"));
+        expect(white.has("completedDungeons") && white.getAsJsonArray("completedDungeons").isEmpty(),
+                "completedDungeons is not an empty list: " + white.get("completedDungeons"));
+    }
+
+    private static void dungeonStateNamesTheCardAndItsRooms() throws Exception {
+        final Fixture f = new Fixture();
+        f.apply("{\"op\":\"dungeon\",\"player\":\"player-0\",\"name\":\"Lost Mine of Phandelver\",\"room\":\"Goblin Lair\"}");
+        expectApplied(f);
+        final JsonObject state = f.player(0).getAsJsonObject("dungeonState");
+        expect(state != null, "no dungeonState after the dungeon op");
+        expect("Lost Mine of Phandelver".equals(state.get("name").getAsString()), "name " + state.get("name"));
+        expect("Goblin Lair".equals(state.get("room").getAsString()), "room " + state.get("room"));
+        final Card dungeon = f.dungeonCard(f.white);
+        expect(SnapshotExtractor.javaCardId(dungeon).equals(state.get("cardId").getAsString()),
+                "cardId " + state.get("cardId") + " is not the command-zone card " + SnapshotExtractor.javaCardId(dungeon));
+        final JsonArray rooms = state.getAsJsonArray("rooms");
+        expect(rooms.size() == 7, "Lost Mine of Phandelver has " + rooms.size() + " rooms, not 7");
+        final JsonObject entrance = rooms.get(0).getAsJsonObject();
+        expect("Cave Entrance".equals(entrance.get("name").getAsString()), "first room " + entrance.get("name"));
+        expect(names(entrance.getAsJsonArray("next")).equals(List.of("Goblin Lair", "Mine Tunnels")),
+                "Cave Entrance leads to " + entrance.get("next"));
+        expect("Scry 1.".equals(entrance.get("text").getAsString()), "Cave Entrance text " + entrance.get("text"));
+        final JsonObject lair = room(rooms, "Goblin Lair");
+        expect(names(lair.getAsJsonArray("next")).equals(List.of("Storeroom", "Dark Pool")),
+                "Goblin Lair leads to " + lair.get("next"));
+    }
+
+    private static void aLastRoomLeadsNowhere() throws Exception {
+        final Fixture f = new Fixture();
+        f.apply("{\"op\":\"dungeon\",\"player\":\"player-0\",\"name\":\"Lost Mine of Phandelver\",\"room\":\"Cave Entrance\"}");
+        expectApplied(f);
+        final JsonObject temple = room(f.player(0).getAsJsonObject("dungeonState").getAsJsonArray("rooms"), "Temple of Dumathoin");
+        expect(temple.getAsJsonArray("next").isEmpty(), "Temple of Dumathoin leads to " + temple.get("next"));
+        expect("Draw a card.".equals(temple.get("text").getAsString()), "Temple of Dumathoin text " + temple.get("text"));
+    }
+
+    private static void aDungeonSetAtItsLastRoomIsCompleted() throws Exception {
+        final Fixture f = new Fixture();
+        f.apply("{\"op\":\"dungeon\",\"player\":\"player-0\",\"name\":\"Lost Mine of Phandelver\",\"room\":\"Temple of Dumathoin\"}");
+        expectApplied(f);
+        final JsonObject white = f.player(0);
+        expect(!white.has("dungeonState") || white.get("dungeonState").isJsonNull(), "dungeon still in progress: " + white.get("dungeonState"));
+        expect(names(white.getAsJsonArray("completedDungeons")).equals(List.of("Lost Mine of Phandelver")),
+                "completedDungeons " + white.get("completedDungeons"));
+    }
+
+    private static void aDungeonEnteredWithNoRoomHasAnEmptyRoom() throws Exception {
+        final Fixture f = new Fixture();
+        f.apply("{\"op\":\"dungeon\",\"player\":\"player-1\",\"name\":\"Tomb of Annihilation\"}");
+        expectApplied(f);
+        final JsonObject state = f.player(1).getAsJsonObject("dungeonState");
+        expect("Tomb of Annihilation".equals(state.get("name").getAsString()), "name " + state.get("name"));
+        expect("".equals(state.get("room").getAsString()), "room " + state.get("room"));
+        expect(f.dungeonCard(f.blue).getZone().is(ZoneType.Command), "the dungeon is not in the command zone");
+    }
+
+    private static void completedDungeonsAreListedByName() throws Exception {
+        final Fixture f = new Fixture();
+        f.apply("{\"op\":\"completedDungeon\",\"player\":\"player-0\",\"name\":\"Tomb of Annihilation\"}");
+        expectApplied(f);
+        expect(names(f.player(0).getAsJsonArray("completedDungeons")).equals(List.of("Tomb of Annihilation")),
+                "completedDungeons " + f.player(0).get("completedDungeons"));
+        expect(f.white.getCompletedDungeons().size() == 1, "Forge's completed list has " + f.white.getCompletedDungeons().size());
+        expect(!f.player(0).has("dungeonState"), "a completed dungeon shows as the current one");
+    }
+
+    private static void initiativeOpGivesTheInitiativeWithoutVenturing() throws Exception {
+        final Fixture f = new Fixture();
+        f.apply("{\"op\":\"initiative\",\"player\":\"player-1\"}");
+        expectApplied(f);
+        expect(f.game.getHasInitiative() == f.blue, "the initiative is with " + f.game.getHasInitiative());
+        expect("player-1".equals(f.view().get("initiativeHolderId").getAsString()), "initiativeHolderId " + f.view().get("initiativeHolderId"));
+        expect(!f.player(1).has("dungeonState"), "taking the initiative by the fix ventured into " + f.player(1).get("dungeonState"));
+    }
+
+    private static void anUnknownDungeonIsRefused() throws Exception {
+        final Fixture f = new Fixture();
+        f.apply("{\"op\":\"dungeon\",\"player\":\"player-0\",\"name\":\"Baldur's Gate Wilderness\"}");
+        expectRefused(f);
+        expect(!f.player(0).has("dungeonState"), "a refused dungeon op left " + f.player(0).get("dungeonState"));
+    }
+
+    private static void anUnknownRoomIsRefused() throws Exception {
+        final Fixture f = new Fixture();
+        f.apply("{\"op\":\"dungeon\",\"player\":\"player-0\",\"name\":\"Lost Mine of Phandelver\",\"room\":\"Yawning Portal\"}");
+        expectRefused(f);
+        expect(!f.player(0).has("dungeonState"), "a refused room left " + f.player(0).get("dungeonState"));
+    }
+
+    private static void aSecondDungeonIsRefused() throws Exception {
+        final Fixture f = new Fixture();
+        f.apply("{\"op\":\"dungeon\",\"player\":\"player-0\",\"name\":\"Lost Mine of Phandelver\",\"room\":\"Cave Entrance\"}");
+        expectApplied(f);
+        f.apply("{\"op\":\"dungeon\",\"player\":\"player-0\",\"name\":\"Tomb of Annihilation\"}");
+        expectRefused(f);
+        expect("Lost Mine of Phandelver".equals(f.player(0).getAsJsonObject("dungeonState").get("name").getAsString()),
+                "the first dungeon was replaced");
+    }
+
+    private static JsonObject room(final JsonArray rooms, final String name) {
+        for (final JsonElement room : rooms) {
+            if (name.equals(room.getAsJsonObject().get("name").getAsString())) {
+                return room.getAsJsonObject();
+            }
+        }
+        throw new AssertionError("no room " + name + " in " + rooms);
+    }
+
+    private static List<String> names(final JsonArray array) {
+        final List<String> names = new ArrayList<>();
+        for (final JsonElement name : array) {
+            names.add(name.getAsString());
+        }
+        return names;
+    }
+
+    private static void expectApplied(final Fixture f) {
+        final JsonObject fix = f.view().getAsJsonObject("stateFix");
+        expect(fix != null && fix.get("applied").getAsBoolean(), "the fix was not applied: " + fix);
+    }
+
+    private static void expectRefused(final Fixture f) {
+        final JsonObject fix = f.view().getAsJsonObject("stateFix");
+        expect(fix != null && !fix.get("applied").getAsBoolean(), "the fix was applied: " + fix);
+    }
+
+    private static void expect(final boolean condition, final String message) {
+        if (!condition) {
+            throw new AssertionError(message);
+        }
+    }
+
+    private static final class Fixture {
+        final ManaBrewInteractiveSession session = new ManaBrewInteractiveSession("dungeon-state-test");
+        final Game game = newGame();
+        final Player white = game.getPlayers().get(0);
+        final Player blue = game.getPlayers().get(1);
+        private int fixId;
+
+        Fixture() {
+            session.attach(game.getMatch(), game, Set.of(), true);
+        }
+
+        void apply(final String op) throws Exception {
+            final JsonObject action = JsonParser.parseString("{\"fixId\":" + (++fixId) + ",\"ops\":[" + op + "]}").getAsJsonObject();
+            final Method apply = ManaBrewInteractiveSession.class.getDeclaredMethod("applyState", JsonObject.class);
+            apply.setAccessible(true);
+            apply.invoke(session, action);
+        }
+
+        JsonObject view() {
+            return JsonParser.parseString(session.getSnapshotJson(0)).getAsJsonObject();
+        }
+
+        JsonObject player(final int index) {
+            for (final JsonElement p : view().getAsJsonArray("players")) {
+                if (("player-" + index).equals(p.getAsJsonObject().get("id").getAsString())) {
+                    return p.getAsJsonObject();
+                }
+            }
+            throw new AssertionError("no player-" + index);
+        }
+
+        Card dungeonCard(final Player player) {
+            for (final Card card : player.getCardsIn(ZoneType.Command)) {
+                if (card.getType().isDungeon()) {
+                    return card;
+                }
+            }
+            throw new AssertionError(player.getName() + " has no dungeon card");
+        }
+
+        private Game newGame() {
+            final List<RegisteredPlayer> players = new ArrayList<>();
+            final Deck deck = new Deck();
+            players.add(new RegisteredPlayer(deck).setPlayer(new ManaBrewInteractiveLobbyPlayer("White", session)));
+            players.add(new RegisteredPlayer(deck).setPlayer(new LobbyPlayerAi("Blue", null)));
+            final GameRules rules = new GameRules(GameType.Constructed);
+            final Game created = new Game(players, rules, new Match(rules, players, "DungeonStateTest"));
+            created.setAge(GameStage.Play);
+            created.getPhaseHandler().devModeSet(PhaseType.MAIN1, created.getPlayers().get(0));
+            created.getPhaseHandler().onStackResolved();
+            return created;
+        }
+    }
+}
