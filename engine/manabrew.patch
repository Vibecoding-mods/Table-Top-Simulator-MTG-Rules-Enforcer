+    private static void withoutPrompts(final Fixture f, final String what, final Runnable step) throws Exception {
+        final Throwable[] failure = new Throwable[1];
+        final Thread runner = new Thread(() -> {
+            try {
+                step.run();
+            } catch (final Throwable thrown) {
+                failure[0] = thrown;
+            }
+        }, what);
+        runner.setDaemon(true);
+        runner.start();
+        runner.join(60_000);
+        if (runner.isAlive()) {
+            throw new AssertionError(what + " asked " + f.session.getLatestPromptJson());
+        }
+        if (failure[0] != null) {
+            throw new AssertionError(what + " failed: " + failure[0], failure[0]);
+        }
+    }
