+    private static Combat combatOf(final Fixture f, final Player active) {
+        f.game.getPhaseHandler().devModeSet(PhaseType.COMBAT_DECLARE_ATTACKERS, active);
+        final Combat combat = new Combat(active);
+        f.game.getPhaseHandler().setCombat(combat);
