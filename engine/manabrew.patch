+    static boolean mayPlayOutsideHand(final Card card, final Player player) {
+        if (!card.mayPlay(player).isEmpty()) {
+            return true;
+        }
+        final Zone zone = card.getZone();
+        if (zone == null || (zone.getPlayer() != null && !zone.getPlayer().equals(player))) {
+            return false;
+        }
+        if (zone.is(ZoneType.Graveyard) && (card.hasKeyword(Keyword.FLASHBACK) || card.hasKeyword(Keyword.RETRACE)
+                || card.hasKeyword(Keyword.JUMP_START) || card.hasKeyword(Keyword.ESCAPE)
+                || card.hasKeyword(Keyword.DISTURB) || card.hasKeyword(Keyword.HARMONIZE)
+                || card.hasKeyword(Keyword.BEAM_ME_UP)
+                || (card.hasKeyword(Keyword.MAYHEM) && card.wasDiscarded() && card.enteredThisTurn()))) {
+            return true;
+        }
+        if (zone.is(ZoneType.Exile) && (card.isForetold() || card.isOnAdventure() || card.isPlotted())) {
+            return true;
+        }
+        for (final SpellAbility sa : card.getSpellAbilities()) {
+            if (zone.is(sa.getRestrictions().getZone())) {
+                return true;
+            }
+        }
+        return false;
+    }
