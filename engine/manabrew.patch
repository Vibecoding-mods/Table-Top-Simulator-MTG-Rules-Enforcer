+            try {
+                check.run();
+            } catch (final Throwable thrown) {
+                failure[0] = thrown;
+            }
+        }, name);
+        runner.setDaemon(true);
+        runner.start();
+        try {
+            runner.join(60_000);
+        } catch (final InterruptedException interrupted) {
+            failure[0] = interrupted;
+        }
+        if (runner.isAlive() && failure[0] == null) {
+            failure[0] = new AssertionError("still running after 60 s");
+        }
+        if (failure[0] == null) {
+            System.out.println("ok " + name);
+        } else {
+            failed++;
+            System.out.println("FAIL " + name + ": " + failure[0]);
+        }
+    }
+
+    private static void controlledAiPriorityGoesToTheController() throws Exception {
