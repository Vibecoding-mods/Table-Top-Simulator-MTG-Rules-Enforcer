+        check("controlledAiPriorityGoesToTheController", MindslaverControlTest::controlledAiPriorityGoesToTheController);
+        check("controlledAiQuestionGoesToTheController", MindslaverControlTest::controlledAiQuestionGoesToTheController);
+        check("controllerSeesTheControlledHand", MindslaverControlTest::controllerSeesTheControlledHand);
+        check("controlEndsAndTheAiDecidesAgain", MindslaverControlTest::controlEndsAndTheAiDecidesAgain);
