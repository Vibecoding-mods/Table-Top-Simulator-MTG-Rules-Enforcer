+    private static final class Fixture {
+        final ManaBrewInteractiveSession session = new ManaBrewInteractiveSession("tie-offer-test");
+        final Game game;
+        final Player white;
+        final Player blue;
+        final Player red;
+        private int turn = 1;
+
+        Fixture(final GameType type) {
+            game = newGame(type);
+            white = game.getPlayers().get(0);
+            blue = game.getPlayers().get(1);
+            red = game.getPlayers().get(2);
+            for (final Player p : List.of(white, blue, red)) {
+                add("Forest", p, ZoneType.Battlefield);
+                add("Island", p, ZoneType.Library);
+                add("Island", p, ZoneType.Library);
+            }
+            session.attach(game.getMatch(), game, Set.of(), true);
+        }
+
+        TieOffer offer() {
+            return new TieOffer(game, false, false);
+        }
+
+        void redLeaves() {
+            red.concede();
+            game.getAction().checkGameOverCondition();
+        }
+
+        java.util.function.IntPredicate humans() {
+            return seat -> seat != 2 && !game.getRegisteredPlayers().get(seat).hasLost();
+        }
+
+        TieOffer declined() {
+            final TieOffer offer = offer();
+            offer.update(humans());
+            expect(offer.vote(1, offer.voteId(), false), "Blue's decline was refused");
+            expect(offer.status() == TieOffer.Status.DECLINED && "declined".equals(statusOf(this)), "after Blue declined: " + offer.status());
+            return offer;
+        }
+
+        void rounds(final TieOffer offer, final int n) {
+            for (int i = 0; i < n; i++) {
+                for (final Player p : new ArrayList<>(game.getPlayers())) {
+                    if (game.isGameOver()) {
+                        return;
+                    }
+                    turn++;
+                    game.getPhaseHandler().devModeSet(PhaseType.MAIN1, p, turn);
+                    offer.update(humans());
+                }
+            }
+        }
+
+        Card put(final String name, final Player p) {
+            final Card card = add(name, p, ZoneType.Battlefield);
+            game.getAction().checkStaticAbilities();
+            return card;
+        }
+
+        Card add(final String name, final Player p, final ZoneType zone) {
+            return TieOfferTest.add(name, p, zone);
+        }
+
+        Card card(final Player p, final ZoneType zone, final String name) {
+            for (final Card c : p.getCardsIn(zone)) {
+                if (c.getName().equals(name)) {
+                    return c;
+                }
+            }
+            throw new AssertionError(p.getName() + " has no " + name + " in " + zone);
+        }
+
+        void priority(final int seat) throws Exception {
+            final Field lock = ManaBrewInteractiveSession.class.getDeclaredField("gameLock");
+            lock.setAccessible(true);
+            final ReentrantLock gameLock = (ReentrantLock) lock.get(session);
+            gameLock.lock();
+            try {
+                session.awaitPriorityAction(seat, List.of(), List.of());
+            } finally {
+                gameLock.unlock();
+            }
+        }
+
+        private Game newGame(final GameType type) {
+            final List<RegisteredPlayer> players = new ArrayList<>();
+            final Deck deck = new Deck();
+            players.add(new RegisteredPlayer(deck).setPlayer(new ManaBrewInteractiveLobbyPlayer("White", session)));
+            players.add(new RegisteredPlayer(deck).setPlayer(new ManaBrewInteractiveLobbyPlayer("Blue", session)));
+            players.add(new RegisteredPlayer(deck).setPlayer(new LobbyPlayerAi("Red", null)));
+            final GameRules rules = new GameRules(type);
+            final Game created = new Game(players, rules, new Match(rules, players, "TieOfferTest"));
+            created.setAge(GameStage.Play);
+            created.getPhaseHandler().devModeSet(PhaseType.MAIN1, created.getPlayers().get(0));
+            created.getPhaseHandler().onStackResolved();
+            return created;
+        }
+    }
+
+    private static Card add(final String name, final Player p, final ZoneType zone) {
+        IPaperCard paper = FModel.getMagicDb().getCommonCards().getCard(name);
+        if (paper == null) {
+            StaticData.instance().attemptToLoadCard(name);
+            paper = FModel.getMagicDb().getCommonCards().getCard(name);
+        }
+        final Card card = Card.fromPaperCard(paper, p);
+        card.setGameTimestamp(p.getGame().getNextTimestamp());
+        p.getZone(zone).add(card);
+        return card;
+    }
+}
