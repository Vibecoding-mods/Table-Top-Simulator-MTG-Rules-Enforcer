+        check("nestedControlGoesToTheTopController", MindslaverControlTest::nestedControlGoesToTheTopController);
+        check("nestedControlStopsBelowAnAiController", MindslaverControlTest::nestedControlStopsBelowAnAiController);
+        check("controlLoopStopsAtTheFirstRepeat", MindslaverControlTest::controlLoopStopsAtTheFirstRepeat);
+        check("aSeatWithNoPlayerKeepsItsId", MindslaverControlTest::aSeatWithNoPlayerKeepsItsId);
