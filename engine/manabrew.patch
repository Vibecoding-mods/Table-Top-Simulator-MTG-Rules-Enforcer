+    private static void asSeat(final Fixture f, final Runnable step) {
+        try {
+            final Field lock = ManaBrewInteractiveSession.class.getDeclaredField("gameLock");
+            lock.setAccessible(true);
+            final ReentrantLock gameLock = (ReentrantLock) lock.get(f.session);
+            gameLock.lock();
+            try {
+                step.run();
+            } finally {
+                gameLock.unlock();
+            }
+        } catch (final ReflectiveOperationException e) {
+            throw new RuntimeException(e);
+        }
+    }
