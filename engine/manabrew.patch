+    private static List<Player> passesUntilResolved(final Fixture f, final Player activator) throws Exception {
+        final List<Player> passes = new ArrayList<>();
+        for (final Player p : f.game.getPlayers()) {
+            p.dangerouslySetController(new PlayerControllerAi(f.game, p, p.getLobbyPlayer()) {
+                @Override
+                public List<SpellAbility> chooseSpellAbilityToPlay() {
+                    passes.add(p);
+                    return null;
+                }
+            });
+        }
+        final Card host = add("Grizzly Bears", activator, ZoneType.Battlefield);
+        final SpellAbility gain = AbilityFactory.getAbility("AB$ GainLife | Cost$ 0 | LifeAmount$ 1 | Defined$ You", host);
+        gain.setActivatingPlayer(activator);
+        withoutPrompts(f, "adding the ability to the stack", () -> f.game.getStack().add(gain));
+        f.game.getPhaseHandler().setPriority(activator);
+        final Field give = PhaseHandler.class.getDeclaredField("givePriorityToPlayer");
+        give.setAccessible(true);
+        give.set(f.game.getPhaseHandler(), true);
+        for (int i = 0; i < 12 && !f.game.getStack().isEmpty(); i++) {
+            withoutPrompts(f, "a priority step", () -> f.game.getPhaseHandler().mainLoopStep());
+        }
+        expect(f.game.getStack().isEmpty(), "the ability never resolved; passes " + passes);
+        return passes;
+    }
