+                public void declareAttackers(final Player attacker, final Combat combat) {
+                    asked.add(p);
+                    for (final Map.Entry<Card, Player> e : attacks.entrySet()) {
+                        if (e.getKey().getController() == p && !combat.isAttacking(e.getKey())) {
+                            combat.addAttacker(e.getKey(), e.getValue());
+                        }
+                    }
+                }
+            });
+        }
+        return asked;
+    }
