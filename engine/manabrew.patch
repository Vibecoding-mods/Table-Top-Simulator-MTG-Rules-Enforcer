+    private static JsonArray hand(final JsonObject view, final int owner) {
+        for (final JsonElement z : view.getAsJsonArray("zones")) {
+            final JsonObject zone = z.getAsJsonObject();
+            if ("hand".equals(zone.get("zone").getAsString()) && ("player-" + owner).equals(zone.get("ownerId").getAsString())) {
+                return zone.getAsJsonArray("cards");
+            }
+        }
+        throw new AssertionError("no hand for player-" + owner);
+    }
+
+    private static List<String> handNames(final JsonObject view, final int owner) {
+        final List<String> names = new ArrayList<>();
+        for (final JsonElement c : hand(view, owner)) {
+            final JsonObject card = c.getAsJsonObject();
+            if (card.has("identity") && card.getAsJsonObject("identity").has("name")) {
+                names.add(card.getAsJsonObject("identity").get("name").getAsString());
+            }
+        }
+        return names;
+    }
