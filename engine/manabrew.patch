+    private static List<SpellAbility> freeLands(final Card card, final Player player) {
+        final List<SpellAbility> lands = new ArrayList<>();
+        for (final SpellAbility sa : card.getAllPossibleAbilities(player, false)) {
+            if (sa.isLandAbility()) {
+                lands.add(sa);
+            }
+        }
+        return lands;
+    }
