+    private static List<SpellAbility> freeAbilities(final Card card) {
+        final List<SpellAbility> abilities = new ArrayList<>();
+        for (final SpellAbility sa : card.getSpellAbilities()) {
+            final ZoneType zone = sa.getRestrictions().getZone();
+            if (sa.isActivatedAbility() && !sa.isManaAbility() && (zone == null || card.isInZone(zone))) {
+                abilities.add(sa);
+            }
+        }
+        return abilities;
+    }
