+    private static Map<Player, Card> tappedLands(final Fixture f) {
+        final Map<Player, Card> lands = new HashMap<>();
+        for (final Player p : f.game.getPlayers()) {
+            final Card land = add("Forest", p, ZoneType.Battlefield);
+            land.setTapped(true);
+            lands.put(p, land);
+        }
+        return lands;
+    }
