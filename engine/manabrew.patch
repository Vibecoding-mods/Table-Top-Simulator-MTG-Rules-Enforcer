+            check.run();
+        } catch (final Throwable failure) {
+            failed++;
+            System.out.println("FAIL " + name + ": " + failure);
+        }
+    }
+
+    private static void optionalExactCountIsAskedAsThatCountWithCancel() throws Exception {
+        final Fixture f = new Fixture();
+        f.answer(f.ids(3));
+        f.forage(true);
+        final JsonObject input = f.promptInput();
+        if (input.get("min").getAsInt() != 3 || input.get("max").getAsInt() != 3) {
+            throw new AssertionError("optional choose-exactly-3 was not asked as 3: " + range(input));
+        }
+        if (!input.has("cancellable") || !input.get("cancellable").getAsBoolean()) {
+            throw new AssertionError("optional choose-exactly-3 offered no way to decline: " + range(input));
+        }
+    }
+
+    private static void optionalExactCountOfTwoIsAskedAsTwoWithCancel() throws Exception {
+        final Fixture f = new Fixture();
+        f.answer(f.ids(2));
+        final CardCollection chosen = f.choose(2, true, false);
+        final JsonObject input = f.promptInput();
+        if (input.get("min").getAsInt() != 2 || !input.has("cancellable") || !input.get("cancellable").getAsBoolean()) {
+            throw new AssertionError("optional choose-exactly-2 was not asked as 2 with a Cancel: " + range(input));
+        }
+        if (chosen == null || chosen.size() != 2) {
+            throw new AssertionError("two cards for an optional choose-exactly-2 were not taken: " + chosen);
+        }
+    }
+
+    private static void optionalExactCountCancelInACancellableCostCancelsThePayment() throws Exception {
+        final Fixture f = new Fixture();
+        f.submit("{\"type\":\"chooseCards\",\"output\":{\"type\":\"cancel\"}}");
+        final CardCollection chosen = f.choose(3, true, true);
+        if (chosen != null) {
+            throw new AssertionError("Cancel on an optional choice in a cancellable cost did not cancel the payment: " + chosen);
+        }
+    }
+
+    private static void mandatoryExactCountIsAskedWithoutCancel() throws Exception {
+        final Fixture f = new Fixture();
+        f.answer(f.ids(3));
+        f.forage(false);
+        final JsonObject input = f.promptInput();
+        if (input.get("min").getAsInt() != 3 || (input.has("cancellable") && input.get("cancellable").getAsBoolean())) {
+            throw new AssertionError("mandatory choose-exactly-3 was not asked as 3 with no Cancel: " + range(input));
+        }
+    }
+
+    private static String range(final JsonObject input) {
+        return "min " + input.get("min") + ", max " + input.get("max") + ", cancellable " + input.get("cancellable");
+    }
+
+    private static void optionalExactCountWithTooFewCardsDeclines() throws Exception {
+        final Fixture f = new Fixture();
+        f.answer(f.ids(1));
+        final CardCollection chosen;
+        try {
+            chosen = f.forage(true);
+        } catch (final IllegalArgumentException aborted) {
+            throw new AssertionError("one card for an optional choose-exactly-3 aborted the game", aborted);
+        }
+        if (chosen == null || !chosen.isEmpty()) {
+            throw new AssertionError("one card for an optional choose-exactly-3 was not a decline: " + chosen);
+        }
+    }
+
+    private static void optionalExactCountCancelDeclines() throws Exception {
+        final Fixture f = new Fixture();
+        f.submit("{\"type\":\"chooseCards\",\"output\":{\"type\":\"cancel\"}}");
+        final CardCollection chosen = f.forage(true);
+        if (chosen == null || !chosen.isEmpty()) {
+            throw new AssertionError("Cancel on an optional choose-exactly-3 was not a decline: " + chosen);
+        }
+    }
+
+    private static void optionalExactCountTakesTheFullCount() throws Exception {
+        final Fixture f = new Fixture();
+        f.answer(f.ids(3));
+        final CardCollection chosen = f.forage(true);
+        if (chosen == null || chosen.size() != 3) {
+            throw new AssertionError("three cards for an optional choose-exactly-3 were not taken: " + chosen);
+        }
+    }
+
+    private static void optionalSingleCardStillAllowsNone() throws Exception {
+        final Fixture f = new Fixture();
+        f.answer(new JsonArray());
+        final CardCollection chosen = f.choose(1, true, false);
+        final JsonObject input = f.promptInput();
+        if (input.get("min").getAsInt() != 0 || input.get("max").getAsInt() != 1) {
+            throw new AssertionError("optional single-card choice changed its range: " + range(input));
+        }
+        if (input.has("cancellable") && input.get("cancellable").getAsBoolean()) {
+            throw new AssertionError("optional single-card choice gained a Cancel: " + range(input));
+        }
+        if (chosen == null || !chosen.isEmpty()) {
+            throw new AssertionError("no card for an optional single-card choice was not a decline: " + chosen);
+        }
+    }
+
+    private static void mandatoryExactCountStillRefusesTooFewCards() throws Exception {
+        final Fixture f = new Fixture();
+        f.answer(f.ids(1));
+        try {
+            f.forage(false);
+        } catch (final IllegalArgumentException expected) {
+            return;
+        }
+        throw new AssertionError("one card for a mandatory choose-exactly-3 was accepted");
+    }
+
+    private static final class Fixture {
+        final Game game = newGame();
+        final Player player = game.getPlayers().get(0);
+        final List<Card> graveyard = new ArrayList<>();
+        final ManaBrewInteractiveSession session = new ManaBrewInteractiveSession("optional-card-choice-test");
+
+        Fixture() throws Exception {
+            graveyard.add(add("Huddle Up", player, ZoneType.Graveyard));
+            for (int i = 0; i < 3; i++) {
+                graveyard.add(add("Island", player, ZoneType.Graveyard));
+            }
+            session.attach(game.getMatch(), game, Set.of(), false);
+            final Field lock = ManaBrewInteractiveSession.class.getDeclaredField("gameLock");
+            lock.setAccessible(true);
+            ((ReentrantLock) lock.get(session)).lock();
+        }
+
+        JsonArray ids(final int count) {
+            final JsonArray ids = new JsonArray();
+            for (int i = 0; i < count; i++) {
+                ids.add(SnapshotExtractor.javaCardId(graveyard.get(i)));
+            }
+            return ids;
+        }
+
+        void answer(final JsonArray ids) {
+            final JsonObject output = new JsonObject();
+            output.addProperty("type", "chooseCardsDecision");
+            output.add("chosenCardIds", ids);
+            final JsonObject action = new JsonObject();
+            action.addProperty("type", "chooseCards");
+            action.add("output", output);
+            submit(action.toString());
+        }
+
+        void submit(final String actionJson) {
+            session.submitAction(actionJson);
+        }
+
+        CardCollection forage(final boolean optional) {
+            return choose(3, optional, false);
+        }
+
+        CardCollection choose(final int count, final boolean optional, final boolean cancellable) {
+            return session.awaitCardChoice(
+                    "choose_cards_for_effect", 0, new CardCollection(graveyard), count, count,
+                    "Treetop Sentries", null, "Choose three cards to exile", optional, null, cancellable);
+        }
+
+        JsonObject promptInput() {
+            return JsonParser.parseString(session.getLatestPromptJson()).getAsJsonObject().getAsJsonObject("input");
+        }
+    }
+
+    private static Game newGame() {
+        final List<RegisteredPlayer> players = new ArrayList<>();
+        final Deck deck = new Deck();
+        players.add(new RegisteredPlayer(deck).setPlayer(new LobbyPlayerAi("p1", null)));
+        players.add(new RegisteredPlayer(deck).setPlayer(new LobbyPlayerAi("p2", null)));
+        final GameRules rules = new GameRules(GameType.Constructed);
+        final Game game = new Game(players, rules, new Match(rules, players, "OptionalCardChoiceTest"));
+        game.setAge(GameStage.Play);
+        game.getPhaseHandler().devModeSet(PhaseType.MAIN1, game.getPlayers().get(0));
+        game.getPhaseHandler().onStackResolved();
+        return game;
+    }
+
+    private static Card add(final String name, final Player p, final ZoneType zone) {
+        IPaperCard paper = FModel.getMagicDb().getCommonCards().getCard(name);
+        if (paper == null) {
+            StaticData.instance().attemptToLoadCard(name);
+            paper = FModel.getMagicDb().getCommonCards().getCard(name);
+        }
+        final Card card = Card.fromPaperCard(paper, p);
+        card.setGameTimestamp(p.getGame().getNextTimestamp());
+        p.getZone(zone).add(card);
+        return card;
+    }
+}
