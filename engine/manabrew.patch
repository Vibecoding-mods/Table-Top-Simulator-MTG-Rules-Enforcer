+    private static boolean matchesColored(final List<Integer> units, final List<ManaCostShard> colored) {
+        final int[] owner = new int[units.size()];
+        java.util.Arrays.fill(owner, -1);
+        for (int shard = 0; shard < colored.size(); shard++) {
+            if (!augment(shard, units, colored, owner, new boolean[units.size()])) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    private static boolean augment(
+            final int shard, final List<Integer> units, final List<ManaCostShard> colored, final int[] owner, final boolean[] seen) {
+        for (int unit = 0; unit < units.size(); unit++) {
+            if (seen[unit] || !paysShard(units.get(unit), colored.get(shard))) {
+                continue;
+            }
+            seen[unit] = true;
+            if (owner[unit] < 0 || augment(owner[unit], units, colored, owner, seen)) {
+                owner[unit] = shard;
+                return true;
+            }
+        }
+        return false;
+    }
