+        }
+        if (!"hidden".equals(f.aiHandVisibility(-1))) {
+            throw new AssertionError("a spectator sees the controlled player's hand");
+        }
+    }
+
+    private static void controlEndsAndTheAiDecidesAgain() throws Exception {
+        final Fixture f = new Fixture();
+        final long ts = f.game.getNextTimestamp();
+        f.ai.addController(ts, f.human);
+        f.ai.removeController(ts);
