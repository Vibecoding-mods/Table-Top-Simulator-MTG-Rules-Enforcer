+    private void applyStateOp(final JsonObject op) {
+        final String kind = op.get("op").getAsString();
+        switch (kind) {
+            case "move": {
+                final Card card = stateCard(op.get("card").getAsString());
+                final ZoneType zone = ZoneType.smartValueOf(op.get("zone").getAsString());
+                final boolean bottom = op.has("position") && "bottom".equals(op.get("position").getAsString());
+                final Card moved = game.getAction().moveTo(zone, card, bottom ? -1 : 0, null, null);
+                if (moved == null || !moved.isInZone(zone)) {
+                    throw new IllegalStateException(card.getName() + " can't move to " + zone);
+                }
+                break;
+            }
+            case "tap":
+                stateCard(op.get("card").getAsString()).setTapped(op.get("tapped").getAsBoolean());
+                break;
+            case "counters":
+                stateCard(op.get("card").getAsString()).setCounters(
+                        CounterType.getType(op.get("kind").getAsString()), op.get("n").getAsInt());
+                break;
+            case "attach": {
+                final Card card = stateCard(op.get("card").getAsString());
+                if (op.has("to") && !op.get("to").isJsonNull()) {
+                    card.attachToEntity(stateCard(op.get("to").getAsString()), null, true);
+                } else if (card.isAttachedToEntity()) {
+                    card.unattachFromEntity(card.getEntityAttachedTo());
+                }
+                break;
+            }
+            case "control": {
+                final Card card = stateCard(op.get("card").getAsString());
+                card.setController(statePlayer(op.get("player").getAsString()), game.getNextTimestamp());
+                game.getAction().controllerChangeZoneCorrection(card);
+                break;
+            }
+            case "faceDown": {
+                final Card card = stateCard(op.get("card").getAsString());
+                if (op.get("value").getAsBoolean()) {
+                    card.turnFaceDown(true);
+                } else {
+                    card.turnFaceUp(false, null);
+                }
+                break;
+            }
+            case "life":
+                statePlayer(op.get("player").getAsString()).setLife(op.get("n").getAsInt(), null);
+                break;
+            case "poison":
+                statePlayer(op.get("player").getAsString()).setPoisonCounters(op.get("n").getAsInt(), null);
+                break;
+            case "commanderDamage": {
+                final Player player = statePlayer(op.get("player").getAsString());
+                final Card commander = stateCard(op.get("from").getAsString());
+                player.addCommanderDamage(commander, op.get("n").getAsInt() - player.getCommanderDamage(commander));
+                break;
+            }
+            case "createToken": {
+                final String script = op.get("script").getAsString();
+                final PaperToken paper = StaticData.instance().getAllTokens().getToken(script);
+                if (paper == null) {
+                    throw new IllegalArgumentException("no token " + script);
+                }
+                final Card token = CardFactory.getCard(paper, statePlayer(op.get("player").getAsString()), game);
+                final Card made = game.getAction().moveToPlay(token, null, null);
+                if (made == null || !made.isInZone(ZoneType.Battlefield)) {
+                    throw new IllegalStateException(script + " can't enter the battlefield");
+                }
+                made.setTapped(op.has("tapped") && op.get("tapped").getAsBoolean());
+                break;
+            }
+            case "mana": {
+                final Card dummy = stateOpHost(statePlayer(op.get("player").getAsString()));
+                final Map<String, String> produced = new HashMap<>();
+                produced.put("Produced", op.get("mana").getAsString());
+                produced.put("PersistentMana", "True");
+                final AbilityManaPart manaPart = new AbilityManaPart(dummy, produced);
+                manaPart.produceMana(null);
+                break;
+            }
+            case "createCard": {
+                final String name = op.get("name").getAsString();
+                final PaperCard paper = StaticData.instance().getCommonCards().getCard(name);
+                final PaperToken token = paper == null ? StaticData.instance().getAllTokens().getToken(name) : null;
+                if (paper == null && token == null) {
+                    throw new IllegalArgumentException("no card named " + name);
+                }
+                final ZoneType zone = ZoneType.smartValueOf(op.get("zone").getAsString());
+                final Player owner = statePlayer(op.get("player").getAsString());
+                final Card card = paper != null ? Card.fromPaperCard(paper, owner) : CardFactory.getCard(token, owner, game);
+                final Card made = zone == ZoneType.Battlefield
+                        ? game.getAction().moveToPlay(card, null, null)
+                        : game.getAction().moveTo(zone, card, null, null);
+                if (made == null || !made.isInZone(zone)) {
+                    throw new IllegalStateException(name + " can't move to " + zone);
+                }
+                if (zone == ZoneType.Battlefield) {
+                    putPrintedCounters(made);
+                }
+                made.setSickness(false);
+                made.setTapped(op.has("tapped") && op.get("tapped").getAsBoolean());
+                break;
+            }
+            default:
+                if (!applyVariantOp(kind, op)) {
+                    throw new IllegalArgumentException("unknown op " + kind);
+                }
+        }
+    }
+
+    private boolean applyVariantOp(final String kind, final JsonObject op) {
+        switch (kind) {
+            case "dungeon":
+                DungeonView.enterDungeon(game, statePlayer(op.get("player").getAsString()),
+                        op.get("name").getAsString(), op.has("room") ? op.get("room").getAsString() : "");
+                return true;
+            case "completedDungeon":
+                DungeonView.completeDungeon(game, statePlayer(op.get("player").getAsString()),
+                        op.get("name").getAsString());
+                return true;
+            case "initiative":
+                game.getAction().takeInitiative(statePlayer(op.get("player").getAsString()), "CLB");
+                return true;
+            default:
+                return false;
+        }
+    }
