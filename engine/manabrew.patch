+    private String freePlayError(final JsonObject op) {
+        final String playerId = op.get("player").getAsString();
+        final Player player = statePlayer(playerId);
+        if (PLANAR_OPS.contains(op.get("op").getAsString())) {
+            return Planechase.opError(game, player, op);
+        }
+        final String cardId = op.get("card").getAsString();
+        final Card card = cardInGame(cardId);
+        if (card == null) {
+            return "no card " + cardId;
+        }
+        if (!(player.getController() instanceof ManaBrewInteractiveController)) {
+            return playerId + " is not a table seat";
+        }
+        final boolean inHand = player.getZone(ZoneType.Hand).contains(card);
+        switch (op.get("op").getAsString()) {
+            case "freeCast":
+                if (!inHand) {
+                    return card.getName() + " is not in " + playerId + "'s hand";
+                }
+                return freeSpells(card, player).isEmpty() ? card.getName() + " has no spell to cast" : null;
+            case "freeLand":
+                if (!inHand) {
+                    return card.getName() + " is not in " + playerId + "'s hand";
+                }
+                return freeLands(card, player).isEmpty() ? card.getName() + " is not a land" : null;
+            default: {
+                if (!inHand && !(card.isInZone(ZoneType.Battlefield) && player.equals(card.getController()))) {
+                    return card.getName() + " is not in " + playerId + "'s hand or on their battlefield";
+                }
+                final List<SpellAbility> abilities = freeAbilities(card);
+                if (abilities.isEmpty()) {
+                    return card.getName() + " has no ability to activate";
+                }
+                if ((op.has("ability") || op.has("abilityId")) && pickedAbility(op, abilities) == null) {
+                    return card.getName() + " has no such ability";
+                }
+                return null;
+            }
+        }
+    }
