+    private static final class Seated {
+        final ManaBrewInteractiveSession session = new ManaBrewInteractiveSession("held-pass-test");
+        final Game game;
+        final Player blue;
+
+        Seated() throws Exception {
+            final List<RegisteredPlayer> players = new ArrayList<>();
+            final Deck deck = new Deck();
+            players.add(new RegisteredPlayer(deck).setPlayer(new ManaBrewInteractiveLobbyPlayer("Blue", session)));
+            players.add(new RegisteredPlayer(deck).setPlayer(new LobbyPlayerAi("Yellow", null)));
+            final GameRules rules = new GameRules(GameType.Constructed);
+            game = new Game(players, rules, new Match(rules, players, "HeldPassResponseTest"));
+            game.setAge(GameStage.Play);
+            blue = game.getPlayers().get(0);
+            game.getPhaseHandler().devModeSet(PhaseType.MAIN1, blue);
+            game.getPhaseHandler().onStackResolved();
+            session.attach(game.getMatch(), game, Set.of(), false);
+            final Field lock = ManaBrewInteractiveSession.class.getDeclaredField("gameLock");
+            lock.setAccessible(true);
+            ((ReentrantLock) lock.get(session)).lock();
+            for (int i = 0; i < 5; i++) {
+                add("Soul Warden", blue, ZoneType.Battlefield);
+            }
+            game.getAction().checkStateEffects(true);
+            game.getAction().moveToPlay(add("Grizzly Bears", blue, ZoneType.Hand), null, null);
+            game.getAction().checkStateEffects(true);
+            game.getStack().addAllTriggeredAbilitiesToStack();
+            expect(game.getStack().size() == 5, "5 Soul Warden triggers expected, got " + game.getStack().size());
+        }
+
+        ManaBrewInteractiveController controller() {
+            return (ManaBrewInteractiveController) blue.getController();
+        }
+
+        void hold() throws Exception {
+            final Field stack = ManaBrewInteractiveController.class.getDeclaredField("exhaustStackIds");
+            stack.setAccessible(true);
+            stack.set(controller(), PriorityFastForward.stackIds(game));
+            final Field probing = ManaBrewInteractiveController.class.getDeclaredField("probingPayability");
+            probing.setAccessible(true);
+            final List<SpellAbility> now;
+            probing.set(controller(), true);
+            try {
+                now = ActionSpace.getPossibleActions(blue, true, true);
+            } finally {
+                probing.set(controller(), false);
+            }
+            final Method ids = ManaBrewInteractiveController.class.getDeclaredMethod("responseIds", List.class);
+            ids.setAccessible(true);
+            final Field held = ManaBrewInteractiveController.class.getDeclaredField("heldActionIds");
+            held.setAccessible(true);
+            held.set(controller(), ids.invoke(null, now));
+        }
+    }
