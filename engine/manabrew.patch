+        game.getStack().addAllTriggeredAbilitiesToStack();
+        expect(PriorityFastForward.exhaustEnded(game, declared), "a new trigger did not end the held pass");
+    }
+
+    private static void pastTheTriggerCapAYesKeepsTheTurnGoing() {
+        Game.setRunawayTriggersPerTurnCap(50);
+        final Game game = aiGame();
+        final List<String> asked = new ArrayList<>();
