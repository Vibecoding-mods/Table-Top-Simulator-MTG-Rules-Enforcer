@@ -0,0 +1,87 @@
+package forge.harness.host;
+
+import com.google.gson.Gson;
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+import forge.harness.protocol.AttackTargetDto;
+import forge.harness.protocol.AttackTargetKind;
+import forge.harness.protocol.AttackerOptionDto;
+import forge.harness.protocol.CardDto;
+
+import java.util.List;
+
+public final class ProtocolDefaultsTest {
+    private ProtocolDefaultsTest() {}
+
+    private static final Gson GSON = new Gson();
+    private static int failed;
+
+    public static void main(final String[] args) {
+        check("offerTieIsNotADirective", () -> {
+            boolean refused = false;
+            try {
+                decode("{\"type\":\"offerTie\"}", 2);
+            } catch (final UnsupportedOperationException e) {
+                refused = true;
+            }
+            expect(refused, "offerTie was decoded");
+        });
+        check("tieVote", () -> {
+            final JsonObject flat = decode("{\"type\":\"tieVote\",\"voteId\":7,\"accept\":true}", 1);
+            expect("tie_vote".equals(kind(flat))
+                    && flat.get("voteId").getAsInt() == 7
+                    && flat.get("accept").getAsBoolean()
+                    && flat.get("player").getAsInt() == 1, "tieVote: " + flat);
+        });
+        check("releaseHold", () -> {
+            final JsonObject flat = decode("{\"type\":\"releaseHold\"}", 0);
+            expect("release_hold".equals(kind(flat)), "releaseHold: " + flat);
+        });
+        check("attackerWithoutDamageKeepsItsWire", () -> {
+            final JsonObject obj = GSON.toJsonTree(
+                    new AttackerOptionDto("card-1", List.of("player-1"), false, List.of(), null)).getAsJsonObject();
+            expect(!obj.has("damage") && obj.has("costs"), "attacker: " + obj);
+        });
+        check("attackTargetWithoutTaxDataKeepsItsWire", () -> {
+            final JsonObject obj = GSON.toJsonTree(new AttackTargetDto(
+                    "player-1", "Blue", AttackTargetKind.PLAYER, null, null, null, null)).getAsJsonObject();
+            expect(obj.keySet().equals(java.util.Set.of("id", "label", "kind")), "target: " + obj);
+        });
+        check("cardIsBoundedByDefault", () -> {
+            final CardDto dto = new CardDto();
+            expect(!dto.unbounded, "a new card is unbounded");
+        });
+        System.out.println(failed == 0 ? "PASS ProtocolDefaultsTest" : "FAIL ProtocolDefaultsTest: " + failed + " failed");
+        System.exit(failed == 0 ? 0 : 1);
+    }
+
+    private static JsonObject decode(final String directive, final int player) {
+        final JsonObject canonical = JsonParser.parseString(
+                "{\"type\":\"directive\",\"player\":" + player + ",\"directive\":" + directive + "}").getAsJsonObject();
+        return ManabrewProtocolAdapter.decodeAction(canonical);
+    }
+
+    private static String kind(final JsonObject flat) {
+        return flat.has("kind") ? flat.get("kind").getAsString() : "";
+    }
+
+    private interface Check {
+        void run();
+    }
+
+    private static void check(final String name, final Check body) {
+        try {
+            body.run();
+            System.out.println("ok " + name);
+        } catch (RuntimeException | AssertionError error) {
+            failed++;
+            System.out.println("FAIL " + name + ": " + error.getMessage());
+        }
+    }
+
+    private static void expect(final boolean condition, final String message) {
+        if (!condition) {
+            throw new AssertionError(message);
+        }
+    }
+}
