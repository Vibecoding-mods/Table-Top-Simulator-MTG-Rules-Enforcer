+    private static final class WaitingGame implements AutoCloseable {
+        private final Fixture f;
+        private final ReentrantLock lock;
+        private final BlockingQueue<JsonObject> actions;
+        private final Field round;
+        private final Semaphore waiting = new Semaphore(0);
+        private final Thread thread;
+        private volatile Runnable step;
+        private volatile Throwable failure;
+
+        @SuppressWarnings("unchecked")
+        WaitingGame(final Fixture f) throws Exception {
+            this.f = f;
+            lock = (ReentrantLock) field("gameLock").get(f.session);
+            actions = (BlockingQueue<JsonObject>) field("actions").get(f.session);
+            round = field("snapshotRound");
+            final Method poll = ManaBrewInteractiveSession.class.getDeclaredMethod("pollAction");
+            poll.setAccessible(true);
+            thread = new Thread(() -> {
+                lock.lock();
+                try {
+                    while (true) {
+                        waiting.release();
+                        JsonObject action;
+                        do {
+                            action = (JsonObject) poll.invoke(f.session);
+                        } while (action == null);
+                        if ("stop".equals(action.get("kind").getAsString())) {
+                            return;
+                        }
+                        step.run();
+                    }
+                } catch (final Throwable thrown) {
+                    failure = thrown;
+                    waiting.release();
+                } finally {
+                    lock.unlock();
+                }
+            }, "waiting game");
+            thread.setDaemon(true);
+            thread.start();
+            await();
+        }
+
+        InteractiveSnapshotExtractor.SnapshotRound round() throws Exception {
+            lock.lock();
+            try {
+                return (InteractiveSnapshotExtractor.SnapshotRound) round.get(f.session);
+            } finally {
+                lock.unlock();
+            }
+        }
+
+        void step(final Runnable change) throws Exception {
+            step = change;
+            offer("step");
+            await();
+        }
+
+        private void offer(final String kind) {
+            final JsonObject action = new JsonObject();
+            action.addProperty("kind", kind);
+            actions.offer(action);
+        }
+
+        private void await() throws Exception {
+            expect(waiting.tryAcquire(30, TimeUnit.SECONDS), "the game never waited for an action");
+            if (failure != null) {
+                throw new AssertionError("the game thread failed", failure);
+            }
+        }
+
+        @Override
+        public void close() throws Exception {
+            offer("stop");
+            thread.join(10_000);
+        }
+
+        private static Field field(final String name) throws NoSuchFieldException {
+            final Field field = ManaBrewInteractiveSession.class.getDeclaredField(name);
+            field.setAccessible(true);
+            return field;
+        }
+    }
+
+    private static boolean flag(final JsonObject card, final String name) {
+        return card != null && card.has(name) && card.get(name).getAsBoolean();
+    }
+
+    private static String text(final JsonObject card, final String name) {
+        return card != null && card.has(name) ? card.get(name).getAsString() : null;
+    }
+
+    private static List<String> ids(final JsonObject card, final String name) {
+        final List<String> out = new ArrayList<>();
+        if (card != null && card.has(name)) {
+            final JsonArray array = card.getAsJsonArray(name);
+            for (final JsonElement element : array) {
+                out.add(element.getAsString());
+            }
+        }
+        return out;
+    }
+
+    private static void expect(final boolean condition, final String message) {
+        if (!condition) {
+            throw new AssertionError(message);
+        }
+    }
+
+    private static final class Fixture {
+        final Game game = newGame();
+        final Player p0 = game.getPlayers().get(0);
+        final Player p1 = game.getPlayers().get(1);
+        final ManaBrewInteractiveSession session = new ManaBrewInteractiveSession("card-state-flags-test");
+
+        Fixture() {
+            session.attach(game.getMatch(), game, Set.of(), false);
+        }
+
+        Card add(final String name, final Player p) {
+            IPaperCard paper = FModel.getMagicDb().getCommonCards().getCard(name);
+            if (paper == null) {
+                StaticData.instance().attemptToLoadCard(name);
+                paper = FModel.getMagicDb().getCommonCards().getCard(name);
+            }
+            if (paper == null) {
+                throw new AssertionError("no card named " + name);
+            }
+            final Card card = Card.fromPaperCard(paper, p);
+            card.setGameTimestamp(game.getNextTimestamp());
+            p.getZone(ZoneType.Battlefield).add(card);
+            return card;
+        }
+
+        void settle() {
+            game.getAction().checkStaticAbilities();
+        }
+
+        void untapStep(final Player active) {
+            game.getPhaseHandler().devModeSet(PhaseType.UNTAP, active);
+            game.getUntap().executeAt();
+        }
+
+        String snapshot(final int viewer) {
+            return session.getSnapshotJson(viewer);
+        }
+
+        JsonObject card(final Card card) {
+            return card(card, 0);
+        }
+
+        JsonObject card(final Card card, final int viewer) {
+            final JsonObject view = JsonParser.parseString(session.getSnapshotJson(viewer)).getAsJsonObject();
+            final String id = SnapshotExtractor.javaCardId(card);
+            for (final JsonElement z : view.getAsJsonArray("zones")) {
+                final JsonObject zo = z.getAsJsonObject();
+                if (!"battlefield".equals(zo.get("zone").getAsString())) {
+                    continue;
+                }
+                for (final JsonElement c : zo.getAsJsonArray("cards")) {
+                    if (id.equals(c.getAsJsonObject().get("id").getAsString())) {
+                        return c.getAsJsonObject();
+                    }
+                }
+            }
+            throw new AssertionError("card not on the battlefield in the snapshot: " + card);
+        }
+    }
+
+    private static Game newGame() {
+        final List<RegisteredPlayer> players = new ArrayList<>();
+        final Deck deck = new Deck();
+        players.add(new RegisteredPlayer(deck).setPlayer(new LobbyPlayerAi("p1", null)));
+        players.add(new RegisteredPlayer(deck).setPlayer(new LobbyPlayerAi("p2", null)));
+        final GameRules rules = new GameRules(GameType.Constructed);
+        final Game game = new Game(players, rules, new Match(rules, players, "CardStateFlagsTest"));
+        game.setAge(GameStage.Play);
+        game.getPhaseHandler().devModeSet(PhaseType.MAIN1, game.getPlayers().get(0));
+        game.getPhaseHandler().onStackResolved();
+        return game;
+    }
