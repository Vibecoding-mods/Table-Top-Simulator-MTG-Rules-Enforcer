+
+        void concede(final int seat) throws Exception {
+            final Method concede = ManaBrewInteractiveSession.class.getDeclaredMethod("concedePlayer", int.class);
+            concede.setAccessible(true);
+            concede.invoke(session, seat);
+        }
+
+        String status(final int seat) {
+            final JsonObject view = JsonParser.parseString(session.getSnapshotJson(0)).getAsJsonObject();
+            for (final JsonElement player : view.getAsJsonArray("players")) {
+                final JsonObject p = player.getAsJsonObject();
