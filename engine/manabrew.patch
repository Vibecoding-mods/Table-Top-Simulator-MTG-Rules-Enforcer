+    private static List<List<Player>> recordTriggerOrders(final Fixture f) {
+        final List<List<Player>> calls = new ArrayList<>();
+        for (final Player p : f.game.getPlayers()) {
+            p.dangerouslySetController(new PlayerControllerAi(f.game, p, p.getLobbyPlayer()) {
+                @Override
+                public void orderAndPlaySimultaneousSa(final List<SpellAbility> activePlayerSAs) {
+                    final List<Player> call = new ArrayList<>();
+                    call.add(p);
+                    for (final SpellAbility sa : activePlayerSAs) {
+                        call.add(sa.getHostCard().getController());
+                    }
+                    calls.add(call);
+                    super.orderAndPlaySimultaneousSa(activePlayerSAs);
+                }
+            });
+        }
+        return calls;
+    }
