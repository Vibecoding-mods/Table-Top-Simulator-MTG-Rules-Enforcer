+import java.util.ArrayList;
+import java.util.List;
+import java.util.Set;
+import java.util.concurrent.locks.ReentrantLock;
+
+public final class HeldPassResponseTest {
+    private HeldPassResponseTest() {}
+
+    public static void main(final String[] args) throws Exception {
+        GuiBase.setInterface(new HeadlessGuiBase("forge/forge-gui/"));
+        FModel.initialize(null, prefs -> {
+            prefs.setPref(FPref.LOAD_CARD_SCRIPTS_LAZILY, true);
+            prefs.setPref(FPref.UI_LANGUAGE, "en-US");
+            return null;
+        });
+        check("nothingNewKeepsTheHold", HeldPassResponseTest::nothingNewKeepsTheHold);
+        check("aNewInstantEndsTheHold", HeldPassResponseTest::aNewInstantEndsTheHold);
+        check("aHeldInstantKeepsTheHold", HeldPassResponseTest::aHeldInstantKeepsTheHold);
+        check("aNewManaAbilityKeepsTheHold", HeldPassResponseTest::aNewManaAbilityKeepsTheHold);
+        check("aLostActionKeepsTheHold", HeldPassResponseTest::aLostActionKeepsTheHold);
+        check("clearingTheHoldForgetsTheActions", HeldPassResponseTest::clearingTheHoldForgetsTheActions);
+        System.out.println(failed == 0 ? "PASS HeldPassResponseTest" : "FAIL HeldPassResponseTest: " + failed + " failed");
+        System.exit(failed == 0 ? 0 : 1);
+    }
+
+    private interface Check {
+        void run() throws Exception;
+    }
+
+    private static int failed;
+
+    private static void check(final String name, final Check check) {
+        try {
+            check.run();
+            System.out.println("ok " + name);
+        } catch (final Throwable failure) {
+            failed++;
+            System.out.println("FAIL " + name + ": " + failure);
+        }
+    }
+
+    private static void nothingNewKeepsTheHold() throws Exception {
+        final Seated f = new Seated();
+        f.hold();
+        expect(f.controller().heldResolutionsLeft() > 0, "a hold with nothing new ended");
+    }
+
+    private static void aNewInstantEndsTheHold() throws Exception {
+        final Seated f = new Seated();
+        add("Mountain", f.blue, ZoneType.Battlefield);
+        f.hold();
+        expect(f.controller().heldResolutionsLeft() > 0, "the hold ended before the instant");
+        add("Lightning Bolt", f.blue, ZoneType.Hand);
+        expect(f.controller().heldResolutionsLeft() == 0, "a new instant did not end the hold");
+        expect(held(f.controller()) != null, "asking ended the hold instead of the next priority");
+    }
+
+    private static void aHeldInstantKeepsTheHold() throws Exception {
+        final Seated f = new Seated();
+        add("Mountain", f.blue, ZoneType.Battlefield);
+        add("Lightning Bolt", f.blue, ZoneType.Hand);
+        f.hold();
+        expect(f.controller().heldResolutionsLeft() > 0, "an instant held from the start ended the hold");
+    }
+
+    private static void aNewManaAbilityKeepsTheHold() throws Exception {
+        final Seated f = new Seated();
+        f.hold();
+        add("Mountain", f.blue, ZoneType.Battlefield);
+        expect(f.controller().heldResolutionsLeft() > 0, "a new land's mana ability ended the hold");
+    }
+
+    private static void aLostActionKeepsTheHold() throws Exception {
+        final Seated f = new Seated();
+        add("Mountain", f.blue, ZoneType.Battlefield);
+        final Card bolt = add("Lightning Bolt", f.blue, ZoneType.Hand);
+        f.hold();
+        f.blue.getZone(ZoneType.Hand).remove(bolt);
+        expect(f.controller().heldResolutionsLeft() > 0, "losing an action ended the hold");
+    }
+
+    private static void clearingTheHoldForgetsTheActions() throws Exception {
+        final Seated f = new Seated();
+        f.hold();
+        f.controller().clearHeldPass();
+        expect(held(f.controller()) == null && f.controller().heldResolutionsLeft() == 0, "the cleared hold kept its actions");
