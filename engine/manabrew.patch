+
+        check("aLandsOnlyDeckIsPassive", PassiveAiTest::aLandsOnlyDeckIsPassive);
+        check("aDeckWithASpellIsNotPassive", PassiveAiTest::aDeckWithASpellIsNotPassive);
+        check("anEmptyDeckIsNotPassive", PassiveAiTest::anEmptyDeckIsNotPassive);
+        check("theAiCastsWhatThePassiveAiHolds", PassiveAiTest::theAiCastsWhatThePassiveAiHolds);
+        check("thePassiveAiCastsNothing", PassiveAiTest::thePassiveAiCastsNothing);
+        check("thePassiveAiStillPlaysItsLand", PassiveAiTest::thePassiveAiStillPlaysItsLand);
+        check("thePassiveAiCastsNothingOnceItsLandIsPlayed", PassiveAiTest::thePassiveAiCastsNothingOnceItsLandIsPlayed);
+        check("theAiCountersTheOtherPlayersSpell", PassiveAiTest::theAiCountersTheOtherPlayersSpell);
+        check("thePassiveAiLetsTheOtherPlayersSpellResolve", PassiveAiTest::thePassiveAiLetsTheOtherPlayersSpellResolve);
+        check("thePassiveAiPlaysACyclingLandOnlyAsALand", PassiveAiTest::thePassiveAiPlaysACyclingLandOnlyAsALand);
+        check("theAiStartsWithItsLeyline", PassiveAiTest::theAiStartsWithItsLeyline);
