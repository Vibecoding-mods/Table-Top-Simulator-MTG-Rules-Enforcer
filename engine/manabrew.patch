+                start[i] = game.getPlayers().get(i).getZone(ZoneType.Hand).size();
+            }
+        }
+
+        String hands() {
+            final StringBuilder sb = new StringBuilder();
+            for (int i = 0; i < 4; i++) {
+                final Player p = game.getPlayers().get(i);
+                sb.append(i == 0 ? "" : " ").append(p.getZone(ZoneType.Hand).size() - start[i]);
+            }
+            return sb.toString();
+        }
+
+        void step() throws Exception {
+            final Throwable[] failure = new Throwable[1];
+            final Thread runner = new Thread(() -> {
+                try {
+                    ph.mainLoopStep();
+                } catch (final Throwable thrown) {
+                    failure[0] = thrown;
+                }
+            });
+            runner.setDaemon(true);
+            runner.start();
+            runner.join(30_000);
+            if (runner.isAlive()) {
+                throw new AssertionError("a step hung at " + ph.debugPrintState(true));
+            }
+            if (failure[0] != null) {
+                throw new AssertionError("a step failed", failure[0]);
+            }
+        }
+
+        void runUntil(final BooleanSupplier done) throws Exception {
+            for (int i = 0; i < 400; i++) {
+                if (done.getAsBoolean()) {
+                    return;
+                }
+                step();
+            }
+            throw new AssertionError("never got there, at " + ph.debugPrintState(true));
+        }
+    }
+}
