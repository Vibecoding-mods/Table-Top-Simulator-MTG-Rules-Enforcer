+        check("planeswalkOpMovesTheNamedPlane", PlanechaseTest::planeswalkOpMovesTheNamedPlane);
+        check("planeswalkOpToAPlaneInNoDeckIsRefused", PlanechaseTest::planeswalkOpToAPlaneInNoDeckIsRefused);
+        check("planarOpsAreRefusedOutsidePlanechase", PlanechaseTest::planarOpsAreRefusedOutsidePlanechase);
