+    private static void startingTeamSkipsOnlyTurnOnesDraw() throws Exception {
+        final Fixture f = new Fixture(true);
+        f.game.setStartingPlayer(f.white);
+        expect(skipsDraw(f, f.white, 1), "the starting team draws on turn 1");
+        expect(!skipsDraw(f, f.yellow, 2), "the second team skips its draw on turn 2");
+        expect(!skipsDraw(f, f.white, 3), "the starting team skips its draw on turn 3");
+        f.game.getPhaseHandler().devModeSet(PhaseType.UNTAP, f.white, 0);
+        f.game.getPhaseHandler().devModeSet(PhaseType.UPKEEP, f.white, 1);
+        final Map<Player, Integer> before = handSizes(f);
+        stepTo(f, PhaseType.MAIN1);
+        final Map<Player, Integer> drawn = handGrowth(f, before);
+        expect(drawn.get(f.white) == 0 && drawn.get(f.red) == 0, "the starting team drew on turn 1: " + names(drawn));
+        final Fixture l1 = new Fixture(false);
+        l1.game.setStartingPlayer(l1.white);
+        expect(skipsDraw(l1, l1.red, 2), "level 1: Red's first turn, turn 2, draws");
+    }
+
+    private static boolean skipsDraw(final Fixture f, final Player p, final int turn) throws Exception {
+        f.game.getPhaseHandler().devModeSet(PhaseType.UPKEEP, p, turn);
+        final Method skip = PhaseHandler.class.getDeclaredMethod("isSkippingPhase", PhaseType.class);
+        skip.setAccessible(true);
+        return (Boolean) skip.invoke(f.game.getPhaseHandler(), PhaseType.DRAW);
+    }
