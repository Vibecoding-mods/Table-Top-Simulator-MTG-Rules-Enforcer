+    private static void oneScanPerRound() throws Exception {
+        final Fixture f = new Fixture();
+        f.tokens(1000);
+        f.add("Moat", f.p1);
+        f.add("Wall of Wood", f.p2);
+        final InteractiveSnapshotExtractor.SnapshotRound round = new InteractiveSnapshotExtractor.SnapshotRound();
+        for (final Card c : f.creatures()) {
+            f.flags(round, c);
+        }
+        expect(round.computedFlags() == f.creatures().size(), "flags computed " + round.computedFlags() + " times for " + f.creatures().size() + " creatures");
+        expect(round.staticScans() == 1, "the statics were scanned " + round.staticScans() + " times in one round");
+    }
+
+    private static void thousandTokensTiming() throws Exception {
+        final Fixture f = new Fixture();
+        f.tokens(1000);
+        f.add("Moat", f.p1);
+        f.add("Ensnaring Bridge", f.p2);
+        f.add("Wall of Wood", f.p2);
+        final List<Card> creatures = f.creatures();
+        for (int warm = 0; warm < 2; warm++) {
+            f.forgeFlags(creatures);
+            f.newFlags(creatures);
+        }
+        long forge = Long.MAX_VALUE;
+        long fast = Long.MAX_VALUE;
+        for (int run = 0; run < 3; run++) {
+            long t = System.nanoTime();
+            f.forgeFlags(creatures);
+            forge = Math.min(forge, System.nanoTime() - t);
+            t = System.nanoTime();
+            f.newFlags(creatures);
+            fast = Math.min(fast, System.nanoTime() - t);
+        }
+        long t = System.nanoTime();
+        f.session.getSnapshotJson(0);
+        final long snapshot = System.nanoTime() - t;
+        System.out.println("timing: " + creatures.size() + " creatures: Forge's per-creature scans " + forge / 1_000_000 + " ms, cached "
+                + fast / 1_000_000 + " ms, one whole snapshot " + snapshot / 1_000_000 + " ms");
+        expect(fast * 3 < forge, "the cached flags took " + fast / 1_000_000 + " ms against Forge's " + forge / 1_000_000 + " ms");
+    }
+
+    private static void flagsGrowLinearly() throws Exception {
+        final long small = flagsTime(1000);
+        final long big = flagsTime(3000);
+        System.out.println("timing: cached flags for 1,000 creatures " + small / 1_000_000 + " ms, for 3,000 " + big / 1_000_000 + " ms");
+        expect(big < small * 7, "3,000 creatures took " + big / 1_000_000 + " ms against " + small / 1_000_000 + " ms for 1,000");
+    }
+
+    private static long flagsTime(final int n) throws Exception {
+        final Fixture f = new Fixture();
+        f.tokens(n);
+        f.add("Moat", f.p1);
+        f.add("Ensnaring Bridge", f.p2);
+        f.add("Wall of Wood", f.p2);
+        final List<Card> creatures = f.creatures();
+        long best = Long.MAX_VALUE;
+        for (int run = 0; run < 5; run++) {
+            final long t = System.nanoTime();
+            f.newFlags(creatures);
+            best = Math.min(best, System.nanoTime() - t);
+        }
+        return best;
+    }
+
+    private static final class Fixture {
+        final ManaBrewInteractiveSession session = new ManaBrewInteractiveSession("snapshot-speed-test");
+        final Game game = newGame();
+        final Player p0 = game.getPlayers().get(0);
+        final Player p1 = game.getPlayers().get(1);
+        final Player p2 = game.getPlayers().get(2);
+
+        Fixture() {
+            session.attach(game.getMatch(), game, Set.of(), false);
+        }
+
+        Card add(final String name, final Player p) {
+            final Card card = card(name, p);
+            p.getZone(ZoneType.Battlefield).add(card);
+            settle();
+            return card;
+        }
+
+        void attach(final String name, final Player p, final Card to) {
+            final Card aura = add(name, p);
+            aura.attachToEntity(to, null, true);
+            settle();
+        }
+
+        void hand(final Player p, final int cards) {
+            for (final Card c : new ArrayList<>(p.getCardsIn(ZoneType.Hand))) {
+                p.getZone(ZoneType.Hand).remove(c);
+            }
+            for (int i = 0; i < cards; i++) {
+                p.getZone(ZoneType.Hand).add(card("Forest", p));
+            }
+            settle();
+        }
+
+        void tokens(final int n) {
+            final Player[] owners = {p0, p1, p2};
+            for (int i = 0; i < n; i++) {
+                final Card token = card("Grizzly Bears", owners[i % 3]);
+                token.setGamePieceType(GamePieceType.TOKEN);
+                owners[i % 3].getZone(ZoneType.Battlefield).add(token);
+            }
+            settle();
+        }
+
+        Card card(final String name, final Player p) {
+            IPaperCard paper = FModel.getMagicDb().getCommonCards().getCard(name);
+            if (paper == null) {
+                StaticData.instance().attemptToLoadCard(name);
+                paper = FModel.getMagicDb().getCommonCards().getCard(name);
+            }
+            if (paper == null) {
+                throw new AssertionError("no card named " + name);
+            }
+            final Card card = Card.fromPaperCard(paper, p);
+            card.setGameTimestamp(game.getNextTimestamp());
+            return card;
+        }
+
+        void settle() {
+            game.getAction().checkStaticAbilities();
+        }
+
+        List<Card> creatures() {
+            final List<Card> out = new ArrayList<>();
+            for (final Card c : game.getCardsIn(ZoneType.Battlefield)) {
+                if (c.isCreature() && !c.isPhasedOut()) {
+                    out.add(c);
+                }
+            }
+            return out;
+        }
+
+        boolean[] forge(final Card c) {
+            final boolean cantBlock = !CombatUtil.canBlock(c, true);
+            final FCollectionView<GameEntity> defenders = CombatUtil.getAllPossibleDefenders(c.getController());
+            boolean cantAttack = !defenders.isEmpty();
+            for (final GameEntity d : defenders) {
+                if (CombatUtil.canAttackNextTurn(c, d)) {
+                    cantAttack = false;
+                    break;
+                }
+            }
+            final boolean mustAttack = !StaticAbilityMustAttack.entitiesMustAttack(c).isEmpty();
+            return new boolean[] {cantBlock, cantAttack, mustAttack};
+        }
+
+        void forgeFlags(final List<Card> cards) {
+            for (final Card c : cards) {
+                forge(c);
+            }
+        }
+
+        void newFlags(final List<Card> cards) throws Exception {
+            final InteractiveSnapshotExtractor.SnapshotRound round = new InteractiveSnapshotExtractor.SnapshotRound();
+            for (final Card c : cards) {
+                flags(round, c);
+            }
+        }
+
+        Object flags(final InteractiveSnapshotExtractor.SnapshotRound round, final Card c) throws Exception {
+            final Method flags = InteractiveSnapshotExtractor.SnapshotRound.class.getDeclaredMethod("flags", Card.class);
+            flags.setAccessible(true);
+            return flags.invoke(round, c);
+        }
+
+        Map<String, Integer> compareEverywhere() {
+            final Map<String, Integer> seen = new LinkedHashMap<>();
+            for (final String k : List.of("cantAttack", "canAttack", "cantBlock", "mustAttack")) {
+                seen.put(k, 0);
+            }
+            for (final Player active : List.of(p0, p1, p2)) {
+                game.getPhaseHandler().devModeSet(PhaseType.MAIN1, active);
+                settle();
+                for (int viewer = 0; viewer < 3; viewer++) {
+                    final JsonObject view = JsonParser.parseString(session.getSnapshotJson(viewer)).getAsJsonObject();
+                    for (final Card c : creatures()) {
+                        final boolean[] want = forge(c);
+                        final JsonObject dto = cardIn(view, c);
+                        final boolean[] got = {flag(dto, "cantBlock"), flag(dto, "cantAttack"), flag(dto, "mustAttack")};
+                        expect(want[0] == got[0] && want[1] == got[1] && want[2] == got[2],
+                                c + " (" + c.getController().getName() + ", " + active.getName() + "'s turn, viewer " + viewer
+                                        + "): Forge says cantBlock " + want[0] + " cantAttack " + want[1] + " mustAttack " + want[2]
+                                        + ", the snapshot " + got[0] + " " + got[1] + " " + got[2]);
+                        seen.merge(want[1] ? "cantAttack" : "canAttack", 1, Integer::sum);
+                        if (want[0]) {
+                            seen.merge("cantBlock", 1, Integer::sum);
+                        }
+                        if (want[2]) {
+                            seen.merge("mustAttack", 1, Integer::sum);
+                        }
+                    }
+                }
+            }
+            return seen;
+        }
+
+        private JsonObject cardIn(final JsonObject view, final Card card) {
+            final String id = SnapshotExtractor.javaCardId(card);
+            for (final JsonElement z : view.getAsJsonArray("zones")) {
+                final JsonObject zo = z.getAsJsonObject();
+                if (!"battlefield".equals(zo.get("zone").getAsString())) {
+                    continue;
+                }
+                for (final JsonElement c : zo.getAsJsonArray("cards")) {
+                    if (id.equals(c.getAsJsonObject().get("id").getAsString())) {
+                        return c.getAsJsonObject();
+                    }
+                }
+            }
+            throw new AssertionError("not on the battlefield in the snapshot: " + card);
+        }
+
+        private Game newGame() {
+            final List<RegisteredPlayer> players = new ArrayList<>();
+            final Deck deck = new Deck();
+            players.add(new RegisteredPlayer(deck).setPlayer(new LobbyPlayerAi("White", null)));
+            players.add(new RegisteredPlayer(deck).setPlayer(new LobbyPlayerAi("Blue", null)));
+            players.add(new RegisteredPlayer(deck).setPlayer(new LobbyPlayerAi("Red", null)));
+            final GameRules rules = new GameRules(GameType.Constructed);
+            final Game created = new Game(players, rules, new Match(rules, players, "SnapshotSpeedTest"));
+            created.setAge(GameStage.Play);
+            created.getPhaseHandler().devModeSet(PhaseType.MAIN1, created.getPlayers().get(0));
+            created.getPhaseHandler().onStackResolved();
+            return created;
+        }
+    }
+
+    private static boolean flag(final JsonObject card, final String name) {
+        return card != null && card.has(name) && card.get(name).getAsBoolean();
+    }
+}
