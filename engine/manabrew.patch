+
+import java.util.ArrayList;
+import java.util.List;
+
+final class Perks {
+    static final String DEFAULT_NAME = "Perks";
+
+    private Perks() {}
+
+    static void check(final List<String> lines) {
+        for (final String line : lines) {
+            if (line == null || kind(line) == null) {
+                throw new IllegalArgumentException("unknown perk line: " + line);
+            }
+        }
+    }
+
+    static void addAll(final Game game, final List<ManaBrewEngineAdapter.PlayerConfig> configs) {
+        for (int i = 0; i < configs.size(); i++) {
+            if (!configs.get(i).getPerks().isEmpty()) {
+                add(game.getPlayers().get(i), configs.get(i).getPerks());
+            }
+        }
+    }
+
+    static Card add(final Player owner, final List<String> lines) {
+        check(lines);
+        final Game game = owner.getGame();
+        final Card card = new Card(game.nextCardId(), game);
+        card.setOwner(owner);
+        card.setName(DEFAULT_NAME);
+        card.setGamePieceType(GamePieceType.EFFECT);
+        card.setGameTimestamp(game.getNextTimestamp());
+        final List<String> abilities = new ArrayList<>();
+        for (final String line : lines) {
+            final String kind = kind(line);
+            final String rest = line.substring(kind.length()).trim();
+            switch (kind) {
+                case "Name:":
+                    card.setName(rest);
+                    break;
+                case "Oracle:":
+                    card.setOracleText(rest);
+                    break;
+                case "SVar:":
+                    final int colon = rest.indexOf(':');
+                    if (colon < 1) {
+                        throw new IllegalArgumentException("perk SVar without a name: " + line);
+                    }
+                    card.setSVar(rest.substring(0, colon), rest.substring(colon + 1));
+                    break;
+                default:
+                    abilities.add(line);
+            }
+        }
+        for (final String line : abilities) {
+            final String kind = kind(line);
+            final String rest = line.substring(kind.length()).trim();
+            switch (kind) {
+                case "T:":
+                    card.addTrigger(TriggerHandler.parseTrigger(rest, card, true));
+                    break;
+                case "S:":
+                    card.addStaticAbility(StaticAbility.create(rest, card, card.getCurrentState(), true));
+                    break;
+                default:
+                    card.addReplacementEffect(ReplacementHandler.parseReplacement(rest, card, true));
+            }
+        }
+        owner.getZone(ZoneType.Command).add(card);
+        return card;
+    }
+
+    private static String kind(final String line) {
+        for (final String kind : List.of("Name:", "Oracle:", "SVar:", "T:", "S:", "R:")) {
+            if (line.startsWith(kind)) {
+                return kind;
+            }
+        }
+        return null;
+    }
+}
