+
+    private static List<Player> recordAttacks(final Fixture f, final Map<Card, Player> attacks) {
+        final List<Player> asked = new ArrayList<>();
+        for (final Player p : f.game.getPlayers()) {
+            p.dangerouslySetController(new PlayerControllerAi(f.game, p, p.getLobbyPlayer()) {
+                @Override
+                public void declareAttackers(final Player attacker, final Combat combat) {
+                    asked.add(p);
+                    for (final Map.Entry<Card, Player> e : attacks.entrySet()) {
+                        if (e.getKey().getController() == p && !combat.isAttacking(e.getKey())) {
+                            combat.addAttacker(e.getKey(), e.getValue());
+                        }
+                    }
+                }
+            });
+        }
+        return asked;
+    }
+
+    private static List<Player> recordBlocks(final Fixture f) {
+        final List<Player> declared = new ArrayList<>();
+        for (final Player p : f.game.getPlayers()) {
+            p.dangerouslySetController(new PlayerControllerAi(f.game, p, p.getLobbyPlayer()) {
+                @Override
+                public void declareBlockers(final Player defender, final Combat combat) {
+                    declared.add(defender);
+                }
+            });
+        }
+        return declared;
+    }
+
+    private static List<String> recordDamage(final Fixture f) {
+        final List<String> assigned = new ArrayList<>();
+        for (final Player p : f.game.getPlayers()) {
+            p.dangerouslySetController(new PlayerControllerAi(f.game, p, p.getLobbyPlayer()) {
+                @Override
+                public Map<Card, Integer> assignCombatDamage(final Card attacker, final CardCollectionView blockers,
+                        final CardCollectionView remaining, final int damageDealt, final GameEntity defender, final boolean overrideOrder) {
+                    assigned.add(p.getName());
+                    final Map<Card, Integer> map = new HashMap<>();
+                    map.put(blockers.get(0), damageDealt);
+                    return map;
+                }
+            });
+        }
+        return assigned;
+    }
+
+    private static void declareAttackers(final Fixture f, final Player active) throws Exception {
+        f.game.getPhaseHandler().devModeSet(PhaseType.COMBAT_DECLARE_ATTACKERS, active);
+        f.game.getPhaseHandler().setCombat(new Combat(active));
+        final Method declare = PhaseHandler.class.getDeclaredMethod("declareAttackersTurnBasedAction");
+        declare.setAccessible(true);
+        withoutPrompts(f, "declaring attackers", () -> invoke(declare, f.game.getPhaseHandler()));
+    }
+
+    private static void declareBlockers(final Fixture f) throws Exception {
+        final Method declare = PhaseHandler.class.getDeclaredMethod("declareBlockersTurnBasedAction");
+        declare.setAccessible(true);
+        withoutPrompts(f, "declaring blockers", () -> invoke(declare, f.game.getPhaseHandler()));
+    }
+
+    private static void stepTo(final Fixture f, final PhaseType target) throws Exception {
+        final PhaseHandler ph = f.game.getPhaseHandler();
+        final Method end = PhaseHandler.class.getDeclaredMethod("onPhaseEnd");
+        final Method advance = PhaseHandler.class.getDeclaredMethod("advanceToNextPhase");
+        final Method begin = PhaseHandler.class.getDeclaredMethod("onPhaseBegin");
+        end.setAccessible(true);
+        advance.setAccessible(true);
+        begin.setAccessible(true);
+        for (int i = 0; i < 16; i++) {
+            withoutPrompts(f, "stepping from " + ph.getPhase(), () -> {
+                invoke(end, ph);
+                invoke(advance, ph);
+                invoke(begin, ph);
+            });
+            if (ph.getPhase() == target) {
+                return;
+            }
+            clearStack(f);
+        }
+        throw new AssertionError("never reached " + target + ", at " + ph.getPhase());
+    }
+
+    private static void clearStack(final Fixture f) throws Exception {
+        final Field waiting = MagicStack.class.getDeclaredField("simultaneousStackEntryList");
+        waiting.setAccessible(true);
+        ((List<?>) waiting.get(f.game.getStack())).clear();
+        f.game.getStack().clear();
+    }
+
+    private static void invoke(final Method m, final Object target) {
+        try {
+            m.invoke(target);
+        } catch (final ReflectiveOperationException e) {
+            throw new RuntimeException(e.getCause() != null ? e.getCause() : e);
+        }
+    }
+
+    private static Map<Player, Integer> handSizes(final Fixture f) {
+        final Map<Player, Integer> sizes = new HashMap<>();
+        for (final Player p : f.game.getPlayers()) {
+            sizes.put(p, p.getCardsIn(ZoneType.Hand).size());
+        }
+        return sizes;
+    }
+
+    private static Map<Player, Integer> handGrowth(final Fixture f, final Map<Player, Integer> before) {
+        final Map<Player, Integer> growth = new HashMap<>();
+        for (final Player p : f.game.getPlayers()) {
+            growth.put(p, p.getCardsIn(ZoneType.Hand).size() - before.get(p));
+        }
+        return growth;
+    }
+
+    private static String names(final Map<Player, Integer> byPlayer) {
