--- /dev/null
+++ b/forge-harness/src/main/java/forge/harness/host/CombatStatics.java
@@ -0,0 +1,157 @@
+package forge.harness.host;
+
+import forge.game.Game;
+import forge.game.GameEntity;
+import forge.game.ability.AbilityUtils;
+import forge.game.card.Card;
+import forge.game.combat.CombatUtil;
+import forge.game.keyword.Keyword;
+import forge.game.phase.PhaseHandler;
+import forge.game.player.Player;
+import forge.game.staticability.StaticAbility;
+import forge.game.staticability.StaticAbilityCantAttackBlock;
+import forge.game.staticability.StaticAbilityMode;
+import forge.game.zone.ZoneType;
+
+import java.util.ArrayList;
+import java.util.List;
+
+final class CombatStatics {
+    private final Game game;
+    private final List<StaticAbility> cantAttack = new ArrayList<>();
+    private final List<StaticAbility> canAttackDefender = new ArrayList<>();
+    private final List<StaticAbility> cantBlock = new ArrayList<>();
+    private final List<StaticAbility> mustAttack = new ArrayList<>();
+
+    private CombatStatics(final Game game) {
+        this.game = game;
+    }
+
+    static CombatStatics of(final Game game) {
+        final CombatStatics out = new CombatStatics(game);
+        for (final Card source : game.getCardsIn(ZoneType.STATIC_ABILITIES_SOURCE_ZONES)) {
+            for (final StaticAbility stAb : source.getStaticAbilities()) {
+                final boolean attack = stAb.checkMode(StaticAbilityMode.CantAttack);
+                final boolean defender = stAb.checkMode(StaticAbilityMode.CanAttackDefender);
+                final boolean block = stAb.checkMode(StaticAbilityMode.CantBlock);
+                final boolean must = stAb.checkMode(StaticAbilityMode.MustAttack);
+                if (!(attack || defender || block || must) || !stAb.checkConditions()) {
+                    continue;
+                }
+                if (attack) {
+                    out.cantAttack.add(stAb);
+                }
+                if (defender) {
+                    out.canAttackDefender.add(stAb);
+                }
+                if (block) {
+                    out.cantBlock.add(stAb);
+                }
+                if (must) {
+                    out.mustAttack.add(stAb);
+                }
+            }
+        }
+        return out;
+    }
+
+    Game game() {
+        return game;
+    }
+
+    boolean canBlockNextTurn(final Card blocker) {
+        if (blocker == null || !blocker.isCreature() || blocker.isBattle()) {
+            return false;
+        }
+        if (blocker.hasKeyword("CARDNAME can't block.") || blocker.hasKeyword("CARDNAME can't attack or block.")) {
+            return false;
+        }
+        if (cantBlock(blocker)) {
+            return false;
+        }
+        if (blocker.hasKeyword("CARDNAME can't attack or block alone.") || blocker.hasKeyword("CARDNAME can't block alone.")) {
+            return CombatUtil.canBlock(blocker, true);
+        }
+        return true;
+    }
+
+    private boolean cantBlock(final Card blocker) {
+        if (blocker.isDetained()) {
+            return true;
+        }
+        for (final StaticAbility stAb : cantBlock) {
+            if (StaticAbilityCantAttackBlock.applyCantBlockAbility(stAb, blocker)) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    boolean canAttackNextTurn(final Card attacker, final GameEntity defender) {
+        if (attacker.isBattle()) {
+            return false;
+        }
+        if (attacker.isGoaded()) {
+            return CombatUtil.canAttackNextTurn(attacker, defender);
+        }
+        return !cantAttack(attacker, defender);
+    }
+
+    private boolean cantAttack(final Card attacker, final GameEntity defender) {
+        if (attacker.hasKeyword("CARDNAME can't attack.") || attacker.hasKeyword("CARDNAME can't attack or block.")) {
+            return true;
+        }
+        if (attacker.isDetained()) {
+            return true;
+        }
+        for (final StaticAbility stAb : cantAttack) {
+            if (cantAttackApplies(stAb, attacker, defender)) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    private boolean cantAttackApplies(final StaticAbility stAb, final Card card, final GameEntity target) {
+        if (!stAb.isKeyword(Keyword.DEFENDER)
+                || stAb.hasParam("DefenderNotNearestToYouInChosenDirection") || stAb.hasParam("UnlessDefender")) {
+            return StaticAbilityCantAttackBlock.applyCantAttackAbility(stAb, card, target);
+        }
+        if (!stAb.matchesValidParam("ValidCard", card) || stAb.getIgnoreEffectCards().contains(card)
+                || !stAb.matchesValidParam("Target", target)) {
+            return false;
+        }
+        return !canAttackDefender(card, target);
+    }
+
+    private boolean canAttackDefender(final Card card, final GameEntity target) {
+        for (final StaticAbility stAb : canAttackDefender) {
+            if (StaticAbilityCantAttackBlock.applyCanAttackDefenderAbility(stAb, card, target)) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    boolean mustAttack(final Card attacker) {
+        final PhaseHandler phases = game.getPhaseHandler();
+        for (final StaticAbility stAb : mustAttack) {
+            if (!stAb.matchesValidParam("ValidCreature", attacker)) {
+                continue;
+            }
+            if (!stAb.hasParam("MustAttack")) {
+                return true;
+            }
+            for (final GameEntity e : AbilityUtils.getDefinedEntities(stAb.getHostCard(), stAb.getParam("MustAttack"), stAb)) {
+                if (e instanceof Player attackPl && phases.isPlayerTurn(attackPl)) {
+                    continue;
+                }
+                if (e instanceof Card attackPw && phases.isPlayerTurn(attackPw.getController())) {
+                    continue;
+                }
+                return true;
+            }
+        }
+        return false;
+    }
+}
