+    private static void hold(final Player p) throws Exception {
+        final Field held = ManaBrewInteractiveController.class.getDeclaredField("exhaustStackIds");
+        held.setAccessible(true);
+        held.set(p.getController(), PriorityFastForward.stackIds(p.getGame()));
+    }
