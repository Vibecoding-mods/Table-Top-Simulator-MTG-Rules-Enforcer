+    private static List<Player> openingHandActions(final Fixture f, final Player first) throws Exception {
+        final List<Player> order = new ArrayList<>();
+        for (final Player p : f.game.getPlayers()) {
+            p.dangerouslySetController(new PlayerControllerAi(f.game, p, p.getLobbyPlayer()) {
+                @Override
+                public List<SpellAbility> chooseSaToActivateFromOpeningHand(final List<SpellAbility> usable) {
+                    order.add(p);
+                    return usable;
+                }
+            });
+            add("Leyline of Sanctity", p, ZoneType.Hand);
+        }
+        final Method run = forge.game.GameAction.class.getDeclaredMethod("runOpeningHandActions", Player.class);
+        run.setAccessible(true);
+        withoutPrompts(f, "opening hand actions", () -> {
+            try {
+                run.invoke(f.game.getAction(), first);
+            } catch (final ReflectiveOperationException e) {
+                throw new RuntimeException(e.getCause() != null ? e.getCause() : e);
+            }
+        });
