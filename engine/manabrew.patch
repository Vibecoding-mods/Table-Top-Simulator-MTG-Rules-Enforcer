diff --git a/forge-harness/src/main/java/forge/harness/host/TieOffer.java b/forge-harness/src/main/java/forge/harness/host/TieOffer.java
new file mode 100644
index 0000000..ea1a53b
--- /dev/null
+++ b/forge-harness/src/main/java/forge/harness/host/TieOffer.java
@@ -0,0 +1,356 @@
+package forge.harness.host;
+
+import forge.game.Game;
+import forge.game.GameEndReason;
+import forge.game.player.GameLossReason;
+import forge.game.card.Card;
+import forge.game.card.CounterEnumType;
+import forge.game.phase.PhaseHandler;
+import forge.game.player.Player;
+import forge.game.replacement.ReplacementEffect;
+import forge.game.replacement.ReplacementType;
+import forge.game.zone.ZoneType;
+import forge.harness.common.SnapshotExtractor;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.HashSet;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import java.util.Set;
+import java.util.TreeMap;
+import java.util.TreeSet;
+import java.util.WeakHashMap;
+import java.util.function.IntPredicate;
+
+final class TieOffer {
+    static final int ROUNDS_TO_FORCE = 3;
+    static final boolean OFFER_WAITS_UNTIL_ONE_CAN_LOSE = true;
+    static final boolean DECKING_BREAKS_LOCK = true;
+
+    enum Status { NONE, PENDING, DECLINED, AGREED, FORCED }
+
+    private static final Map<Game, Map<String, Object>> VIEWS = Collections.synchronizedMap(new WeakHashMap<>());
+    private static final Set<String> PLAIN_PREVENTION_PARAMS = Set.of(
+            "Event", "ActiveZones", "Prevent", "ValidTarget", "Description", "Secondary", "AILogic");
+
+    private final Game game;
+    private final boolean waitUntilOneCanLose;
+    private final boolean deckingBreaksLock;
+    private Status status = Status.NONE;
+    private int voteCount;
+    private int voteId;
+    private final Set<Integer> awaiting = new TreeSet<>();
+    private final Set<Integer> accepted = new TreeSet<>();
+    private int decliner = -1;
+    private Map<Integer, List<String>> locks = new TreeMap<>();
+    private int rounds;
+    private Player anchor;
+    private int countedTurn;
+    private Signature last;
+
+    TieOffer(final Game game) {
+        this(game, OFFER_WAITS_UNTIL_ONE_CAN_LOSE, DECKING_BREAKS_LOCK);
+    }
+
+    TieOffer(final Game game, final boolean waitUntilOneCanLose, final boolean deckingBreaksLock) {
+        this.game = game;
+        this.waitUntilOneCanLose = waitUntilOneCanLose;
+        this.deckingBreaksLock = deckingBreaksLock;
+        VIEWS.remove(game);
+    }
+
+    static Map<String, Object> viewOf(final Game game) {
+        return game == null ? null : VIEWS.get(game);
+    }
+
+    Status status() {
+        return status;
+    }
+
+    int voteId() {
+        return voteId;
+    }
+
+    int rounds() {
+        return rounds;
+    }
+
+    void update(final IntPredicate human) {
+        if (status == Status.AGREED || status == Status.FORCED || game.isGameOver()) {
+            return;
+        }
+        final Map<Integer, List<String>> now = stalled(game, waitUntilOneCanLose, deckingBreaksLock);
+        if (now.isEmpty()) {
+            if (status != Status.NONE) {
+                status = Status.NONE;
+                VIEWS.remove(game);
+            }
+            return;
+        }
+        locks = now;
+        if (status == Status.NONE) {
+            open(human);
+        } else if (status == Status.DECLINED) {
+            countRounds();
+        } else {
+            awaiting.removeIf(seat -> game.getRegisteredPlayers().get(seat).hasLost());
+            if (awaiting.isEmpty()) {
+                end(Status.AGREED);
+            }
+        }
+        publish();
+    }
+
+    boolean vote(final int voter, final int id, final boolean accept) {
+        if (status != Status.PENDING || id != voteId || !awaiting.remove(voter)) {
+            return false;
+        }
+        if (accept) {
+            accepted.add(voter);
+            if (awaiting.isEmpty()) {
+                end(Status.AGREED);
+            }
+        } else {
+            status = Status.DECLINED;
+            decliner = voter;
+            startCount();
+        }
+        publish();
+        return true;
+    }
+
+    private void open(final IntPredicate human) {
+        voteId = ++voteCount;
+        status = Status.PENDING;
+        awaiting.clear();
+        accepted.clear();
+        decliner = -1;
+        rounds = 0;
+        for (final Player player : game.getPlayers()) {
+            final int seat = SnapshotExtractor.playerIndex(game, player);
+            if (human.test(seat)) {
+                awaiting.add(seat);
+            } else {
+                accepted.add(seat);
+            }
+        }
+        if (awaiting.isEmpty()) {
+            end(Status.AGREED);
+        }
+    }
+
+    private void startCount() {
+        final PhaseHandler phases = game.getPhaseHandler();
+        last = Signature.of(game);
+        anchor = phases.getPlayerTurn();
+        countedTurn = phases.getTurn();
+        rounds = 0;
+    }
+
+    private void countRounds() {
+        final PhaseHandler phases = game.getPhaseHandler();
+        final Signature now = Signature.of(game);
+        if (last == null || now.progressSince(last)) {
+            startCount();
+            return;
+        }
+        last = now;
+        if (anchor == null || anchor.hasLost() || !game.getPlayers().contains(anchor)) {
+            anchor = phases.getPlayerTurn();
+            countedTurn = phases.getTurn();
+            return;
+        }
+        if (phases.getPlayerTurn() == anchor && phases.getTurn() != countedTurn) {
+            countedTurn = phases.getTurn();
+            rounds++;
+            if (rounds >= ROUNDS_TO_FORCE) {
+                end(Status.FORCED);
+            }
+        }
+    }
+
+    private void end(final Status how) {
+        status = how;
+        awaiting.clear();
+        game.setDrawReason(how == Status.FORCED ? "tieForced" : "tieAgreed");
+        for (final Player player : game.getPlayers()) {
+            player.intentionalDraw();
+        }
+        publish();
+        game.setGameOver(GameEndReason.Draw);
+    }
+
+    private void publish() {
+        if (status == Status.NONE) {
+            VIEWS.remove(game);
+            return;
+        }
+        final Map<String, Object> view = new LinkedHashMap<>();
+        view.put("voteId", voteId);
+        final List<Map<String, Object>> lockViews = new ArrayList<>();
+        for (final Map.Entry<Integer, List<String>> entry : locks.entrySet()) {
+            final Map<String, Object> lock = new LinkedHashMap<>();
+            lock.put("playerId", "player-" + entry.getKey());
+            lock.put("reasons", entry.getValue());
+            lockViews.add(lock);
+        }
+        view.put("locks", lockViews);
+        view.put("awaitingPlayerIds", ids(awaiting));
+        view.put("acceptedPlayerIds", ids(accepted));
+        final Map<String, Object> state = new LinkedHashMap<>();
+        state.put("type", status.name().toLowerCase(Locale.ROOT));
+        if (status == Status.DECLINED || status == Status.FORCED && decliner >= 0) {
+            state.put("playerId", "player-" + decliner);
+        }
+        view.put("status", state);
+        view.put("roundsWithoutProgress", rounds);
+        view.put("roundsToForce", ROUNDS_TO_FORCE);
+        VIEWS.put(game, view);
+    }
+
+    private static List<String> ids(final Set<Integer> seats) {
+        final List<String> out = new ArrayList<>();
+        for (final int seat : seats) {
+            out.add("player-" + seat);
+        }
+        return out;
+    }
+
+    static Map<Integer, List<String>> stalled(final Game game, final boolean waitUntilOneCanLose, final boolean deckingBreaksLock) {
+        final Map<Integer, List<String>> out = locks(game, deckingBreaksLock);
+        if (waitUntilOneCanLose && game.getPlayers().stream().filter(p -> !p.hasLost()).count() - out.size() > 1) {
+            return new TreeMap<>();
+        }
+        return out;
+    }
+
+    static Map<Integer, List<String>> locks(final Game game) {
+        return locks(game, DECKING_BREAKS_LOCK);
+    }
+
+    static Map<Integer, List<String>> locks(final Game game, final boolean deckingBreaksLock) {
+        final Map<Integer, List<String>> out = new TreeMap<>();
+        for (final Player player : game.getPlayers()) {
+            if (player.hasLost()) {
+                continue;
+            }
+            final List<String> reasons = reasons(game, player, deckingBreaksLock);
+            if (!reasons.isEmpty()) {
+                out.put(SnapshotExtractor.playerIndex(game, player), reasons);
+            }
+        }
+        return out;
+    }
+
+    static List<String> reasons(final Game game, final Player player) {
+        return reasons(game, player, DECKING_BREAKS_LOCK);
+    }
+
+    static List<String> reasons(final Game game, final Player player, final boolean deckingBreaksLock) {
+        final List<String> out = new ArrayList<>();
+        if (player.cantLose()) {
+            out.add("cantLose");
+        }
+        if (!player.canLoseLife()) {
+            out.add("cantLoseLife");
+        }
+        final boolean prevented = allDamagePrevented(game, player);
+        if (player.cantLoseForZeroOrLessLife() && !player.canReceiveCounters(CounterEnumType.POISON)
+                && !commanderDamageThreat(game, player, prevented)) {
+            out.add("cantLoseForZeroLife");
+        }
+        if (prevented) {
+            out.add("damagePrevented");
+        }
+        if (deckingBreaksLock && !out.isEmpty() && !player.cantLoseCheck(GameLossReason.Milled)) {
+            out.clear();
+        }
+        return out;
+    }
+
+    private static boolean commanderDamageThreat(final Game game, final Player player, final boolean prevented) {
+        if (prevented) {
+            return false;
+        }
+        for (final Player other : game.getPlayers()) {
+            if (other != player && !other.hasLost() && !other.getCommanders().isEmpty()) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    static boolean allDamagePrevented(final Game game, final Player player) {
+        for (final Card card : game.getCardsIn(ZoneType.listValueOf("Battlefield,Command"))) {
+            for (final ReplacementEffect effect : card.getReplacementEffects()) {
+                if (effect.getMode() == ReplacementType.DamageDone
+                        && "True".equals(effect.getParam("Prevent"))
+                        && PLAIN_PREVENTION_PARAMS.containsAll(effect.getMapParams().keySet())
+                        && effect.zonesCheck(game.getZoneOf(card))
+                        && effect.requirementsCheck(game)
+                        && effect.matchesValidParam("ValidTarget", player)) {
+                    return true;
+                }
+            }
+        }
+        return false;
+    }
+
+    static final class Signature {
+        private final List<Integer> life = new ArrayList<>();
+        private final List<Integer> poison = new ArrayList<>();
+        private final List<Integer> commanderDamage = new ArrayList<>();
+        private final List<Boolean> lost = new ArrayList<>();
+        private final Set<Integer> battlefield = new HashSet<>();
+        private final Set<Integer> library = new HashSet<>();
+        private final Set<Integer> graveyard = new HashSet<>();
+
+        static Signature of(final Game game) {
+            final Signature out = new Signature();
+            for (final Player player : game.getRegisteredPlayers()) {
+                out.life.add(player.getLife());
+                out.poison.add(player.getPoisonCounters());
+                int damage = 0;
+                for (final Map.Entry<Card, Integer> entry : player.getCommanderDamage()) {
+                    damage += entry.getValue();
+                }
+                out.commanderDamage.add(damage);
+                out.lost.add(player.hasLost());
+                for (final Card card : player.getCardsIn(ZoneType.Library)) {
+                    out.library.add(card.getId());
+                }
+                for (final Card card : player.getCardsIn(ZoneType.Graveyard)) {
+                    out.graveyard.add(card.getId());
+                }
+            }
+            for (final Card card : game.getCardsIn(ZoneType.Battlefield)) {
+                out.battlefield.add(card.getId());
+            }
+            return out;
+        }
+
+        boolean progressSince(final Signature before) {
+            for (int i = 0; i < life.size() && i < before.life.size(); i++) {
+                if (life.get(i) < before.life.get(i) || poison.get(i) > before.poison.get(i)
+                        || commanderDamage.get(i) > before.commanderDamage.get(i)
+                        || lost.get(i) && !before.lost.get(i)) {
+                    return true;
+                }
+            }
+            for (final int id : before.battlefield) {
+                if (!battlefield.contains(id)) {
+                    return true;
+                }
+            }
+            for (final int id : graveyard) {
+                if (before.library.contains(id) && !before.graveyard.contains(id)) {
+                    return true;
+                }
+            }
+            return false;
+        }
+    }
+}
