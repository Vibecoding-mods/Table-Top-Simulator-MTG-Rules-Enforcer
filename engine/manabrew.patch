+    private static List<String> script(final Fixture f, final Map<Player, List<Map<Card, Card>>> answers) {
+        final List<String> asked = new ArrayList<>();
+        for (final Player p : f.game.getPlayers()) {
+            final List<Map<Card, Card>> mine = answers.getOrDefault(p, List.of(Map.of()));
+            p.dangerouslySetController(new PlayerControllerAi(f.game, p, p.getLobbyPlayer()) {
