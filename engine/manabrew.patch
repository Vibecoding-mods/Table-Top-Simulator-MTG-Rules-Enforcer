+        final Map<Integer, Card> present = new HashMap<>();
+        for (final Card card : game.getCardsInGame()) {
+            present.put(card.getId(), card);
+        }
+        for (final Map.Entry<Card, Zone> place : zones.entrySet()) {
+            final Card card = place.getKey();
+            final Zone zone = place.getValue();
+            if (rejoined.contains(card.getOwner())) {
+                if (present.putIfAbsent(card.getId(), card) == null) {
+                    zone.add(card, null, null, true);
+                }
+            } else if (rejoined.contains(zone.getPlayer()) && present.get(card.getId()) == card) {
+                for (final Map.Entry<Long, Player> control : controllers.getOrDefault(card, new TreeMap<>()).entrySet()) {
+                    if (rejoined.contains(control.getValue())) {
+                        card.addTempController(control.getValue(), control.getKey());
+                    }
+                }
+                if (card.getZone() != zone) {
+                    card.getZone().remove(card);
+                    zone.add(card, null, null, true);
+                }
+            }
+        }
+    }
+
+    @SuppressWarnings("unchecked")
+    private static NavigableMap<Long, Player> tempControllers(final Card card) {
+        try {
+            return (NavigableMap<Long, Player>) TEMP_CONTROLLERS.get(card);
+        } catch (final IllegalAccessException e) {
+            throw new IllegalStateException(e);
+        }
+    }
+
+    private static Field field() {
+        try {
+            final Field field = Card.class.getDeclaredField("tempControllers");
+            field.setAccessible(true);
+            return field;
+        } catch (final NoSuchFieldException e) {
+            throw new IllegalStateException(e);
+        }
+    }
+}
diff --git a/forge-harness/src/main/java/forge/harness/host/DungeonView.java b/forge-harness/src/main/java/forge/harness/host/DungeonView.java
new file mode 100644
index 0000000..3fa96b5
--- /dev/null
+++ b/forge-harness/src/main/java/forge/harness/host/DungeonView.java
@@ -0,0 +1,108 @@
+package forge.harness.host;
+
+import forge.StaticData;
+import forge.card.CardRules;
+import forge.card.GamePieceType;
+import forge.game.Game;
+import forge.game.card.Card;
+import forge.game.card.CardFactory;
+import forge.game.player.Player;
+import forge.game.spellability.SpellAbility;
+import forge.game.trigger.Trigger;
+import forge.game.zone.ZoneType;
+import forge.harness.common.SnapshotExtractor;
+import forge.item.PaperToken;
+
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+final class DungeonView {
+    private DungeonView() {}
+
+    static Map<String, Object> dungeonState(final Player player) {
+        for (final Card card : player.getCardsIn(ZoneType.Command)) {
+            if (!card.getType().isDungeon()) {
+                continue;
+            }
+            final Map<String, Object> state = new LinkedHashMap<>();
+            state.put("name", card.getName());
+            state.put("room", card.getCurrentRoom() == null ? "" : card.getCurrentRoom());
+            state.put("cardId", SnapshotExtractor.javaCardId(card));
+            state.put("rooms", rooms(card));
+            return state;
+        }
+        return null;
+    }
+
+    static List<String> completedDungeons(final Player player) {
+        final List<String> names = new ArrayList<>();
+        for (final Card dungeon : player.getCompletedDungeons()) {
+            names.add(dungeon.getName());
+        }
+        return names;
+    }
+
+    static List<Map<String, Object>> rooms(final Card dungeon) {
+        final List<Map<String, Object>> rooms = new ArrayList<>();
+        for (final Trigger trigger : dungeon.getTriggers()) {
+            final SpellAbility room = trigger.getOverridingAbility();
+            if (room == null || !room.hasParam("RoomName")) {
+                continue;
+            }
+            final Map<String, Object> entry = new LinkedHashMap<>();
+            entry.put("name", room.getParam("RoomName"));
+            entry.put("next", room.hasParam("NextRoomName")
+                    ? Arrays.asList(room.getParam("NextRoomName").split(","))
+                    : List.of());
+            entry.put("text", room.getDescription());
+            rooms.add(entry);
+        }
+        return rooms;
+    }
+
+    static Card makeDungeon(final Game game, final Player owner, final String name) {
+        for (final Map.Entry<String, CardRules> entry : StaticData.instance().getAllTokens().getRules().entrySet()) {
+            if (!entry.getValue().getType().isDungeon() || !name.equals(entry.getValue().getName())) {
+                continue;
+            }
+            final PaperToken paper = StaticData.instance().getAllTokens().getToken(entry.getKey());
+            if (paper == null) {
+                break;
+            }
+            final Card dungeon = CardFactory.getCard(paper, owner, game);
+            dungeon.setGamePieceType(GamePieceType.DUNGEON);
+            return dungeon;
+        }
+        throw new IllegalArgumentException("no dungeon named " + name);
+    }
+
+    static void enterDungeon(final Game game, final Player player, final String name, final String room) {
+        for (final Card card : player.getCardsIn(ZoneType.Command)) {
+            if (card.getType().isDungeon()) {
+                throw new IllegalStateException(player.getName() + " is already in " + card.getName());
+            }
+        }
+        final Card dungeon = makeDungeon(game, player, name);
+        if (room != null && !room.isEmpty() && !hasRoom(dungeon, room)) {
+            throw new IllegalArgumentException(name + " has no room named " + room);
+        }
+        game.getAction().moveToCommand(dungeon, null);
+        dungeon.setCurrentRoom(room == null ? "" : room);
+    }
+
+    static void completeDungeon(final Game game, final Player player, final String name) {
+        player.addCompletedDungeon(makeDungeon(game, player, name));
+    }
+
+    private static boolean hasRoom(final Card dungeon, final String room) {
+        for (final Map<String, Object> entry : rooms(dungeon)) {
+            if (room.equals(entry.get("name"))) {
+                return true;
+            }
+        }
+        return false;
+    }
+}
diff --git a/forge-harness/src/main/java/forge/harness/host/EffectsView.java b/forge-harness/src/main/java/forge/harness/host/EffectsView.java
new file mode 100644
index 0000000..1ecaebb
--- /dev/null
+++ b/forge-harness/src/main/java/forge/harness/host/EffectsView.java
@@ -0,0 +1,192 @@
+package forge.harness.host;
+
+import com.google.common.collect.ListMultimap;
+import forge.game.Game;
+import forge.game.ability.ApiType;
+import forge.game.card.Card;
+import forge.game.phase.PhaseType;
+import forge.game.player.Player;
+import forge.game.spellability.SpellAbility;
+import forge.game.trigger.Trigger;
+import forge.game.trigger.TriggerHandler;
+import forge.game.trigger.TriggerType;
+import forge.game.zone.ZoneType;
+import forge.harness.common.SnapshotExtractor;
+
+import java.lang.reflect.Field;
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.function.Predicate;
+
+final class EffectsView {
+    private static final Field DELAYED = field("delayedTriggers");
+    private static final Field PLAYER_DEFINED = field("playerDefinedDelayedTriggers");
+
+    private EffectsView() {}
+
+    static List<Map<String, Object>> effects(final Player player) {
+        final List<Map<String, Object>> effects = new ArrayList<>();
+        for (final Card card : player.getCardsIn(ZoneType.Command)) {
+            if (!card.isImmutable() || !card.getRenderForUI() || card.getEffectSource() == null) {
+                continue;
+            }
+            final List<Card> named = List.of(card.getEffectSource());
+            final String text = withoutIds(plainText(card.getAbilityText()), named);
+            if (text.isEmpty()) {
+                continue;
+            }
+            final Map<String, Object> effect = new LinkedHashMap<>();
+            effect.put("id", "effect-" + card.getId());
+            effect.put("name", withoutIds(card.getName(), named));
+            effect.put("text", text);
+            effect.put("sourceCardId", SnapshotExtractor.javaCardId(card.getEffectSource()));
+            effect.put("emblem", card.isEmblem());
+            final SpellAbility source = card.getEffectSourceAbility();
+            final String duration = source == null ? null : source.getParam("Duration");
+            effect.put("untilEndOfTurn", source != null && duration == null
+                    && (source.getApi() == ApiType.Effect || source.getApi() == ApiType.Fog));
+            if (duration != null) {
+                effect.put("duration", duration);
+            }
+            effects.add(effect);
+        }
+        return effects;
+    }
+
+    static List<Map<String, Object>> delayed(final Game game, final Predicate<Card> shown) {
+        final TriggerHandler handler = game.getTriggerHandler();
+        final List<Map<String, Object>> out = new ArrayList<>();
+        for (final Trigger trigger : delayedTriggers(handler)) {
+            if (trigger.getMode() != TriggerType.Immediate) {
+                out.add(delayed(game, trigger, null, shown));
+            }
+        }
+        for (final Map.Entry<Player, Trigger> entry : playerDefined(handler).entries()) {
+            out.add(delayed(game, entry.getValue(), entry.getKey(), shown));
+        }
+        return out;
+    }
+
+    private static Map<String, Object> delayed(
+            final Game game, final Trigger trigger, final Player nextTurnOf, final Predicate<Card> shown) {
+        final Map<String, Object> out = new LinkedHashMap<>();
+        out.put("id", "delayed-" + trigger.getId());
+        final Card host = trigger.getHostCard();
+        final List<Card> named = new ArrayList<>();
+        named.add(host);
+        for (final Object remembered : trigger.getTriggerRemembered()) {
+            if (remembered instanceof Card card) {
+                named.add(card);
+            }
+        }
+        final Card shownHost = host.isImmutable() && host.getEffectSource() != null ? host.getEffectSource() : host;
+        boolean hidden = false;
+        String hostCardId = null;
+        if (!shownHost.isImmutable()) {
+            if (shown.test(shownHost)) {
+                hostCardId = SnapshotExtractor.javaCardId(shownHost);
+            } else {
+                hidden = true;
+            }
+        }
+        final List<String> cardIds = new ArrayList<>();
+        for (final Card card : named.subList(1, named.size())) {
+            if (card.isImmutable()) {
+                continue;
+            }
+            if (shown.test(card)) {
+                cardIds.add(SnapshotExtractor.javaCardId(card));
+            } else {
+                hidden = true;
+            }
+        }
+        out.put("text", hidden ? "" : withoutIds(plainText(trigger.toString()), named));
+        final SpellAbility spawning = trigger.getSpawningAbility();
+        final Player controller = spawning != null && spawning.getActivatingPlayer() != null
+                ? spawning.getActivatingPlayer() : host.getController();
+        out.put("controllerId", playerId(game, controller));
+        if (hostCardId != null) {
+            out.put("hostCardId", hostCardId);
+        }
+        out.put("cardIds", cardIds);
+        if (trigger.getMode() == TriggerType.Phase && trigger.hasParam("Phase")) {
+            out.put("when", phaseWords(trigger.getParam("Phase")));
+        }
+        if (nextTurnOf != null) {
+            out.put("turnOf", playerId(game, nextTurnOf));
+        } else if ("You".equals(trigger.getParam("ValidPlayer"))) {
+            out.put("turnOf", playerId(game, controller));
+        }
+        return out;
+    }
+
+    private static String phaseWords(final String phases) {
+        final Set<PhaseType> parsed = PhaseType.parseRange(phases);
+        final List<String> words = new ArrayList<>();
+        for (final PhaseType phase : parsed) {
+            words.add(switch (phase) {
+                case UNTAP -> "untap step";
+                case UPKEEP -> "upkeep";
+                case DRAW -> "draw step";
+                case MAIN1 -> "first main phase";
+                case COMBAT_BEGIN -> "beginning of combat";
+                case COMBAT_DECLARE_ATTACKERS -> "declare attackers step";
+                case COMBAT_DECLARE_BLOCKERS -> "declare blockers step";
+                case COMBAT_FIRST_STRIKE_DAMAGE -> "first strike damage step";
+                case COMBAT_DAMAGE -> "combat damage step";
+                case COMBAT_END -> "end of combat";
+                case MAIN2 -> "second main phase";
+                case END_OF_TURN -> "end step";
+                case CLEANUP -> "cleanup step";
+            });
+        }
+        return String.join(" or ", words);
+    }
+
+    private static String playerId(final Game game, final Player player) {
+        return "player-" + SnapshotExtractor.playerIndex(game, player);
+    }
+
+    private static String withoutIds(final String text, final List<Card> cards) {
+        String out = text;
+        for (final Card card : cards) {
+            out = out.replace(" (" + card.getId() + ")", "");
+        }
+        return out;
+    }
+
+    private static String plainText(final String text) {
+        return text.replaceAll("<[^>]*>", "").replace("\r", "").replaceAll("\n{2,}", "\n").trim();
+    }
+
+    @SuppressWarnings("unchecked")
+    private static List<Trigger> delayedTriggers(final TriggerHandler handler) {
+        try {
+            return (List<Trigger>) DELAYED.get(handler);
+        } catch (final IllegalAccessException e) {
+            throw new IllegalStateException(e);
+        }
+    }
+
+    @SuppressWarnings("unchecked")
+    private static ListMultimap<Player, Trigger> playerDefined(final TriggerHandler handler) {
+        try {
+            return (ListMultimap<Player, Trigger>) PLAYER_DEFINED.get(handler);
+        } catch (final IllegalAccessException e) {
+            throw new IllegalStateException(e);
+        }
+    }
+
+    private static Field field(final String name) {
+        try {
+            final Field field = TriggerHandler.class.getDeclaredField(name);
+            field.setAccessible(true);
+            return field;
+        } catch (final NoSuchFieldException e) {
+            throw new IllegalStateException(e);
+        }
+    }
+}
diff --git a/forge-harness/src/main/java/forge/harness/host/EngineEventLog.java b/forge-harness/src/main/java/forge/harness/host/EngineEventLog.java
new file mode 100644
index 0000000..ca35fdf
--- /dev/null
+++ b/forge-harness/src/main/java/forge/harness/host/EngineEventLog.java
@@ -0,0 +1,409 @@
+package forge.harness.host;
+
+import com.google.common.eventbus.Subscribe;
+import forge.game.Game;
+import forge.game.GameEntity;
+import forge.game.GameLogEntryType;
+import forge.game.GameStage;
+import forge.game.card.Card;
+import forge.game.card.CardView;
+import forge.game.card.CounterEnumType;
+import forge.game.cost.CostPart;
+import forge.game.cost.CostPartMana;
+import forge.game.event.GameEvent;
+import forge.game.event.GameEventAddLog;
+import forge.game.event.GameEventCardChangeZone;
+import forge.game.event.GameEventCardCounters;
+import forge.game.event.GameEventCardDamaged;
+import forge.game.event.GameEventCardSacrificed;
+import forge.game.event.GameEventLandPlayed;
+import forge.game.event.GameEventPlayerDamaged;
+import forge.game.event.GameEventSnapshotRestored;
+import forge.game.event.GameEventSurveil;
+import forge.game.event.GameEventTurnPhase;
+import forge.game.keyword.Keyword;
+import forge.game.player.Player;
+import forge.game.player.PlayerView;
+import forge.game.spellability.SpellAbility;
+import forge.game.zone.CostPaymentStack;
+import forge.game.zone.MagicStack;
+import forge.game.zone.ZoneType;
+import forge.game.zone.ZoneView;
+import forge.harness.common.ParityCardMap;
+import forge.harness.common.SnapshotExtractor;
+import java.util.ArrayDeque;
+import java.util.ArrayList;
+import java.util.HashSet;
+import java.util.Iterator;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import org.apache.commons.lang3.tuple.Pair;
+
+final class EngineEventLog {
+    private static final int CAPACITY = 512;
+
+    private static final class Entry {
+        int seq;
+        int cardId;
+        boolean visible;
+        ZoneType from;
+        ZoneType to;
+        int owner;
+        String how;
+        String cause;
+        String causeName;
+        int causeCardId;
+        boolean damage;
+        int sourceCardId;
+        int targetCardId;
+        int targetPlayer = -1;
+        int amount;
+        boolean combat;
+    }
+
+    private record Awaited(Card target, int index) {
+    }
+
+    private final Game game;
+    private final ArrayDeque<Entry> ring = new ArrayDeque<>();
+    private final List<Entry> maybeDrawn = new ArrayList<>();
+    private final List<Entry> unsettled = new ArrayList<>();
+    private final List<Entry> replacing = new ArrayList<>();
+    private final Set<Integer> sacrificed = new HashSet<>();
+    private final List<Awaited> awaited = new ArrayList<>();
+    private boolean restoring;
+    private int seq;
+
+    EngineEventLog(final Game game) {
+        this.game = game;
+    }
+
+    @Subscribe
+    public void recieve(final GameEvent event) {
+        if (event instanceof GameEventSnapshotRestored restored) {
+            restoring = restored.start();
+            maybeDrawn.clear();
+            unsettled.clear();
+            replacing.clear();
+            sacrificed.clear();
+            awaited.clear();
+            return;
+        }
+        if (restoring) {
+            return;
+        }
+        settleDamage();
+        if (event instanceof GameEventCardChangeZone moved) {
+            zoneChange(moved);
+        } else if (event instanceof GameEventCardSacrificed gone) {
+            sacrificed.add(gone.card().getId());
+        } else if (event instanceof GameEventLandPlayed played) {
+            markLast(played.land().getId(), "played");
+        } else if (event instanceof GameEventAddLog logged) {
+            if (logged.type() == GameLogEntryType.DISCARD && logged.sourceCard() != null) {
+                markLast(logged.sourceCard().getId(), "discard");
+            } else if (logged.type() == GameLogEntryType.EFFECT_REPLACED) {
+                markReplaced(logged.message());
+            }
+        } else if (event instanceof GameEventSurveil surveil) {
+            markSurveiled(surveil.player(), surveil.toGraveyard());
+        } else if (event instanceof GameEventTurnPhase) {
+            settleDraws();
+        } else if (event instanceof GameEventCardDamaged damaged) {
+            awaitDamage(damaged.card(), true);
+        } else if (event instanceof GameEventCardCounters counters && isDamageCounter(counters)) {
+            awaitDamage(counters.card(), false);
+        } else if (event instanceof GameEventPlayerDamaged damaged) {
+            playerDamaged(damaged);
+        }
+    }
+
+    private static boolean isDamageCounter(final GameEventCardCounters counters) {
+        return counters.newValue() < counters.oldValue()
+                && (counters.type().is(CounterEnumType.LOYALTY) || counters.type().is(CounterEnumType.DEFENSE));
+    }
+
+    private void awaitDamage(final CardView view, final boolean creature) {
+        final Card target = game.getAge() == GameStage.Play ? game.findById(view.getId()) : null;
+        if (target != null && target.isCreature() == creature) {
+            awaited.add(new Awaited(target, target.getDamageReceivedThisTurn().size()));
+        }
+    }
+
+    private void settleDamage() {
+        for (final Awaited waiting : awaited) {
+            final List<Pair<Integer, Boolean>> received = waiting.target().getDamageReceivedThisTurn();
+            if (received.size() <= waiting.index()) {
+                continue;
+            }
+            final Pair<Integer, Boolean> dealt = received.get(waiting.index());
+            final Pair<Card, GameEntity> sourceToTarget = game.getDamageLKI(dealt);
+            final Card source = sourceToTarget == null ? null : sourceToTarget.getLeft();
+            if (source != null && source.getOwner() != null) {
+                final Entry entry = damageEntry(source.getId(), playerIndex(source.getOwner()),
+                        dealt.getLeft(), dealt.getRight());
+                entry.targetCardId = waiting.target().getId();
+            }
+        }
+        awaited.clear();
+    }
+
+    private void playerDamaged(final GameEventPlayerDamaged damaged) {
+        if (game.getAge() != GameStage.Play) {
+            return;
+        }
+        final CardView source = damaged.source();
+        final int owner = source == null ? -1 : playerIndex(source.getOwner());
+        final int target = playerIndex(damaged.target());
+        if (owner >= 0 && target >= 0) {
+            damageEntry(source.getId(), owner, damaged.amount(), damaged.combat()).targetPlayer = target;
+        }
+    }
+
+    private Entry damageEntry(final int sourceCardId, final int owner, final int amount, final boolean combat) {
+        final Entry entry = new Entry();
+        entry.seq = ++seq;
+        entry.damage = true;
+        entry.sourceCardId = sourceCardId;
+        entry.owner = owner;
+        entry.amount = amount;
+        entry.combat = combat;
+        add(entry);
+        return entry;
+    }
+
+    private void add(final Entry entry) {
+        ring.addLast(entry);
+        if (ring.size() > CAPACITY) {
+            ring.removeFirst();
+        }
+    }
+
+    private void zoneChange(final GameEventCardChangeZone moved) {
+        final ZoneView to = moved.to();
+        final ZoneView from = moved.from();
+        if (to == null || to.zoneType() == ZoneType.Stack || game.getAge() != GameStage.Play) {
+            return;
+        }
+        settleDraws();
+        settleMoves();
+        final CardView card = moved.card();
+        final Entry entry = new Entry();
+        entry.seq = ++seq;
+        entry.cardId = card.getId();
+        entry.from = from == null ? null : from.zoneType();
+        entry.to = to.zoneType();
+        entry.visible = !card.isFaceDown() && (isPublic(entry.from) || isPublic(entry.to));
+        entry.owner = playerIndex(card.getOwner());
+        if (entry.from == ZoneType.Battlefield) {
+            if (sacrificed.remove(entry.cardId)) {
+                entry.how = "sacrificed";
+            } else if (card.wasDestroyed()) {
+                entry.how = "destroyed";
+            }
+        }
+        if (entry.from == ZoneType.Library && entry.to == ZoneType.Hand) {
+            maybeDrawn.add(entry);
+        }
+        if (entry.to == ZoneType.Exile || entry.from == ZoneType.Library && entry.to == ZoneType.Graveyard) {
+            unsettled.add(entry);
+        }
+        if (entry.from != ZoneType.Stack) {
+            markCause(entry);
+        }
+        add(entry);
+    }
+
+    private void markCause(final Entry entry) {
+        if (game.getReplacementHandler().isReplacing()) {
+            replacing.add(entry);
+            return;
+        }
+        replacing.clear();
+        final CostPaymentStack.Entry paying = game.costPaymentStack.peek();
+        if (paying != null) {
+            final SpellAbility ability = paying.payment().getAbility();
+            entry.cause = "Cost:" + costName(entry, paying.cost(), ability);
+            markHost(entry, ability);
+            return;
+        }
+        final MagicStack stack = game.getStack();
+        if (!stack.isResolving() || stack.peek() == null) {
+            return;
+        }
+        final SpellAbility ability = stack.peekAbility();
+        if (ability.getApi() != null) {
+            entry.cause = ability.getApi().name();
+        }
+        markHost(entry, ability);
+    }
+
+    private static String costName(final Entry entry, final CostPart part, final SpellAbility ability) {
+        final Card host = ability.getHostCard();
+        if (part instanceof CostPartMana && entry.to == ZoneType.Exile && host != null && host.hasKeyword(Keyword.DELVE)) {
+            return "Delve";
+        }
+        if (ability.getKeyword() != null) {
+            return ability.getKeyword().getKeyword().toString();
+        }
+        if (ability.getAlternativeCost() != null) {
+            return ability.getAlternativeCost().name();
+        }
+        return part.getClass().getSimpleName().replaceFirst("^Cost", "");
+    }
+
+    private static void markHost(final Entry entry, final SpellAbility ability) {
+        final Card host = ability.getHostCard();
+        if (host != null && !host.isFaceDown()) {
+            entry.causeName = host.getName();
+            entry.causeCardId = host.getId();
+        }
+    }
+
+    private void markReplaced(final String message) {
+        for (final Entry entry : replacing) {
+            entry.cause = message;
+        }
+        replacing.clear();
+    }
+
+    private int playerIndex(final PlayerView view) {
+        return playerIndex(view == null ? null : game.getPlayer(view));
+    }
+
+    private int playerIndex(final Player player) {
+        return player == null ? -1 : SnapshotExtractor.playerIndex(game, player);
+    }
+
+    private static boolean isPublic(final ZoneType zone) {
+        return zone != null && !zone.isHidden();
+    }
+
+    private void markLast(final int cardId, final String how) {
+        final Iterator<Entry> newestFirst = ring.descendingIterator();
+        while (newestFirst.hasNext()) {
+            final Entry entry = newestFirst.next();
+            if (entry.cardId == cardId) {
+                entry.how = how;
+                return;
+            }
+        }
+    }
+
+    private void markSurveiled(final PlayerView player, final int count) {
+        final int owner = playerIndex(player);
+        int left = count;
+        final Iterator<Entry> newestFirst = ring.descendingIterator();
+        while (left > 0 && newestFirst.hasNext()) {
+            final Entry entry = newestFirst.next();
+            if (entry.owner == owner && entry.from == ZoneType.Library && entry.to == ZoneType.Graveyard) {
+                entry.how = "surveil";
+                left--;
+            }
+        }
+    }
+
+    private void settleDraws() {
+        for (final Entry entry : maybeDrawn) {
+            final Card card = game.findById(entry.cardId);
+            if (card != null && card.getDrawnThisTurn()) {
+                entry.how = "draw";
+            }
+        }
+        maybeDrawn.clear();
+    }
+
+    private void settleMoves() {
+        for (final Entry entry : unsettled) {
+            final Card card = game.findById(entry.cardId);
+            if (card != null && entry.to == ZoneType.Exile && card.isInZone(ZoneType.Exile) && card.isFaceDown()) {
+                entry.visible = false;
+            }
+            if (card != null && entry.how == null) {
+                entry.how = settledHow(entry, card);
+            }
+        }
+        unsettled.clear();
+    }
+
+    private static String settledHow(final Entry entry, final Card card) {
+        if (entry.from == ZoneType.Library && card.wasMilled()) {
+            return "mill";
+        }
+        if (entry.to != ZoneType.Exile || !card.isInZone(ZoneType.Exile)) {
+            return null;
+        }
+        if (card.isForetold()) {
+            return "foretell";
+        }
+        if (card.isPlotted()) {
+            return "plot";
+        }
+        return card.hasSuspend() ? "suspend" : null;
+    }
+
+    List<Map<String, Object>> view() {
+        settleDamage();
+        settleDraws();
+        settleMoves();
+        final List<Map<String, Object>> events = new ArrayList<>(ring.size());
+        for (final Entry entry : ring) {
+            final Map<String, Object> event = new LinkedHashMap<>();
+            event.put("id", "event-" + entry.seq);
+            event.put("seq", entry.seq);
+            if (entry.damage) {
+                if (putDamage(event, entry)) {
+                    events.add(event);
+                }
+                continue;
+            }
+            final Integer parityId = entry.visible ? ParityCardMap.knownParityId(entry.cardId) : null;
+            if (parityId != null) {
+                event.put("cardId", "engine-card-" + parityId);
+            }
+            if (entry.from != null) {
+                event.put("from", entry.from.name());
+            }
+            event.put("to", entry.to.name());
+            event.put("ownerId", "player-" + entry.owner);
+            if (entry.how != null) {
+                event.put("how", entry.how);
+            }
+            if (entry.cause != null) {
+                event.put("cause", entry.cause);
+            }
+            if (entry.causeName != null) {
+                event.put("causeName", entry.causeName);
+                final Integer causeParityId = ParityCardMap.knownParityId(entry.causeCardId);
+                if (causeParityId != null) {
+                    event.put("causeCardId", "engine-card-" + causeParityId);
+                }
+            }
+            events.add(event);
+        }
+        return events;
+    }
+
+    private static boolean putDamage(final Map<String, Object> event, final Entry entry) {
+        event.put("kind", "damage");
+        event.put("to", "Damage");
+        event.put("ownerId", "player-" + entry.owner);
+        putCardId(event, "sourceCardId", entry.sourceCardId);
+        putCardId(event, "targetCardId", entry.targetCardId);
+        if (entry.targetPlayer >= 0) {
+            event.put("targetPlayerId", "player-" + entry.targetPlayer);
+        }
+        event.put("amount", entry.amount);
+        event.put("combat", entry.combat);
+        return event.containsKey("targetCardId") || event.containsKey("targetPlayerId");
+    }
+
+    private static void putCardId(final Map<String, Object> event, final String key, final int cardId) {
+        final Integer parityId = cardId == 0 ? null : ParityCardMap.knownParityId(cardId);
+        if (parityId != null) {
+            event.put(key, "engine-card-" + parityId);
+        }
+    }
+}
