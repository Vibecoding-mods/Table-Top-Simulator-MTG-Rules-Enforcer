+        check("optionalExactCountWithTooFewCardsDeclines", OptionalCardChoiceTest::optionalExactCountWithTooFewCardsDeclines);
+        check("optionalExactCountCancelDeclines", OptionalCardChoiceTest::optionalExactCountCancelDeclines);
+        check("optionalExactCountCancelInACancellableCostCancelsThePayment", OptionalCardChoiceTest::optionalExactCountCancelInACancellableCostCancelsThePayment);
+        check("optionalExactCountTakesTheFullCount", OptionalCardChoiceTest::optionalExactCountTakesTheFullCount);
+        check("optionalSingleCardStillAllowsNone", OptionalCardChoiceTest::optionalSingleCardStillAllowsNone);
+        check("mandatoryExactCountIsAskedWithoutCancel", OptionalCardChoiceTest::mandatoryExactCountIsAskedWithoutCancel);
+        check("mandatoryExactCountStillRefusesTooFewCards", OptionalCardChoiceTest::mandatoryExactCountStillRefusesTooFewCards);
