@@ -0,0 +1,156 @@
+package forge.harness.host;
+
+import forge.StaticData;
+import forge.game.Game;
+import forge.card.CardType;
+import forge.game.GameRules;
+import forge.game.GameType;
+import forge.game.card.Card;
+import forge.game.player.Player;
+import forge.game.player.RegisteredPlayer;
+import forge.game.zone.ZoneType;
+import forge.harness.common.SnapshotExtractor;
+import forge.harness.host.ManaBrewEngineAdapter.CardIdentity;
+import forge.harness.host.ManaBrewEngineAdapter.PlayerConfig;
+import forge.harness.host.ManaBrewEngineAdapter.StartGameRequest;
+import forge.item.PaperCard;
+
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+final class Archenemy {
+    static final int MIN_SCHEMES = 20;
+    static final int MAX_COPIES = 2;
+    static final int ARCHENEMY_TEAM = 1;
+    static final int OPPONENTS_TEAM = 2;
+
+    private Archenemy() {}
+
+    static boolean isArchenemyGame(final Game game) {
+        return game.getRules().hasAppliedVariant(GameType.Archenemy);
+    }
+
+    static boolean isArchenemyGame(final StartGameRequest request, final List<List<PaperCard>> schemeDecks) {
+        return request.isArchenemy() || any(schemeDecks);
+    }
+
+    static List<List<PaperCard>> schemeDecks(final StartGameRequest request) {
+        final List<List<PaperCard>> decks = new ArrayList<>();
+        final List<String> archenemies = new ArrayList<>();
+        for (final PlayerConfig player : request.getPlayers()) {
+            final List<PaperCard> deck = new ArrayList<>();
+            for (final CardIdentity card : player.getSchemes()) {
+                deck.add(schemeCard(card.getName()));
+            }
+            if (!deck.isEmpty()) {
+                archenemies.add(player.getName());
+            }
+            decks.add(deck);
+        }
+        if (request.isArchenemy() && archenemies.isEmpty()) {
+            throw new IllegalArgumentException("an Archenemy game needs one player with a scheme deck: the archenemy");
+        }
+        if (archenemies.size() > 1) {
+            throw new IllegalArgumentException("an Archenemy game has one archenemy, but " + String.join(", ", archenemies)
+                    + " each brought a scheme deck");
+        }
+        if (!archenemies.isEmpty() && ManaBrewEngineAdapter.isSharedLife(request.getTeamRules())) {
+            throw new IllegalArgumentException("Archenemy plays with each player's own life and turns, not "
+                    + request.getTeamRules());
+        }
+        for (int i = 0; i < decks.size(); i++) {
+            checkDeck(request.getPlayers().get(i).getName(), decks.get(i));
+        }
+        return decks;
+    }
+
+    private static void checkDeck(final String player, final List<PaperCard> deck) {
+        if (deck.isEmpty()) {
+            return;
+        }
+        if (deck.size() < MIN_SCHEMES) {
+            throw new IllegalArgumentException(player + "'s scheme deck has " + deck.size()
+                    + " schemes; it needs at least " + MIN_SCHEMES);
+        }
+        final Map<String, Integer> copies = new LinkedHashMap<>();
+        for (final PaperCard card : deck) {
+            copies.merge(card.getName(), 1, Integer::sum);
+        }
+        for (final Map.Entry<String, Integer> entry : copies.entrySet()) {
+            if (entry.getValue() > MAX_COPIES) {
+                throw new IllegalArgumentException(player + "'s scheme deck has " + entry.getValue() + " copies of "
+                        + entry.getKey() + "; a scheme deck holds at most " + MAX_COPIES + " of each");
+            }
+        }
+    }
+
+    static List<Map<String, Object>> schemesInMotion(final Player player) {
+        final List<Map<String, Object>> schemes = new ArrayList<>();
+        for (final Card card : player.getCardsIn(ZoneType.Command)) {
+            if (card.isScheme()) {
+                final Map<String, Object> scheme = new LinkedHashMap<>();
+                scheme.put("id", SnapshotExtractor.javaCardId(card));
+                scheme.put("name", card.getName());
+                scheme.put("ongoing", card.getType().hasSupertype(CardType.Supertype.Ongoing));
+                schemes.add(scheme);
+            }
+        }
+        return schemes;
+    }
+
+    static boolean any(final List<List<PaperCard>> schemeDecks) {
+        for (final List<PaperCard> deck : schemeDecks) {
+            if (!deck.isEmpty()) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    static void firstPlayer(final GameRules rules, final List<List<PaperCard>> schemeDecks) {
+        if (rules.getStartingPlayer() >= 0) {
+            return;
+        }
+        for (int i = 0; i < schemeDecks.size(); i++) {
+            if (!schemeDecks.get(i).isEmpty()) {
+                rules.setStartingPlayer(i);
+                return;
+            }
+        }
+    }
+
+    static void giveSchemes(final RegisteredPlayer player, final List<PaperCard> schemes) {
+        if (!schemes.isEmpty()) {
+            player.setSchemes(schemes);
+        }
+    }
+
+    static void seat(final RegisteredPlayer player, final PlayerConfig config, final List<PaperCard> schemes,
+            final boolean archenemyGame, final GameType gameType) {
+        if (!archenemyGame) {
+            return;
+        }
+        player.setTeamNumber(schemes.isEmpty() ? OPPONENTS_TEAM : ARCHENEMY_TEAM);
+        if (!schemes.isEmpty() && config.getStartingLife() == null) {
+            player.setStartingLife(startingLife(gameType));
+        }
+    }
+
+    static int startingLife(final GameType gameType) {
+        return gameType == GameType.Commander ? 80 : 40;
+    }
+
+    private static PaperCard schemeCard(final String name) {
+        PaperCard card = StaticData.instance().fetchCard(name);
+        if (card == null) {
+            StaticData.instance().attemptToLoadCard(name);
+            card = StaticData.instance().fetchCard(name);
+        }
+        if (card == null || !card.getRules().getType().isScheme()) {
+            throw new IllegalArgumentException("no scheme named " + name);
+        }
+        return card;
+    }
+}
