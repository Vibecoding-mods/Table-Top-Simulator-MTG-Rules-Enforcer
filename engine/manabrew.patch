+        final Card card = Card.fromPaperCard(paper, p);
+        card.setGameTimestamp(p.getGame().getNextTimestamp());
+        p.getZone(zone).add(card);
+        return card;
+    }
+
+    private static final class Fixture {
+        final ManaBrewInteractiveSession session = new ManaBrewInteractiveSession("attack-tax-lethal-test");
+        final Game game;
+        final Player white;
+        final Player ai;
+        final ReentrantLock lock;
+
+        Fixture(final GameType type) throws Exception {
+            final List<RegisteredPlayer> players = new ArrayList<>();
+            final Deck deck = new Deck();
+            players.add(new RegisteredPlayer(deck).setPlayer(new ManaBrewInteractiveLobbyPlayer("White", session)));
+            players.add(new RegisteredPlayer(deck).setPlayer(new LobbyPlayerAi("AI 1", null)));
+            final GameRules rules = new GameRules(type);
+            rules.setAppliedVariants(EnumSet.of(type));
+            game = new Game(players, rules, new Match(rules, players, "AttackTaxLethalTest"));
+            game.setAge(GameStage.Play);
+            white = game.getPlayers().get(0);
+            ai = game.getPlayers().get(1);
+            game.getPhaseHandler().devModeSet(PhaseType.COMBAT_DECLARE_ATTACKERS, white);
+            session.attach(game.getMatch(), game, Set.of(), false);
+            final Field field = ManaBrewInteractiveSession.class.getDeclaredField("gameLock");
+            field.setAccessible(true);
+            lock = (ReentrantLock) field.get(session);
+        }
+
+        Combat combat() {
+            return game.getPhaseHandler().getCombat();
+        }
+
+        JsonObject attackPrompt() throws Exception {
+            final Combat combat = new Combat(white);
+            game.getPhaseHandler().setCombat(combat);
+            final Method publish = ManaBrewInteractiveSession.class.getDeclaredMethod(
+                    "publishAttackersPrompt", int.class, Combat.class, List.class);
+            publish.setAccessible(true);
+            publish.invoke(session, SnapshotExtractor.playerIndex(game, white), combat,
+                    CombatChoiceSpace.legalAttackers(white, combat));
+            return JsonParser.parseString(session.getLatestPromptJson()).getAsJsonObject().getAsJsonObject("input");
+        }
+
+        List<String> declareAndPay(final List<Card> declared, final Set<Card> refuse) throws Exception {
+            game.getPhaseHandler().setCombat(new Combat(white));
+            final Method declare = PhaseHandler.class.getDeclaredMethod("declareAttackersTurnBasedAction");
+            declare.setAccessible(true);
+            final Throwable[] failure = new Throwable[1];
+            final Thread thread = new Thread(() -> {
+                lock.lock();
+                try {
+                    declare.invoke(game.getPhaseHandler());
+                } catch (final Throwable thrown) {
+                    failure[0] = thrown;
+                } finally {
+                    lock.unlock();
+                }
+            }, "declare-attackers");
+            thread.setDaemon(true);
+            thread.start();
+            final List<String> paymentsFor = new ArrayList<>();
+            final String ai = "player-" + SnapshotExtractor.playerIndex(game, this.ai);
+            long seen = -1;
+            boolean sent = false;
+            final long deadline = System.currentTimeMillis() + 60_000;
+            while (thread.isAlive() && System.currentTimeMillis() < deadline) {
+                final String json = session.getLatestPromptJson();
+                final JsonObject prompt = json == null ? null : JsonParser.parseString(json).getAsJsonObject();
+                if (prompt == null || prompt.get("promptId").getAsLong() == seen) {
+                    Thread.sleep(10);
+                    continue;
+                }
+                seen = prompt.get("promptId").getAsLong();
+                final JsonObject input = prompt.getAsJsonObject("input");
+                final String type = input.get("type").getAsString();
+                if ("chooseAttackers".equals(type)) {
+                    expect(!sent, "the attack was asked again: " + input);
+                    sent = true;
+                    final StringBuilder assignments = new StringBuilder();
+                    for (final Card c : declared) {
+                        assignments.append(assignments.length() == 0 ? "" : ",").append("{\"attackerId\":\"")
+                                .append(SnapshotExtractor.javaCardId(c)).append("\",\"targetId\":\"").append(ai).append("\"}");
+                    }
+                    session.submitAction("{\"type\":\"chooseAttackers\",\"output\":{\"type\":\"declareAttackers\",\"assignments\":["
+                            + assignments + "]}}");
+                } else if ("payManaCost".equals(type)) {
+                    final String cardId = input.has("cardId") ? input.get("cardId").getAsString() : "";
+                    final boolean confirm = input.has("canConfirmFromPool") && input.get("canConfirmFromPool").getAsBoolean();
+                    final boolean again = !paymentsFor.isEmpty() && paymentsFor.get(paymentsFor.size() - 1).equals(cardId);
+                    if (!again) {
+                        paymentsFor.add(cardId);
+                    }
+                    final boolean refused = refuse.stream().anyMatch(c -> SnapshotExtractor.javaCardId(c).equals(cardId));
+                    final String output = confirm ? "{\"type\":\"pay\",\"auto\":false}"
+                            : refused || again ? "{\"type\":\"cancel\"}" : "{\"type\":\"pay\",\"auto\":true}";
+                    session.submitAction("{\"type\":\"payManaCost\",\"output\":" + output + "}");
+                } else {
+                    session.submitAction("{\"type\":\"" + type + "\",\"output\":{\"type\":\"pass\"}}");
+                }
+            }
+            thread.join(5_000);
+            if (failure[0] != null) {
+                throw new AssertionError("declaring attackers failed", failure[0]);
+            }
+            expect(!thread.isAlive(), "declaring attackers did not finish");
+            return paymentsFor;
+        }
+    }
+}
