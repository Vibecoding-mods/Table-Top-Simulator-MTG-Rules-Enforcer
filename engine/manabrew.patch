+
+    static final class Way {
+        final ManaCost mana;
+        final String mode;
+        final String name;
+        final String printed;
+
+        Way(final ManaCost mana, final String mode, final String name, final String printed) {
+            this.mana = mana;
+            this.mode = mode;
+            this.name = name;
+            this.printed = printed;
+        }
+
+        String cost() {
+            return text(mana);
+        }
+
+        SpellCostDto dto() {
+            return new SpellCostDto(name, cost(), printed, mode);
+        }
+    }
+
+    static final class Result {
+        final Way pick;
+        final List<Way> others;
+
+        Result(final Way pick, final List<Way> others) {
+            this.pick = pick;
+            this.others = others;
+        }
+    }
+
+    static Result of(final Card card, final Player viewer) {
+        try {
+            if (card.isLand() || card.getZone() == null) {
+                return null;
+            }
+            final boolean hidden = card.isFaceDown() && card.isInZone(ZoneType.Exile);
+            final CardState face = hidden ? card.getState(CardStateName.Original) : card.getCurrentState();
+            final boolean halves = card.isSplitCard() || card.isAdventureCard();
+            final String cardName = face.getName();
+            final String cardPrinted = text(face.getManaCost());
+            final List<Way> ways = new ArrayList<>();
+            final List<CardPlayOption> mayPlay = card.mayPlay(viewer);
+            boolean paidPermission = false;
+            for (final CardPlayOption option : mayPlay) {
+                if (option.getPayManaCost() == CardPlayOption.PayManaCost.NO) {
+                    ways.add(new Way(ManaCost.ZERO, "free", cardName, cardPrinted));
+                } else if (option.getAltManaCost() != null && option.getAltManaCost().getCostMana() != null) {
+                    ways.add(new Way(option.getAltManaCost().getCostMana().getMana(), "may play", cardName, cardPrinted));
+                } else {
+                    paidPermission = true;
+                }
+            }
+            for (final SpellAbility sa : spellsOf(card, face, viewer)) {
+                final AlternativeCost alt = sa.getAlternativeCost();
+                final String name = halves ? sa.getCardState().getName() : cardName;
+                final String printed = halves ? text(sa.getCardState().getManaCost()) : cardPrinted;
+                final ZoneType zone = sa.getRestrictions() == null ? null : sa.getRestrictions().getZone();
+                String mode = null;
+                if (alt != null) {
+                    if (zone != null && card.isInZone(zone)) {
+                        mode = alt.name().toLowerCase(Locale.ROOT);
+                    }
+                } else if (paidPermission) {
+                    mode = "may play";
+                } else if (zone != null && zone != ZoneType.Hand && card.isInZone(zone)) {
+                    mode = sa.isAftermath() ? "aftermath" : "cast";
+                }
+                if (mode == null) {
+                    continue;
+                }
+                final ManaCost mana = mana(sa, viewer);
+                if (mana != null) {
+                    ways.add(new Way(mana, mode, name, printed));
+                }
+            }
+            if (ways.isEmpty()) {
+                return null;
+            }
+            Way pick = ways.get(0);
+            for (final Way w : ways) {
+                if (w.mana.getCMC() < pick.mana.getCMC()) {
+                    pick = w;
+                }
+            }
+            final List<Way> others = new ArrayList<>();
+            final List<String> seen = new ArrayList<>();
+            seen.add(pick.mode + "|" + pick.name + "|" + pick.cost());
+            for (final Way w : ways) {
+                final String key = w.mode + "|" + w.name + "|" + w.cost();
+                if (!seen.contains(key)) {
+                    seen.add(key);
+                    others.add(w);
+                }
+            }
+            return new Result(pick, others);
+        } catch (final RuntimeException error) {
+            return null;
+        }
+    }
+
+    static List<SpellCostDto> halves(final Card card, final Player viewer) {
+        try {
+            if (card.isLand() || !(card.isSplitCard() || card.isAdventureCard()) || viewer == null) {
+                return null;
+            }
+            final List<SpellCostDto> out = new ArrayList<>();
+            boolean changed = false;
+            final List<SpellAbility> spells = new ArrayList<>();
+            for (final SpellAbility sa : card.getCurrentState().getSpellAbilities()) {
+                spells.add(sa);
+            }
+            if (card.isAdventureCard()) {
+                spells.addAll(card.getState(CardStateName.Secondary).getSpellAbilities());
+            }
+            for (final SpellAbility sa : spells) {
+                if (!castableSpell(card, sa) || sa.getAlternativeCost() != null) {
+                    continue;
+                }
+                final ZoneType zone = sa.getRestrictions() == null ? null : sa.getRestrictions().getZone();
+                if (zone != null && !card.isInZone(zone)) {
+                    continue;
+                }
+                final ManaCost mana = mana(sa, viewer);
+                if (mana == null) {
+                    continue;
+                }
+                final String printed = text(sa.getCardState().getManaCost());
+                final String now = text(mana);
+                changed |= !now.equals(printed);
+                out.add(new SpellCostDto(sa.getCardState().getName(), now, printed, null));
+            }
+            return changed ? out : null;
+        } catch (final RuntimeException error) {
+            return null;
+        }
+    }
+
+    private static List<SpellAbility> spellsOf(final Card card, final CardState face, final Player viewer) {
+        final List<SpellAbility> bases = new ArrayList<>();
+        for (final SpellAbility sa : face.getSpellAbilities()) {
+            bases.add(sa);
+        }
+        if (card.isAdventureCard() && !card.isOnAdventure()) {
+            bases.addAll(card.getState(CardStateName.Secondary).getSpellAbilities());
+        }
+        final List<SpellAbility> out = new ArrayList<>();
+        for (final SpellAbility base : bases) {
+            if (castableSpell(card, base)) {
+                out.add(base);
+            }
+            for (final SpellAbility alt : GameActionUtil.getAlternativeCosts(base, viewer, false)) {
+                if (castableSpell(card, alt)) {
+                    out.add(alt);
+                }
+            }
+        }
+        return out;
+    }
+
+    private static boolean castableSpell(final Card card, final SpellAbility sa) {
+        if (!sa.isSpell() || sa.isCastFaceDown() || sa.getPayCosts() == null) {
+            return false;
+        }
+        return !(card.isSplitCard() && sa.getCardState() != null && sa.getCardState().getStateName() == CardStateName.Original);
+    }
+
+    static String text(final ManaCost mana) {
+        final String s = mana == null ? "" : mana.toString();
+        return s.isEmpty() || s.equals("no cost") ? "{0}" : s;
+    }
+
+    static ManaCost mana(final SpellAbility sa, final Player viewer) {
+        final Player previous = sa.getActivatingPlayer();
+        final Card host = sa.getHostCard();
+        final CardStateName was = host == null ? null : host.getCurrentStateName();
+        final CardStateName want = sa.getCardState() == null ? null : sa.getCardState().getStateName();
+        final boolean flip = host != null && !host.isFaceDown() && want != null && was != want
+                && (host.isSplitCard() || host.isAdventureCard()) && host.getStates().contains(want);
+        try {
+            sa.setActivatingPlayer(viewer);
+            if (flip) {
+                host.setState(want, false);
+            }
+            final Cost adjusted = CostAdjustment.adjust(sa.getPayCosts().copy(), sa, false);
+            if (adjusted == null) {
+                return null;
+            }
+            final ManaCost raised = adjusted.getCostMana() == null ? ManaCost.ZERO : adjusted.getCostMana().getMana();
+            if (choosesToReduce(sa)) {
+                return raised;
+            }
+            final ManaCostBeingPaid paying = new ManaCostBeingPaid(raised);
+            if (!CostAdjustment.adjust(paying, sa, viewer, new CardCollection(), true, false)) {
+                return raised;
+            }
+            return paying.toManaCost();
+        } finally {
+            if (flip) {
+                host.setState(was, false);
+            }
+            sa.setActivatingPlayer(previous);
+        }
+    }
+
+    private static boolean choosesToReduce(final SpellAbility sa) {
+        final Card host = sa.getHostCard();
+        if (host == null) {
+            return true;
+        }
+        for (final Keyword keyword : new Keyword[] {Keyword.ASSIST, Keyword.DELVE, Keyword.CONVOKE, Keyword.IMPROVISE}) {
+            if (host.hasKeyword(keyword)) {
+                return true;
+            }
+        }
+        final Integer waterbend = sa.getMaxWaterbend();
+        return sa.hasParam("TapCreaturesForMana") || (waterbend != null && waterbend > 0) || sa.isOffering() || sa.isEmerge();
+    }
+}
