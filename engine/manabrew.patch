+            throw new AssertionError("Forge's own count changed: " + f.blue.getExtraTurnCount());
+        }
+    }
+
+    private static void countsARepeatedPlayerAcrossTheQueue() {
+        final Fixture f = new Fixture();
+        f.handler.addExtraTurn(f.white);
