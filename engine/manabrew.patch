+                "the active team kept " + f.white.getCardsIn(ZoneType.Hand).size() + " + " + f.red.getCardsIn(ZoneType.Hand).size() + " cards, not 7 + 7");
+        expect(f.yellow.getCardsIn(ZoneType.Hand).size() == 9, "the other team discarded");
+        final Fixture l1 = new Fixture(false);
+        fillHands(l1, 9);
+        l1.game.getPhaseHandler().devModeSet(PhaseType.END_OF_TURN, l1.white, 5);
+        stepTo(l1, PhaseType.CLEANUP);
+        expect(l1.white.getCardsIn(ZoneType.Hand).size() == 7 && l1.red.getCardsIn(ZoneType.Hand).size() == 9,
+                "level 1: Red discarded in White's cleanup: " + l1.red.getCardsIn(ZoneType.Hand).size());
+    }
