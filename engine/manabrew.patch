+            }
+            session.attach(game.getMatch(), game, Set.of(), false);
+            final Field lock = ManaBrewInteractiveSession.class.getDeclaredField("gameLock");
+            lock.setAccessible(true);
+            ((ReentrantLock) lock.get(session)).lock();
+        }
+
+        JsonArray ids(final int count) {
+            final JsonArray ids = new JsonArray();
+            for (int i = 0; i < count; i++) {
+                ids.add(SnapshotExtractor.javaCardId(graveyard.get(i)));
+            }
+            return ids;
+        }
+
+        void answer(final JsonArray ids) {
+            final JsonObject output = new JsonObject();
+            output.addProperty("type", "chooseCardsDecision");
+            output.add("chosenCardIds", ids);
+            final JsonObject action = new JsonObject();
+            action.addProperty("type", "chooseCards");
+            action.add("output", output);
+            submit(action.toString());
+        }
+
+        void submit(final String actionJson) {
+            session.submitAction(actionJson);
+        }
+
+        CardCollection forage(final boolean optional) {
+            return choose(3, optional, false);
+        }
+
+        CardCollection choose(final int count, final boolean optional, final boolean cancellable) {
+            return session.awaitCardChoice(
+                    "choose_cards_for_effect", 0, new CardCollection(graveyard), count, count,
+                    "Treetop Sentries", null, "Choose three cards to exile", optional, null, cancellable);
+        }
+
+        JsonObject promptInput() {
+            return JsonParser.parseString(session.getLatestPromptJson()).getAsJsonObject().getAsJsonObject("input");
+        }
+    }
+
+    private static Game newGame() {
+        final List<RegisteredPlayer> players = new ArrayList<>();
+        final Deck deck = new Deck();
+        players.add(new RegisteredPlayer(deck).setPlayer(new LobbyPlayerAi("p1", null)));
+        players.add(new RegisteredPlayer(deck).setPlayer(new LobbyPlayerAi("p2", null)));
+        final GameRules rules = new GameRules(GameType.Constructed);
+        final Game game = new Game(players, rules, new Match(rules, players, "OptionalCardChoiceTest"));
+        game.setAge(GameStage.Play);
+        game.getPhaseHandler().devModeSet(PhaseType.MAIN1, game.getPlayers().get(0));
+        game.getPhaseHandler().onStackResolved();
+        return game;
+    }
+
+    private static Card add(final String name, final Player p, final ZoneType zone) {
+        IPaperCard paper = FModel.getMagicDb().getCommonCards().getCard(name);
+        if (paper == null) {
+            StaticData.instance().attemptToLoadCard(name);
+            paper = FModel.getMagicDb().getCommonCards().getCard(name);
+        }
+        final Card card = Card.fromPaperCard(paper, p);
+        card.setGameTimestamp(p.getGame().getNextTimestamp());
+        p.getZone(zone).add(card);
+        return card;
+    }
+}
