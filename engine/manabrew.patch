+        });
+        Game.setRunawayCardsPerTurnCap(0);
+        Game.setRunawayTriggersPerTurnCap(0);
+        check("aMixedReplacementBoardEndsTheSameBothWays", ReplacementIndexTest::aMixedReplacementBoardEndsTheSameBothWays);
+        check("leavingReplacementsComeFromTheLastState", ReplacementIndexTest::leavingReplacementsComeFromTheLastState);
+        check("manyTokensAreNoSlowerWithTheIndex", ReplacementIndexTest::manyTokensAreNoSlowerWithTheIndex);
+        ReplacementHandler.useLastStateIndex = true;
+        System.out.println(failed == 0 ? "PASS ReplacementIndexTest" : "FAIL ReplacementIndexTest: " + failed + " failed");
+        System.exit(failed == 0 ? 0 : 1);
+    }
+
+    private interface Check {
+        void run() throws Exception;
+    }
+
+    private static int failed;
+
+    private static void check(final String name, final Check check) {
+        try {
+            check.run();
+            System.out.println("ok " + name);
+        } catch (final Throwable failure) {
+            failed++;
+            System.out.println("FAIL " + name + ": " + failure);
+        }
+    }
+
+    private static void aMixedReplacementBoardEndsTheSameBothWays() {
+        ReplacementHandler.useLastStateIndex = false;
+        final String linear = mixedBoard();
+        ReplacementHandler.useLastStateIndex = true;
+        final String indexed = mixedBoard();
+        expect(linear.equals(indexed), "the board ends differently:\n linear  " + linear + "\n indexed " + indexed);
+        System.out.println("metric mixed board: " + indexed);
+    }
+
+    private static void leavingReplacementsComeFromTheLastState() {
+        ReplacementHandler.useLastStateIndex = true;
+        final String run = mixedBoard();
+        final String wiped = run.substring(run.indexOf("|| after the wipe: "), run.indexOf("|| after a mill: "));
+        final String milled = run.substring(run.indexOf("|| after a mill: "));
+        expect(wiped.contains("White battlefield {} graveyard {}") && wiped.contains("Blue battlefield {} graveyard {}"),
+                "with Rest in Peace and Leyline of the Void destroyed in the same wipe, cards still reached a graveyard: " + wiped);
+        expect(wiped.contains("Rest in Peace=1") && wiped.contains("Leyline of the Void=1") && wiped.contains("Serra Angel=3"),
+                "the wipe's cards are not in exile: " + wiped);
+        expect(milled.contains("graveyard {Forest=1, Grizzly Bears=1}"), "once both were gone, a mill still exiled: " + milled);
+    }
+
+    private static void manyTokensAreNoSlowerWithTheIndex() {
+        final StringBuilder out = new StringBuilder();
+        for (final int n : new int[] {1000, 2500}) {
+            ReplacementHandler.useLastStateIndex = false;
+            final long linear = tokens(n);
+            ReplacementHandler.useLastStateIndex = true;
+            final long indexed = tokens(n);
+            out.append(n).append(" tokens: linear ").append(linear).append(" ms, indexed ").append(indexed).append(" ms; ");
+            expect(indexed <= linear * 5 / 4 + 200, n + " tokens took " + indexed + " ms with the index, " + linear + " ms without");
+            expect(indexed < 120_000, n + " tokens took " + indexed + " ms");
+        }
+        System.out.println("metric tokens: " + out);
+    }
+
+    private static String mixedBoard() {
+        final Fixture f = new Fixture();
+        for (final String name : new String[] {"Doubling Season", "Anointed Procession", "Parallel Lives", "Hardened Scales", "Master Chef", "Rest in Peace"}) {
+            f.add(name, f.white, ZoneType.Battlefield);
+        }
+        final Card commander = f.add("Grizzly Bears", f.white, ZoneType.Battlefield);
+        commander.setCommander(true);
+        f.white.addCommander(commander);
+        f.add("Leyline of the Void", f.blue, ZoneType.Battlefield);
+        f.add("Hardened Scales", f.blue, ZoneType.Battlefield);
+        for (int i = 0; i < 3; i++) {
+            f.add("Serra Angel", f.blue, ZoneType.Battlefield);
+            f.add("Grizzly Bears", f.white, ZoneType.Battlefield);
+        }
+        for (final Player p : f.game.getPlayers()) {
+            for (int i = 0; i < 12; i++) {
+                f.add(i % 2 == 0 ? "Grizzly Bears" : "Forest", p, ZoneType.Library);
+            }
+        }
+        f.game.getAction().checkStaticAbilities();
+        f.resolve("DB$ Token | TokenAmount$ 3 | TokenScript$ c_1_1_a_servo", f.white);
+        f.resolve("DB$ Token | TokenAmount$ 2 | TokenScript$ g_1_1_saproling", f.blue);
+        f.resolve("DB$ PutCounterAll | ValidCards$ Creature | CounterType$ P1P1 | CounterNum$ 1", f.white);
+        f.resolve("DB$ Mill | Defined$ Player | NumCards$ 4", f.white);
+        final String before = f.outcome();
+        f.resolve("DB$ DestroyAll | ValidCards$ Permanent.nonLand", f.blue);
+        final String wiped = f.outcome();
+        f.resolve("DB$ Mill | Defined$ Player | NumCards$ 2", f.blue);
+        return "before the wipe: " + before + " || after the wipe: " + wiped + " || after a mill: " + f.outcome();
+    }
+
+    private static final String[] TOKEN_PILES = {
+        "c_1_1_a_servo", "g_1_1_saproling", "w_1_1_soldier", "r_1_1_goblin", "b_2_2_zombie", "u_1_1_bird_flying"};
+
+    private static long tokens(final int n) {
+        final Fixture f = new Fixture();
+        for (int i = 0; i < 40; i++) {
+            f.add("Forest", f.white, ZoneType.Battlefield);
+        }
+        // (big-turns-2: one pile or one effect makes at most Game.UNBOUNDED_TOKENS, so n comes as piles of up to that
+        // many, one effect each, of different tokens)
+        final long started = System.nanoTime();
+        int left = n;
+        for (int p = 0; left > 0; p++) {
+            final int amount = Math.min(left, Game.UNBOUNDED_TOKENS);
+            f.resolve("DB$ Token | TokenAmount$ " + amount + " | TokenScript$ " + TOKEN_PILES[p], f.white);
+            left -= amount;
+        }
+        final long took = (System.nanoTime() - started) / 1_000_000;
+        expect(f.white.getCardsIn(ZoneType.Battlefield).size() == n + 40, n + " tokens made " + (f.white.getCardsIn(ZoneType.Battlefield).size() - 40));
+        return took;
+    }
+
+    private static void expect(final boolean condition, final String message) {
+        if (!condition) {
+            throw new AssertionError(message);
+        }
+    }
+
+    private static final class Fixture {
+        final Game game;
+        final Player white;
+        final Player blue;
+
+        Fixture() {
+            final List<RegisteredPlayer> players = new ArrayList<>();
+            players.add(new RegisteredPlayer(new Deck()).setPlayer(new LobbyPlayerAi("White", null)));
+            players.add(new RegisteredPlayer(new Deck()).setPlayer(new LobbyPlayerAi("Blue", null)));
+            final GameRules rules = new GameRules(GameType.Constructed);
+            game = new Game(players, rules, new Match(rules, players, "ReplacementIndexTest"));
+            game.setAge(GameStage.Play);
+            white = game.getPlayers().get(0);
+            blue = game.getPlayers().get(1);
+            game.getPhaseHandler().devModeSet(PhaseType.MAIN1, white, 2);
+            game.getPhaseHandler().onStackResolved();
+        }
+
+        Card add(final String name, final Player p, final ZoneType zone) {
+            IPaperCard paper = FModel.getMagicDb().getCommonCards().getCard(name);
+            if (paper == null) {
+                StaticData.instance().attemptToLoadCard(name);
+                paper = FModel.getMagicDb().getCommonCards().getCard(name);
+            }
+            final Card card = Card.fromPaperCard(paper, p);
+            card.setGameTimestamp(game.getNextTimestamp());
+            card.setSickness(false);
+            p.getZone(zone).add(card);
+            return card;
+        }
+
+        void resolve(final String script, final Player activator) {
+            final Card host = add("Island", activator, ZoneType.Command);
+            final SpellAbility sa = AbilityFactory.getAbility(script, host);
+            sa.setActivatingPlayer(activator);
+            AbilityUtils.resolve(sa);
+            game.getAction().checkStateEffects(true);
+            host.getZone().remove(host);
+        }
+
+        String outcome() {
+            final StringBuilder out = new StringBuilder();
+            for (final Player p : game.getPlayers()) {
+                out.append(p.getName()).append(" battlefield ").append(names(p.getCardsIn(ZoneType.Battlefield), true))
+                        .append(" graveyard ").append(names(p.getCardsIn(ZoneType.Graveyard), false))
+                        .append(" exile ").append(names(p.getCardsIn(ZoneType.Exile), false))
+                        .append(" library ").append(p.getCardsIn(ZoneType.Library).size())
+                        .append(" life ").append(p.getLife()).append("; ");
+            }
+            return out.toString();
+        }
+
+        private static String names(final Iterable<Card> cards, final boolean counters) {
+            final Map<String, Integer> count = new TreeMap<>();
+            for (final Card c : cards) {
+                final StringBuilder key = new StringBuilder(c.getName());
+                if (counters) {
+                    for (final Map.Entry<CounterType, Integer> e : new TreeMap<>(asNames(c.getCounters())).entrySet()) {
+                        key.append(" ").append(e.getKey()).append("=").append(e.getValue());
+                    }
+                }
+                count.merge(key.toString(), 1, Integer::sum);
+            }
+            return count.toString();
+        }
+
+        private static Map<CounterType, Integer> asNames(final com.google.common.collect.Multiset<CounterType> counters) {
+            final Map<CounterType, Integer> out = new TreeMap<>((a, b) -> a.toString().compareTo(b.toString()));
+            for (final CounterType t : counters.elementSet()) {
+                out.put(t, counters.count(t));
+            }
+            return out;
+        }
+    }
+}
