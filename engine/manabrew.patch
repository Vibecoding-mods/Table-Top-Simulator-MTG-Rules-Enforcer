+
+    #[test]
+    fn keeps_the_archenemy_fields_of_a_java_player() {
+        let player: PlayerDto = serde_json::from_str(PLAYER).expect("a Java player parses");
+        let value = serde_json::to_value(player).unwrap();
+        assert_eq!(value["isArchenemy"], true);
+        assert_eq!(value["schemeDeckCount"], 19);
+        assert_eq!(value["schemes"][0]["id"], "card-7");
+        assert_eq!(value["schemes"][0]["name"], "I Am Untouchable");
+        assert_eq!(value["schemes"][0]["ongoing"], true);
+    }
+
+    #[test]
+    fn leaves_the_archenemy_fields_out_of_other_games() {
+        let plain = r#"{"id":"player-0","name":"White","status":"playing","isHuman":true,"life":20,
+            "playerKeywords":[],"commanderCasts":{},"completedDungeons":[],"counters":{},"manaPool":{},"commanderDamage":{},
+            "hasCityBlessing":false,"hasEnduringStory":false,"ringLevel":0,"speed":0}"#;
+        let player: PlayerDto = serde_json::from_str(plain).expect("a plain player parses");
+        let value = serde_json::to_value(player).unwrap();
+        assert!(value.get("isArchenemy").is_none() && value.get("schemeDeckCount").is_none() && value.get("schemes").is_none(), "{value}");
