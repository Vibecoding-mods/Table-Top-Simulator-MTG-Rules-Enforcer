+    private static Combat attack(final Fixture f, final Player attacker, final Player defender, final Card... creatures) {
+        f.game.getPhaseHandler().devModeSet(PhaseType.COMBAT_DECLARE_ATTACKERS, attacker);
+        final Combat combat = new Combat(attacker);
+        for (final Card c : creatures) {
+            combat.addAttacker(c, defender);
+        }
+        f.game.getPhaseHandler().setCombat(combat);
+        return combat;
+    }
