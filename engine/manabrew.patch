+        f.session.awaitBooleanChoice("confirm_action", 1, "q", null, "confirm_action", null, null);
+        expectSeat(f.prompt(), "player-1", "an uncontrolled seat's question");
+        final long ts = f.game.getNextTimestamp();
+        f.human.addController(ts, f.human, f.human.getController(), false);
+        f.session.submitAction("{\"type\":\"chooseBoolean\",\"output\":{\"value\":true}}");
+        f.session.awaitBooleanChoice("confirm_action", 0, "q", null, "confirm_action", null, null);
+        expectSeat(f.prompt(), "player-0", "a seat run by its own temporary controller");
+    }
+
+    private static void aiControllerLeavesTheSeatAlone() throws Exception {
+        final Fixture f = new Fixture();
+        f.human.addController(f.game.getNextTimestamp(), f.ai);
+        f.session.submitAction("{\"type\":\"chooseBoolean\",\"output\":{\"value\":true}}");
+        f.session.awaitBooleanChoice("confirm_action", 0, "q", null, "confirm_action", null, null);
+        expectSeat(f.prompt(), "player-0", "a seat controlled by a Forge AI");
+    }
+
+    private static void nestedControlGoesToTheTopController() throws Exception {
+        final Fixture f = new Fixture(true);
+        f.green.addController(f.game.getNextTimestamp(), f.human, f.green.getController(), false);
+        f.ai.addController(f.game.getNextTimestamp(), f.green, f.ai.getController(), false);
+        expectSeat(f.askSeat(1), "player-0", "a question for the AI controlled by Green, who is controlled by White");
+        if (f.promptedSeat() != 0) {
+            throw new AssertionError("the answer is awaited from seat " + f.promptedSeat() + ", not White's seat 0");
+        }
+        expectSeat(f.askSeat(2), "player-0", "a question for Green, controlled by White");
+    }
+
+    private static void nestedControlStopsBelowAnAiController() throws Exception {
+        final Fixture f = new Fixture(true);
+        f.green.addController(f.game.getNextTimestamp(), f.human, f.green.getController(), false);
+        f.human.addController(f.game.getNextTimestamp(), f.ai);
+        if (!(f.human.getController() instanceof PlayerControllerAi)) {
+            throw new AssertionError("the Forge AI's control did not give White an AI controller: " + f.human.getController());
+        }
+        expectSeat(f.askSeat(2), "player-0", "a question for Green, controlled by White, who is controlled by a Forge AI");
+        expectSeat(f.askSeat(0), "player-0", "a question for White, controlled by a Forge AI");
+    }
+
+    private static void controlLoopStopsAtTheFirstRepeat() throws Exception {
+        final Fixture f = new Fixture(true);
+        f.green.addController(f.game.getNextTimestamp(), f.human, f.green.getController(), false);
+        f.human.addController(f.game.getNextTimestamp(), f.green, f.human.getController(), false);
+        expectSeat(f.askSeat(0), "player-2", "a question for White, controlled by Green, who is controlled by White");
+        expectSeat(f.askSeat(2), "player-0", "a question for Green, controlled by White, who is controlled by Green");
+    }
+
+    private static void aSeatWithNoPlayerKeepsItsId() throws Exception {
+        final Fixture f = new Fixture();
+        expectSeat(f.askSeat(2), "player-2", "a question for seat 2 of a two-player game");
+    }
+
+    private static void expectSeat(final JsonObject prompt, final String seat, final String what) {
+        final String actual = prompt.has("decidingPlayerId") ? prompt.get("decidingPlayerId").getAsString() : null;
+        if (!seat.equals(actual)) {
+            throw new AssertionError(what + " went to " + actual + ", not " + seat);
+        }
+    }
+
+    private static final class Fixture {
+        final ManaBrewInteractiveSession session = new ManaBrewInteractiveSession("mindslaver-control-test");
+        final Game game;
+        final Player human;
+        final Player ai;
+        final Player green;
+        final Card aiHand;
+
+        Fixture() throws Exception {
+            this(false);
+        }
+
+        Fixture(final boolean withGreen) throws Exception {
+            game = newGame(session, withGreen);
+            human = game.getPlayers().get(0);
+            ai = game.getPlayers().get(1);
+            green = withGreen ? game.getPlayers().get(2) : null;
+            aiHand = game.getAction().moveToHand(add("Plains", ai, ZoneType.Library), null);
+            session.attach(game.getMatch(), game, Set.of(), false);
+            final Field lock = ManaBrewInteractiveSession.class.getDeclaredField("gameLock");
+            lock.setAccessible(true);
+            ((ReentrantLock) lock.get(session)).lock();
+        }
+
+        JsonObject prompt() {
+            return JsonParser.parseString(session.getLatestPromptJson()).getAsJsonObject();
+        }
+
+        int promptedSeat() throws Exception {
+            final Field index = ManaBrewInteractiveSession.class.getDeclaredField("promptedPlayerIndex");
+            index.setAccessible(true);
+            return index.getInt(session);
+        }
+
+        JsonObject askSeat(final int seat) {
+            session.submitAction("{\"type\":\"chooseBoolean\",\"output\":{\"value\":true}}");
+            session.awaitBooleanChoice("confirm_action", seat, "q", null, "confirm_action", null, null);
+            return prompt();
+        }
+
+        String aiHandVisibility(final int viewer) {
+            final JsonObject view = JsonParser.parseString(session.getSnapshotJson(viewer)).getAsJsonObject();
+            for (final JsonElement zone : view.getAsJsonArray("zones")) {
+                final JsonObject z = zone.getAsJsonObject();
+                if ("hand".equals(z.get("zone").getAsString()) && "player-1".equals(z.get("ownerId").getAsString())) {
+                    for (final JsonElement card : z.getAsJsonArray("cards")) {
+                        if ("visible".equals(card.getAsJsonObject().get("visibility").getAsString())) {
+                            return "visible";
+                        }
+                    }
+                    return "hidden";
+                }
+            }
+            return "no zone";
+        }
+    }
+
+    private static Game newGame(final ManaBrewInteractiveSession session, final boolean withGreen) {
+        final List<RegisteredPlayer> players = new ArrayList<>();
+        final Deck deck = new Deck();
+        players.add(new RegisteredPlayer(deck).setPlayer(new ManaBrewInteractiveLobbyPlayer("White", session)));
+        players.add(new RegisteredPlayer(deck).setPlayer(new LobbyPlayerAi("AI 1", null)));
+        if (withGreen) {
+            players.add(new RegisteredPlayer(deck).setPlayer(new ManaBrewInteractiveLobbyPlayer("Green", session)));
+        }
+        final GameRules rules = new GameRules(GameType.Constructed);
+        final Game game = new Game(players, rules, new Match(rules, players, "MindslaverControlTest"));
+        game.setAge(GameStage.Play);
+        game.getPhaseHandler().devModeSet(PhaseType.MAIN1, game.getPlayers().get(0));
+        game.getPhaseHandler().onStackResolved();
+        return game;
+    }
+
+    private static Card add(final String name, final Player p, final ZoneType zone) {
+        IPaperCard paper = FModel.getMagicDb().getCommonCards().getCard(name);
+        if (paper == null) {
+            StaticData.instance().attemptToLoadCard(name);
+            paper = FModel.getMagicDb().getCommonCards().getCard(name);
+        }
+        final Card card = Card.fromPaperCard(paper, p);
+        card.setGameTimestamp(p.getGame().getNextTimestamp());
+        p.getZone(zone).add(card);
+        return card;
+    }
+}
