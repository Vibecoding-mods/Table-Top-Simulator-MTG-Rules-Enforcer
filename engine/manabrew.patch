+package forge.harness.host;
+
+import forge.ai.ComputerUtilAbility;
+import forge.ai.LobbyPlayerAi;
+import forge.ai.PlayerControllerAi;
+import forge.deck.Deck;
+import forge.game.Game;
+import forge.game.card.Card;
+import forge.game.card.CardCollection;
+import forge.game.combat.Combat;
+import forge.game.combat.CombatUtil;
+import forge.game.player.Player;
+import forge.game.player.PlayerController;
+import forge.game.spellability.SpellAbility;
+import forge.item.PaperCard;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+
+public final class PassiveLobbyPlayerAi extends LobbyPlayerAi {
+    public PassiveLobbyPlayerAi(final String name) {
+        super(name, null);
+    }
+
+    static boolean isLandsOnly(final Deck deck) {
+        if (deck.getMain().isEmpty()) {
+            return false;
+        }
+        for (final Map.Entry<PaperCard, Integer> entry : deck.getMain()) {
+            if (!entry.getKey().getRules().getType().isLand()) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    @Override
+    public Player createIngamePlayer(final Game game, final int id) {
+        final Player ai = new Player(getName(), game, id);
+        ai.setFirstController(new Controller(game, ai, this));
+        return ai;
+    }
+
+    @Override
+    public PlayerController createMindSlaveController(final Player master, final Player slave) {
+        return new Controller(slave.getGame(), slave, this);
+    }
+
+    static final class Controller extends PlayerControllerAi {
+        Controller(final Game game, final Player player, final PassiveLobbyPlayerAi lobbyPlayer) {
+            super(game, player, lobbyPlayer);
+        }
+
+        @Override
+        public List<SpellAbility> chooseSpellAbilityToPlay() {
+            final CardCollection lands = ComputerUtilAbility.getAvailableLandsToPlay(getGame(), player);
+            if (lands == null) {
+                return null;
+            }
+            for (final Card land : lands) {
+                final List<SpellAbility> abilities = new ArrayList<>(land.getAllPossibleAbilities(player, true));
+                abilities.removeIf(sa -> !sa.isLandAbility());
+                if (!abilities.isEmpty()) {
+                    return abilities;
+                }
+            }
+            return null;
+        }
+
+        @Override
+        public List<SpellAbility> chooseSaToActivateFromOpeningHand(final List<SpellAbility> usableFromOpeningHand) {
+            return new ArrayList<>();
+        }
+
+        @Override
+        public void declareAttackers(final Player attacker, final Combat combat) {
+            if (!CombatUtil.validateAttackers(combat)) {
+                super.declareAttackers(attacker, combat);
+            }
+        }
+    }
+}
