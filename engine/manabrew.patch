+    private static List<List<Player>> recordTriggerOrders(final Fixture f) {
+        final List<List<Player>> calls = new ArrayList<>();
+        final Set<SpellAbility> ordered = new HashSet<>();
+        final boolean[] placing = {false};
+        for (final Player p : f.game.getPlayers()) {
+            p.dangerouslySetController(new PlayerControllerAi(f.game, p, p.getLobbyPlayer()) {
+                @Override
+                public List<SpellAbility> orderSimultaneousSa(final List<SpellAbility> sas) {
+                    if (!placing[0]) {
+                        calls.add(triggerOrderCall(p, sas));
+                        ordered.addAll(sas);
+                    }
+                    return super.orderSimultaneousSa(sas);
+                }
+
+                @Override
+                public void orderAndPlaySimultaneousSa(final List<SpellAbility> activePlayerSAs) {
+                    if (!ordered.containsAll(activePlayerSAs)) {
+                        calls.add(triggerOrderCall(p, activePlayerSAs));
+                    }
+                    placing[0] = true;
+                    try {
+                        super.orderAndPlaySimultaneousSa(activePlayerSAs);
+                    } finally {
+                        placing[0] = false;
+                    }
+                }
+            });
+        }
+        return calls;
+    }
+
+    private static List<Player> triggerOrderCall(final Player asked, final List<SpellAbility> sas) {
+        final List<Player> call = new ArrayList<>();
+        call.add(asked);
+        for (final SpellAbility sa : sas) {
+            call.add(sa.getHostCard().getController());
+        }
+        return call;
+    }
+
+    private static Player asker(final List<List<Player>> calls, final Player controller) {
+        for (final List<Player> call : calls) {
+            if (call.subList(1, call.size()).contains(controller)) {
+                return call.get(0);
+            }
+        }
+        return null;
+    }
+
+    private static void resolveTriggers(final Fixture f) throws Exception {
+        withoutPrompts(f, "resolving the triggers", () -> {
+            f.game.getStack().addAllTriggeredAbilitiesToStack();
+            for (int i = 0; i < 20 && !f.game.getStack().isEmpty(); i++) {
+                f.game.getStack().resolveStack();
+            }
+        });
+        expect(f.game.getStack().isEmpty(), "the triggers never resolved");
+    }
