+        check("aFullPileTakesNoMore", UnboundedTokensTest::aFullPileTakesNoMore);
+        check("manyEffectsStopAtTheCap", UnboundedTokensTest::manyEffectsStopAtTheCap);
+        check("oneEffectMakesAtMostTheCapAcrossPiles", UnboundedTokensTest::oneEffectMakesAtMostTheCapAcrossPiles);
+        check("anotherPileIsNotFlagged", UnboundedTokensTest::anotherPileIsNotFlagged);
+        check("losingOneKeepsTheFlagAndAWipeClearsIt", UnboundedTokensTest::losingOneKeepsTheFlagAndAWipeClearsIt);
+        check("countsSeeTheRealTokens", UnboundedTokensTest::countsSeeTheRealTokens);
+        check("theCapAsksNobody", UnboundedTokensTest::theCapAsksNobody);
+        check("aSnapshotCopyKeepsTheFlag", UnboundedTokensTest::aSnapshotCopyKeepsTheFlag);
+        check("aTappedTokenStaysInItsPile", UnboundedTokensTest::aTappedTokenStaysInItsPile);
+        check("aStolenTokenLeavesThePile", UnboundedTokensTest::aStolenTokenLeavesThePile);
+        check("theSnapshotMarksUnboundedTokens", UnboundedTokensTest::theSnapshotMarksUnboundedTokens);
+        System.out.println(failed == 0 ? "PASS UnboundedTokensTest" : "FAIL UnboundedTokensTest: " + failed + " failed");
+        System.exit(failed == 0 ? 0 : 1);
+    }
+
+    private interface Check {
+        void run() throws Exception;
+    }
+
+    private static int failed;
+
+    private static void check(final String name, final Check check) {
+        try {
+            check.run();
+            System.out.println("ok " + name);
+        } catch (final Throwable failure) {
+            failed++;
+            System.out.println("FAIL " + name + ": " + failure);
+        }
+    }
+
+    private static void theCapIsFiveHundred() throws Exception {
+        final Object cap = Game.class.getField("UNBOUNDED_TOKENS").get(null);
+        expect(Integer.valueOf(500).equals(cap), "the cap is " + cap);
+    }
+
+    private static void oneOverTheCapMakesTheCapAndFlagsThePile() {
+        final Game game = aiGame();
+        final Player blue = game.getPlayers().get(0);
+        make(blue, "w_1_1_soldier", 501);
+        expect(tokens(game, "Soldier") == 500, "made " + tokens(game, "Soldier"));
+        expect(game.getUnboundedTokenKeys().size() == 1, "flagged " + game.getUnboundedTokenKeys());
+        expect(game.isUnboundedToken(first(game, "Soldier")), "a soldier is not unbounded");
+    }
+
+    private static void theCapItselfIsNotUnbounded() {
+        final Game game = aiGame();
+        make(game.getPlayers().get(0), "w_1_1_soldier", 500);
+        expect(tokens(game, "Soldier") == 500 && game.getUnboundedTokenKeys().isEmpty(),
+                "500 asked for: made " + tokens(game, "Soldier") + ", flagged " + game.getUnboundedTokenKeys());
+    }
+
+    private static void doublersCountBeforeTheClamp() {
+        final Game game = aiGame();
+        final Player blue = game.getPlayers().get(0);
+        for (int i = 0; i < 3; i++) {
+            add("Parallel Lives", blue, ZoneType.Battlefield);
+        }
+        game.getAction().checkStateEffects(true);
+        make(blue, "w_1_1_soldier", 62);
+        expect(tokens(game, "Soldier") == 496 && game.getUnboundedTokenKeys().isEmpty(),
+                "62 doubled three times: made " + tokens(game, "Soldier") + ", flagged " + game.getUnboundedTokenKeys());
+        make(blue, "w_1_1_soldier", 1);
+        expect(tokens(game, "Soldier") == 500 && game.getUnboundedTokenKeys().size() == 1,
+                "1 doubled three times onto 496: made " + tokens(game, "Soldier") + ", flagged " + game.getUnboundedTokenKeys());
+    }
+
+    private static void aFullPileTakesNoMore() {
+        final Game game = aiGame();
+        final Player blue = game.getPlayers().get(0);
+        make(blue, "w_1_1_soldier", 500);
+        make(blue, "w_1_1_soldier", 3);
+        expect(tokens(game, "Soldier") == 500 && game.getUnboundedTokenKeys().size() == 1,
+                "3 more onto 500: made " + tokens(game, "Soldier") + ", flagged " + game.getUnboundedTokenKeys());
+    }
+
+    private static void manyEffectsStopAtTheCap() {
+        final Game game = aiGame();
+        final Player blue = game.getPlayers().get(0);
+        for (int i = 0; i < 12; i++) {
+            make(blue, "w_1_1_soldier", 50);
+        }
+        expect(tokens(game, "Soldier") == 500 && game.getUnboundedTokenKeys().size() == 1,
+                "12 effects of 50: made " + tokens(game, "Soldier") + ", flagged " + game.getUnboundedTokenKeys());
+    }
+
+    private static void oneEffectMakesAtMostTheCapAcrossPiles() {
+        final Game game = aiGame();
+        final Player blue = game.getPlayers().get(0);
+        make(blue, "w_1_1_soldier,g_1_1_saproling", 300);
+        expect(tokens(game, "Soldier") + tokens(game, "Saproling") == 500,
+                "one effect of 300 soldiers and 300 saprolings made " + tokens(game, "Soldier") + " and " + tokens(game, "Saproling"));
+        expect(!game.getUnboundedTokenKeys().isEmpty(), "nothing was flagged");
+    }
+
+    private static void anotherPileIsNotFlagged() {
+        final Game game = aiGame();
+        final Player blue = game.getPlayers().get(0);
+        make(blue, "w_1_1_soldier", 600);
+        make(blue, "g_1_1_saproling", 3);
+        make(game.getPlayers().get(1), "w_1_1_soldier", 3);
+        expect(!game.isUnboundedToken(first(game, "Saproling")), "a saproling is unbounded");
+        expect(!game.isUnboundedToken(firstOf(game, "Soldier", game.getPlayers().get(1))), "the other player's soldier is unbounded");
+        expect(game.getUnboundedTokenKeys().size() == 1, "flagged " + game.getUnboundedTokenKeys());
+    }
+
+    private static void losingOneKeepsTheFlagAndAWipeClearsIt() {
+        final Game game = aiGame();
+        final Player blue = game.getPlayers().get(0);
+        make(blue, "w_1_1_soldier", 501);
+        game.getAction().moveToGraveyard(first(game, "Soldier"), null);
+        expect(tokens(game, "Soldier") == 499 && game.isUnboundedToken(first(game, "Soldier")),
+                "one gone: " + tokens(game, "Soldier") + ", flagged " + game.getUnboundedTokenKeys());
+        resolve(blue, "DB$ DestroyAll | ValidCards$ Creature");
+        game.getAction().checkStateEffects(true);
+        expect(tokens(game, "Soldier") == 0 && game.getUnboundedTokenKeys().isEmpty(),
+                "after a wipe: " + tokens(game, "Soldier") + ", flagged " + game.getUnboundedTokenKeys());
+        make(blue, "w_1_1_soldier", 2);
+        expect(!game.isUnboundedToken(first(game, "Soldier")), "a new pile after the wipe is unbounded");
+    }
+
+    private static void countsSeeTheRealTokens() {
+        final Game game = aiGame();
+        final Player blue = game.getPlayers().get(0);
+        make(blue, "w_1_1_soldier", 700);
+        final Card host = add("Grizzly Bears", blue, ZoneType.Battlefield);
+        final int counted = CardLists.getValidCardCount(game.getCardsIn(ZoneType.Battlefield), "Creature.token+YouCtrl", blue, host, null);
+        expect(counted == 500, "a Valid count saw " + counted);
+    }
+
+    private static void theCapAsksNobody() {
+        final Game game = aiGame();
+        final List<String> asked = new ArrayList<>();
+        game.setRunawayChoice((g, what, count, cap) -> asked.add(what));
+        make(game.getPlayers().get(0), "w_1_1_soldier", 2_000);
+        expect(asked.isEmpty() && !game.isGameOver(), "asked " + asked + ", over " + game.isGameOver());
+    }
+
+    private static void aSnapshotCopyKeepsTheFlag() {
+        final Game game = aiGame();
+        make(game.getPlayers().get(0), "w_1_1_soldier", 501);
+        final Game copy = new GameSnapshot(game).makeCopy();
+        expect(copy.getUnboundedTokenKeys().equals(game.getUnboundedTokenKeys()) && !copy.getUnboundedTokenKeys().isEmpty(),
+                "the copy has " + copy.getUnboundedTokenKeys() + ", the game " + game.getUnboundedTokenKeys());
+        expect(copy.isUnboundedToken(first(copy, "Soldier")), "a copied soldier is not unbounded");
+    }
+
+    private static void aTappedTokenStaysInItsPile() {
+        final Game game = aiGame();
+        make(game.getPlayers().get(0), "w_1_1_soldier", 501);
+        final Card soldier = first(game, "Soldier");
+        soldier.setTapped(true);
+        expect(game.isUnboundedToken(soldier), "a tapped soldier left the pile");
+    }
+
+    private static void aStolenTokenLeavesThePile() {
+        final Game game = aiGame();
+        make(game.getPlayers().get(0), "w_1_1_soldier", 501);
+        final Card soldier = first(game, "Soldier");
+        soldier.addTempController(game.getPlayers().get(1), game.getNextTimestamp());
+        game.getAction().controllerChangeZoneCorrection(soldier);
+        expect(soldier.getController() == game.getPlayers().get(1), "the soldier did not change control");
+        expect(!game.isUnboundedToken(soldier), "a stolen soldier is unbounded");
+        expect(game.isUnboundedToken(firstOf(game, "Soldier", game.getPlayers().get(0))), "the pile it left is not unbounded");
+    }
+
+    private static void theSnapshotMarksUnboundedTokens() throws Exception {
+        final ManaBrewInteractiveSession session = new ManaBrewInteractiveSession("unbounded-tokens-test");
+        final List<RegisteredPlayer> players = new ArrayList<>();
+        final Deck deck = new Deck();
+        players.add(new RegisteredPlayer(deck).setPlayer(new ManaBrewInteractiveLobbyPlayer("Blue", session)));
+        players.add(new RegisteredPlayer(deck).setPlayer(new LobbyPlayerAi("Yellow", null)));
+        final Game game = start(players);
+        session.attach(game.getMatch(), game, Set.of(), false);
+        final Field lock = ManaBrewInteractiveSession.class.getDeclaredField("gameLock");
+        lock.setAccessible(true);
+        ((ReentrantLock) lock.get(session)).lock();
+        final Player blue = game.getPlayers().get(0);
+        make(blue, "w_1_1_soldier", 501);
+        make(blue, "g_1_1_saproling", 2);
+        final String json = session.getSnapshotJson(0);
+        final int marked = json.split("\"unbounded\":true", -1).length - 1;
+        expect(marked == 500, "the snapshot marked " + marked + " cards unbounded");
+    }
+
+    private static void make(final Player p, final String script, final int amount) {
+        resolve(p, "DB$ Token | TokenAmount$ " + amount + " | TokenScript$ " + script);
+    }
+
+    private static void resolve(final Player p, final String ability) {
+        final Card host = add("Grizzly Bears", p, ZoneType.Hand);
+        final SpellAbility sa = AbilityFactory.getAbility(ability, host);
+        sa.setActivatingPlayer(p);
+        AbilityUtils.resolve(sa);
+        p.getZone(ZoneType.Hand).remove(host);
+    }
+
+    private static int tokens(final Game game, final String name) {
+        int n = 0;
+        for (final Card c : game.getCardsIn(ZoneType.Battlefield)) {
+            if (c.isToken() && c.getName().startsWith(name)) {
+                n++;
+            }
+        }
+        return n;
+    }
+
+    private static Card first(final Game game, final String name) {
+        return firstOf(game, name, null);
+    }
+
+    private static Card firstOf(final Game game, final String name, final Player controller) {
+        for (final Card c : game.getCardsIn(ZoneType.Battlefield)) {
+            if (c.isToken() && c.getName().startsWith(name) && (controller == null || c.getController() == controller)) {
+                return c;
+            }
+        }
+        throw new AssertionError("no " + name + " on the battlefield");
+    }
+
+    private static Game aiGame() {
+        final List<RegisteredPlayer> players = new ArrayList<>();
+        final Deck deck = new Deck();
+        players.add(new RegisteredPlayer(deck).setPlayer(new LobbyPlayerAi("Blue", null)));
+        players.add(new RegisteredPlayer(deck).setPlayer(new LobbyPlayerAi("Yellow", null)));
+        return start(players);
+    }
+
+    private static Game start(final List<RegisteredPlayer> players) {
+        final GameRules rules = new GameRules(GameType.Constructed);
+        final Game game = new Game(players, rules, new Match(rules, players, "UnboundedTokensTest"));
+        game.setAge(GameStage.Play);
+        game.getPhaseHandler().devModeSet(PhaseType.MAIN1, game.getPlayers().get(0));
+        game.getPhaseHandler().onStackResolved();
+        return game;
+    }
+
+    private static void expect(final boolean condition, final String message) {
+        if (!condition) {
+            throw new AssertionError(message);
+        }
+    }
+
+    private static Card add(final String name, final Player p, final ZoneType zone) {
+        IPaperCard paper = FModel.getMagicDb().getCommonCards().getCard(name);
+        if (paper == null) {
+            StaticData.instance().attemptToLoadCard(name);
+            paper = FModel.getMagicDb().getCommonCards().getCard(name);
+        }
+        final Card card = Card.fromPaperCard(paper, p);
+        card.setGameTimestamp(p.getGame().getNextTimestamp());
+        p.getZone(zone).add(card);
+        return card;
+    }
+}
