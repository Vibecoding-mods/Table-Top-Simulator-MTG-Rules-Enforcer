+    private static SpellAbility pickedAbility(final JsonObject op, final List<SpellAbility> abilities) {
+        if (op.has("abilityId")) {
+            final int id = op.get("abilityId").getAsInt();
+            for (final SpellAbility sa : abilities) {
+                if (sa.getId() == id) {
+                    return sa;
+                }
+            }
+            return null;
+        }
+        if (op.has("ability")) {
+            final int index = op.get("ability").getAsInt();
+            return index >= 0 && index < abilities.size() ? abilities.get(index) : null;
+        }
+        return null;
+    }
