+        final Fixture f = new Fixture(GameType.Commander);
+        f.red.loseConditionMet(GameLossReason.LifeReachedZero, null);
+        f.yellow.loseConditionMet(GameLossReason.LifeReachedZero, null);
+        gameOverCheck(f);
+        expect(!f.game.isGameOver(), "the game ended with one challenger left");
+        f.blue.loseConditionMet(GameLossReason.LifeReachedZero, null);
+        gameOverCheck(f);
+        expect(f.game.isGameOver() && f.white.getOutcome() != null && f.white.getOutcome().lossState == null, "the Juggernaut did not win");
+    }
+
+    private static void aTeamCommanderTeamWinsWhenBothOpponentsLose() throws Exception {
+        final Fixture f = new Fixture(GameType.Commander, false, new int[] {1, 1, 2, 2});
+        expect(f.white.getLife() == 40 && f.yellow.getLife() == 40, "life " + f.white.getLife() + "/" + f.yellow.getLife());
+        f.white.loseLife(5, false, false, null);
+        expect(f.red.getLife() == 40, "a teammate's life moved with White's");
+        f.yellow.loseConditionMet(GameLossReason.LifeReachedZero, null);
+        gameOverCheck(f);
+        expect(!f.game.isGameOver() && f.blue.isInGame(), "Blue left with Yellow, or the game ended");
+        f.blue.loseConditionMet(GameLossReason.LifeReachedZero, null);
+        gameOverCheck(f);
+        expect(f.game.isGameOver() && f.white.getOutcome().lossState == null && f.red.getOutcome().lossState == null,
+                "White + Red did not win");
+        final JsonObject rules = JsonParser.parseString(f.session.getSnapshotJson(0)).getAsJsonObject().getAsJsonObject("teamRules");
+        expect(rules != null && "teams".equals(rules.get("rule").getAsString()), "teamRules " + rules);
+    }
+
+    private static void phaseTrigger(final Fixture f, final PhaseType phase, final Player p) throws Exception {
+        f.game.getPhaseHandler().devModeSet(phase, p);
+        f.game.getTriggerHandler().resetActiveTriggers();
+        withoutPrompts(f, "the " + phase + " triggers", () -> {
+            f.game.getTriggerHandler().runTrigger(TriggerType.Phase, AbilityKey.mapFromPlayer(p), false);
+            f.game.getAction().checkStateEffects(true);
+        });
+    }
+
+    private static void library(final Player p, final int n) {
+        for (int i = 0; i < n; i++) {
+            add("Forest", p, ZoneType.Library);
+        }
+    }
+
+    private static void gameOverCheck(final Fixture f) throws Exception {
+        withoutPrompts(f, "checking the game over", () -> f.game.getAction().checkGameOverCondition());
+    }
+
+    private static void expectLost(final Player p, final GameLossReason reason) {
+        expect(p.getOutcome() != null && p.getOutcome().lossState == reason,
+                p.getName() + " did not lose by " + reason + ": " + (p.getOutcome() == null ? "in the game" : p.getOutcome().lossState));
+    }
+
+    private static void withoutPrompts(final Fixture f, final String what, final Runnable step) throws Exception {
+        final Throwable[] failure = new Throwable[1];
+        final Thread runner = new Thread(() -> {
+            try {
+                step.run();
+            } catch (final Throwable thrown) {
+                failure[0] = thrown;
+            }
+        }, what);
+        runner.setDaemon(true);
+        runner.start();
+        runner.join(60_000);
+        if (runner.isAlive()) {
+            throw new AssertionError(what + " asked " + f.session.getLatestPromptJson());
+        }
+        if (failure[0] != null) {
+            throw new AssertionError(what + " failed", failure[0]);
+        }
+    }
+
+    private static void expect(final boolean condition, final String message) {
+        if (!condition) {
+            throw new AssertionError(message);
+        }
+    }
+
+    private static Card add(final String name, final Player p, final ZoneType zone) {
+        IPaperCard paper = FModel.getMagicDb().getCommonCards().getCard(name);
+        if (paper == null) {
+            StaticData.instance().attemptToLoadCard(name);
+            paper = FModel.getMagicDb().getCommonCards().getCard(name);
+        }
+        final Card card = Card.fromPaperCard(paper, p);
+        card.setGameTimestamp(p.getGame().getNextTimestamp());
+        p.getZone(zone).add(card);
+        return card;
+    }
+
+    private static final class Fixture {
+        final ManaBrewInteractiveSession session = new ManaBrewInteractiveSession("player-rules-test");
+        final Game game;
+        final Player white;
+        final Player red;
+        final Player yellow;
+        final Player blue;
+
+        Fixture(final GameType type) {
+            this(type, false, new int[] {1, 2, 2, 2});
+        }
+
+        Fixture(final GameType type, final boolean recording) {
+            this(type, recording, new int[] {1, 2, 2, 2});
+        }
+
+        Fixture(final GameType type, final boolean recording, final int[] teams) {
+            final List<RegisteredPlayer> players = new ArrayList<>();
+            final String[] names = {"White", "Red", "Yellow", "Blue"};
+            for (int i = 0; i < 4; i++) {
+                final RegisteredPlayer rp = new RegisteredPlayer(new Deck()).setPlayer(new LobbyPlayerAi(names[i], null));
+                rp.setStartingLife(40);
+                rp.setTeamNumber(teams[i]);
+                players.add(rp);
+            }
+            final GameRules rules = new GameRules(type);
+            rules.setAppliedVariants(EnumSet.of(type));
+            game = new Game(players, rules, new Match(rules, players, "PlayerRulesTest"));
+            game.setAge(GameStage.Play);
+            game.getPhaseHandler().devModeSet(PhaseType.MAIN1, game.getPlayers().get(0));
+            game.getPhaseHandler().onStackResolved();
+            white = game.getPlayers().get(0);
+            red = game.getPlayers().get(1);
+            yellow = game.getPlayers().get(2);
+            blue = game.getPlayers().get(3);
+            session.attach(game.getMatch(), game, Set.of(), recording);
+        }
+    }
+}
