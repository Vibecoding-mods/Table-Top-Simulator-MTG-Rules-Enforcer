+    private static void theTeamUntapsTogether() throws Exception {
+        final Fixture f = new Fixture(true);
+        final Map<Player, Card> lands = tappedLands(f);
+        f.game.getPhaseHandler().devModeSet(PhaseType.CLEANUP, f.blue, 2);
+        stepTo(f, PhaseType.UPKEEP);
+        expect(f.game.getPhaseHandler().getPlayerTurn() == f.white, "turn 3 went to " + f.game.getPhaseHandler().getPlayerTurn());
+        expect(lands.get(f.white).isUntapped() && lands.get(f.red).isUntapped(), "the active team's lands did not all untap: White "
+                + lands.get(f.white).isUntapped() + ", Red " + lands.get(f.red).isUntapped());
+        expect(lands.get(f.yellow).isTapped() && lands.get(f.blue).isTapped(), "the other team untapped");
+        final Fixture l1 = new Fixture(false);
+        final Map<Player, Card> l1Lands = tappedLands(l1);
+        l1.game.getPhaseHandler().devModeSet(PhaseType.CLEANUP, l1.blue, 4);
+        stepTo(l1, PhaseType.UPKEEP);
+        expect(l1Lands.get(l1.white).isUntapped() && l1Lands.get(l1.red).isTapped(), "level 1: White's untap step untapped Red: "
+                + l1Lands.get(l1.red).isUntapped());
+    }
