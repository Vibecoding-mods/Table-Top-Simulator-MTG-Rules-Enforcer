+    private static List<SpellAbility> freeSpells(final Card card, final Player player) {
+        final List<SpellAbility> spells = new ArrayList<>();
+        for (final SpellAbility sa : card.getAllPossibleAbilities(player, false)) {
+            if (sa.isSpell()) {
+                spells.add(sa);
+            }
+        }
+        return spells;
+    }
