+import java.util.concurrent.locks.ReentrantLock;
+
+public final class CardStateFlagsTest {
+    private CardStateFlagsTest() {}
+
+    private static final String DOESNT_UNTAP = "This card doesn't untap during your next untap step.";
+
+    public static void main(final String[] args) throws Exception {
+        GuiBase.setInterface(new HeadlessGuiBase("forge/forge-gui/"));
+        FModel.initialize(null, prefs -> {
+            prefs.setPref(FPref.LOAD_CARD_SCRIPTS_LAZILY, true);
+            prefs.setPref(FPref.UI_LANGUAGE, "en-US");
+            return null;
+        });
+
+        check("exertedLastsPastCleanupUntilItsControllersUntapStep", CardStateFlagsTest::exertedLastsPastCleanupUntilItsControllersUntapStep);
+        check("doesntUntapKeywordLastsUntilTheUntapStep", CardStateFlagsTest::doesntUntapKeywordLastsUntilTheUntapStep);
+        check("plainCreatureCarriesNoFlags", CardStateFlagsTest::plainCreatureCarriesNoFlags);
+        check("monstrousIsSent", CardStateFlagsTest::monstrousIsSent);
+        check("saddledNamesItsSaddlersUntilCleanup", CardStateFlagsTest::saddledNamesItsSaddlersUntilCleanup);
+        check("harnessedIsSent", CardStateFlagsTest::harnessedIsSent);
+        check("caseSolvedIsSent", CardStateFlagsTest::caseSolvedIsSent);
+        check("roomNamesItsUnlockedDoor", CardStateFlagsTest::roomNamesItsUnlockedDoor);
+        check("soulbondPairNamesEachOther", CardStateFlagsTest::soulbondPairNamesEachOther);
+        check("curseNamesThePlayerItIsAttachedTo", CardStateFlagsTest::curseNamesThePlayerItIsAttachedTo);
+        check("battleNamesItsProtector", CardStateFlagsTest::battleNamesItsProtector);
+        check("cantBlockKeywordIsSent", CardStateFlagsTest::cantBlockKeywordIsSent);
+        check("pacifismMakesItUnableToAttackOrBlock", CardStateFlagsTest::pacifismMakesItUnableToAttackOrBlock);
+        check("defenderCantAttack", CardStateFlagsTest::defenderCantAttack);
+        check("attacksEachCombatIsMustAttack", CardStateFlagsTest::attacksEachCombatIsMustAttack);
+        check("faceDownRoomHidesItsUnlockedDoors", CardStateFlagsTest::faceDownRoomHidesItsUnlockedDoors);
+        check("seatsWhileTheGameWaitsShareOneRound", CardStateFlagsTest::seatsWhileTheGameWaitsShareOneRound);
+        check("theNextWaitSeesWhatChanged", CardStateFlagsTest::theNextWaitSeesWhatChanged);
+        System.out.println(failed == 0 ? "PASS CardStateFlagsTest" : "FAIL CardStateFlagsTest: " + failed + " failed");
+        System.exit(failed == 0 ? 0 : 1);
+    }
+
+    private interface Check {
+        void run() throws Exception;
+    }
+
+    private static int failed;
+
+    private static void check(final String name, final Check check) {
+        try {
+            check.run();
+            System.out.println("ok " + name);
+        } catch (final Throwable failure) {
+            failed++;
+            System.out.println("FAIL " + name + ": " + failure);
+        }
+    }
+
+    private static void exertedLastsPastCleanupUntilItsControllersUntapStep() {
+        final Fixture f = new Fixture();
+        final Card bears = f.add("Grizzly Bears", f.p0);
+        bears.setTapped(true);
+        bears.exert(f.p0);
+        expect(flag(f.card(bears), "exerted"), "an exerted creature is not exerted");
+        bears.onCleanupPhase(f.p0);
+        expect(bears.getExertedThisTurn() == 0, "cleanup kept the exert count");
+        expect(flag(f.card(bears), "exerted"), "the exert marker is gone after cleanup: " + f.card(bears));
+        f.untapStep(f.p1);
+        expect(flag(f.card(bears), "exerted"), "another player's untap step cleared the exert marker");
+        f.untapStep(f.p0);
+        expect(bears.isTapped(), "the exerted creature untapped in its controller's untap step");
+        expect(!flag(f.card(bears), "exerted"), "the exert marker outlived its controller's untap step");
+    }
+
+    private static void doesntUntapKeywordLastsUntilTheUntapStep() {
+        final Fixture f = new Fixture();
+        final Card bears = f.add("Grizzly Bears", f.p0);
+        bears.setTapped(true);
+        bears.addHiddenExtrinsicKeywords(f.game.getNextTimestamp(), 0, List.of(DOESNT_UNTAP));
+        expect(flag(f.card(bears), "skipsNextUntap"), "a Frost Breath creature does not skip its next untap");
+        bears.onCleanupPhase(f.p0);
+        expect(flag(f.card(bears), "skipsNextUntap"), "cleanup cleared skipsNextUntap");
+        f.untapStep(f.p0);
+        expect(bears.isTapped(), "the frozen creature untapped");
+        expect(!flag(f.card(bears), "skipsNextUntap"), "skipsNextUntap outlived the untap step");
+    }
+
+    private static void plainCreatureCarriesNoFlags() {
+        final Fixture f = new Fixture();
+        final Card bears = f.add("Grizzly Bears", f.p0);
+        final JsonObject seen = f.card(bears);
+        for (final String name : List.of("exerted", "skipsNextUntap", "monstrous", "saddled", "harnessed", "solved",
+                "cantAttack", "cantBlock", "mustAttack")) {
+            expect(!flag(seen, name), name + " is set on a plain creature: " + seen);
+        }
+        for (final String name : List.of("saddledBy", "unlockedDoors", "pairedWith", "attachedToPlayer", "protectorId")) {
+            expect(!seen.has(name), name + " is sent for a plain creature: " + seen);
+        }
+    }
+
+    private static void monstrousIsSent() {
+        final Fixture f = new Fixture();
+        final Card polukranos = f.add("Polukranos, World Eater", f.p0);
+        expect(!flag(f.card(polukranos), "monstrous"), "Polukranos is monstrous before its ability");
+        polukranos.setMonstrous(true);
+        expect(flag(f.card(polukranos), "monstrous"), "a monstrous Polukranos is not monstrous");
+    }
+
+    private static void saddledNamesItsSaddlersUntilCleanup() {
+        final Fixture f = new Fixture();
+        final Card bronco = f.add("Caustic Bronco", f.p0);
+        final Card bears = f.add("Grizzly Bears", f.p0);
+        bronco.setSaddled(true);
+        bronco.addSaddledByThisTurn(new CardCollection(bears));
+        final JsonObject seen = f.card(bronco);
+        expect(flag(seen, "saddled"), "a saddled mount is not saddled: " + seen);
+        expect(ids(seen, "saddledBy").equals(List.of(SnapshotExtractor.javaCardId(bears))),
+                "saddledBy does not name the saddler: " + seen);
+        bronco.onCleanupPhase(f.p0);
+        final JsonObject after = f.card(bronco);
+        expect(!flag(after, "saddled") && !after.has("saddledBy"), "the mount is still saddled after cleanup: " + after);
+    }
+
+    private static void harnessedIsSent() {
+        final Fixture f = new Fixture();
+        final Card stone = f.add("The Mind Stone", f.p0);
