+
+    private static int indexOf(final List<Card> cards, final String name) {
+        for (int i = 0; i < cards.size(); i++) {
+            if (cards.get(i).getName().equals(name)) {
+                return i;
+            }
+        }
+        return -1;
+    }
+
+    private static List<String> names(final Iterable<Card> cards) {
+        final List<String> out = new ArrayList<>();
+        for (final Card card : cards) {
+            out.add(card.getName());
+        }
+        return out;
+    }
+
+    private static Card add(final String name, final Player p, final ZoneType zone) {
+        IPaperCard paper = StaticData.instance().fetchCard(name);
+        if (paper == null) {
+            StaticData.instance().attemptToLoadCard(name);
+            paper = StaticData.instance().fetchCard(name);
+        }
+        if (paper == null) {
+            throw new AssertionError("no card " + name);
+        }
+        final Card card = Card.fromPaperCard(paper, p);
+        card.setGameTimestamp(p.getGame().getNextTimestamp());
+        p.getZone(zone).add(card);
+        return card;
+    }
+
+    private static void expect(final boolean condition, final String message) {
+        if (!condition) {
+            throw new AssertionError(message);
+        }
+    }
+
+    static JsonObject answer(final JsonObject prompt) {
+        final JsonObject input = prompt.getAsJsonObject("input");
+        final String type = input.get("type").getAsString();
+        final JsonObject out = new JsonObject();
+        switch (type) {
+            case "chooseAction" -> out.addProperty("type", "pass");
+            case "payManaCost" -> out.addProperty("type", "cancel");
+            case "chooseBoardTargets" -> {
+                final JsonArray candidates = input.getAsJsonArray("candidates");
+                final int k = Math.min(Math.min(input.get("maxTargets").getAsInt(), Math.max(input.get("minTargets").getAsInt(), 1)), candidates.size());
+                if (k == 0 && input.has("cancellable") && input.get("cancellable").getAsBoolean()) {
+                    out.addProperty("type", "cancel");
+                } else {
+                    out.addProperty("type", "boardTargets");
+                    final JsonArray chosen = new JsonArray();
+                    for (int i = 0; i < k; i++) {
+                        final JsonObject c = candidates.get(i).getAsJsonObject();
+                        final JsonObject ref = new JsonObject();
+                        ref.add("kind", c.get("kind"));
+                        ref.add("id", c.get("id"));
+                        chosen.add(ref);
+                    }
+                    out.add("chosen", chosen);
+                }
+            }
+            case "chooseBoolean" -> {
+                out.addProperty("type", "decision");
+                out.addProperty("value", true);
+            }
+            case "chooseCards" -> {
+                out.addProperty("type", "chooseCardsDecision");
+                final JsonArray ids = new JsonArray();
+                final JsonArray cards = input.getAsJsonArray("cards");
+                for (int i = 0; i < Math.min(input.get("min").getAsInt(), cards.size()); i++) {
+                    ids.add(cards.get(i).getAsJsonObject().get("id"));
+                }
+                out.add("chosenCardIds", ids);
+            }
+            case "chooseNumber" -> {
+                out.addProperty("type", "numberDecision");
+                out.add("chosenNumber", input.get("min"));
+            }
+            case "chooseFromSelection" -> {
+                out.addProperty("type", "selectionDecision");
+                final int k = Math.min(Math.min(Math.max(input.get("minTotal").getAsInt(), 1), input.get("maxTotal").getAsInt()),
+                        input.getAsJsonArray("options").size());
+                final JsonArray indices = new JsonArray();
+                for (int i = 0; i < k; i++) {
+                    indices.add(i);
+                }
+                out.add("chosenIndices", indices);
+            }
+            case "chooseAttackers" -> {
+                out.addProperty("type", "declareAttackers");
+                out.add("assignments", new JsonArray());
+            }
+            case "chooseBlockers" -> {
+                out.addProperty("type", "declareBlockers");
+                out.add("assignments", new JsonArray());
+            }
+            case "chooseDamageAssignmentOrder" -> {
+                out.addProperty("type", "damageAssignmentOrderDecision");
+                out.add("orderedBlockerIds", input.get("blockerIds"));
+            }
+            case "chooseCombatDamageAssignment" -> {
+                out.addProperty("type", "combatDamageAssignmentDecision");
+                final JsonArray blockers = input.getAsJsonArray("blockerIds");
+                final JsonObject a = new JsonObject();
+                a.add("assigneeId", blockers.isEmpty() ? input.get("defenderId") : blockers.get(0));
+                a.add("damage", input.get("totalDamage"));
+                final JsonArray assignments = new JsonArray();
+                assignments.add(a);
+                out.add("assignments", assignments);
+            }
+            case "reorder" -> {
+                out.addProperty("type", "reorderDecision");
+                final JsonArray ids = new JsonArray();
+                for (final JsonElement item : input.getAsJsonArray("items")) {
+                    ids.add(item.getAsJsonObject().get("id"));
+                }
+                out.add("orderedIds", ids);
+            }
+            case "scry" -> {
+                out.addProperty("type", "scryDecision");
+                final JsonArray zones = input.getAsJsonArray("zones");
+                int top = 0;
+                for (int i = 0; i < zones.size(); i++) {
+                    if (zones.get(i).getAsString().equals("libraryTop")) {
+                        top = i;
+                    }
+                }
+                final JsonArray zoneIds = new JsonArray();
+                for (int i = 0; i < zones.size(); i++) {
+                    final JsonArray ids = new JsonArray();
+                    if (i == top) {
+                        for (final JsonElement c : input.getAsJsonArray("cards")) {
+                            ids.add(c.getAsJsonObject().get("id"));
+                        }
+                    }
+                    zoneIds.add(ids);
+                }
+                out.add("zoneCardIds", zoneIds);
+            }
+            case "chooseColor" -> {
+                out.addProperty("type", "colorDecision");
+                final JsonObject colors = new JsonObject();
+                colors.add(input.getAsJsonArray("validColors").get(0).getAsString(), input.get("amount"));
+                out.add("chosenColors", colors);
+            }
+            case "revealCards" -> out.addProperty("type", "revealCardsAcknowledged");
+            case "diceRolled" -> out.addProperty("type", "diceRolledAcknowledged");
+            default -> throw new AssertionError("unhandled prompt type " + type + ": " + prompt);
+        }
+        final JsonObject action = new JsonObject();
+        action.addProperty("type", type);
+        action.add("output", out);
+        return action;
+    }
+
+    private interface Step {
+        void run();
+    }
+
+    private static final class Fixture {
+        final ManaBrewInteractiveSession session = new ManaBrewInteractiveSession("archenemy-sweep");
+        final Game game;
+        final Player white;
+        final Player blue;
+        final ReentrantLock lock;
+        final Set<String> resolved = new TreeSet<>();
+
+        Fixture() throws Exception {
+            final List<RegisteredPlayer> players = new ArrayList<>();
+            players.add(new RegisteredPlayer(new Deck()).setPlayer(new ManaBrewInteractiveLobbyPlayer("White", session)));
+            players.add(new RegisteredPlayer(new Deck()).setPlayer(new ManaBrewInteractiveLobbyPlayer("Blue", session)));
+            players.get(0).setTeamNumber(Archenemy.ARCHENEMY_TEAM);
+            players.get(1).setTeamNumber(Archenemy.OPPONENTS_TEAM);
+            final GameRules rules = new GameRules(GameType.Constructed);
+            rules.setAppliedVariants(EnumSet.of(GameType.Constructed, GameType.Archenemy));
+            game = new Game(players, rules, new Match(rules, players, "ArchenemySchemeSweepTest"));
+            game.setAge(GameStage.Play);
+            white = game.getPlayers().get(0);
+            blue = game.getPlayers().get(1);
+            for (final Player p : game.getPlayers()) {
+                for (final String card : List.of("Grizzly Bears", "Serra Angel", "Ornithopter", "Plains", "Island", "Swamp", "Mountain", "Forest", "Glorious Anthem")) {
+                    final Card c = add(card, p, ZoneType.Battlefield);
+                    c.setSickness(false);
+                }
+                for (final String card : List.of("Lightning Bolt", "Grizzly Bears", "Island")) {
+                    add(card, p, ZoneType.Hand);
+                }
+                for (final String card : List.of("Llanowar Elves", "Divination")) {
+                    add(card, p, ZoneType.Graveyard);
+                }
+                for (int i = 0; i < 10; i++) {
+                    add(i % 2 == 0 ? "Grizzly Bears" : "Forest", p, ZoneType.Library);
+                }
+            }
+            game.getPhaseHandler().devModeSet(PhaseType.MAIN1, white, 1);
+            game.getPhaseHandler().onStackResolved();
+            session.attach(game.getMatch(), game, Set.of(), false);
+            final Field field = ManaBrewInteractiveSession.class.getDeclaredField("gameLock");
+            field.setAccessible(true);
+            lock = (ReentrantLock) field.get(session);
+            game.getAction().checkStaticAbilities();
+        }
+
+        Card inCommand(final String name) {
+            for (final Card c : white.getCardsIn(ZoneType.Command)) {
+                if (c.getName().equals(name)) {
+                    return c;
+                }
+            }
+            return null;
+        }
+
+        boolean inSchemeDeck(final String name) {
+            return white.getCardsIn(ZoneType.SchemeDeck).stream().anyMatch(c -> c.getName().equals(name));
+        }
+
+        void settle() {
+            for (int i = 0; i < 40; i++) {
+                game.getAction().checkStateEffects(true);
+                game.getStack().addAllTriggeredAbilitiesToStack();
+                if (game.getStack().isEmpty() || game.isGameOver()) {
+                    game.getAction().checkStateEffects(true);
+                    return;
+                }
+                final SpellAbility top = game.getStack().peekAbility();
+                if (top != null && top.getHostCard() != null) {
+                    resolved.add(top.getHostCard().getName());
+                }
+                game.getStack().resolveStack();
+            }
+            throw new AssertionError("the stack never emptied");
+        }
+
+        void run(final Set<String> prompts, final Step step) throws Exception {
+            final Throwable[] failure = new Throwable[1];
+            final Thread worker = new Thread(() -> {
+                lock.lock();
+                try {
+                    step.run();
+                } catch (final Throwable thrown) {
+                    failure[0] = thrown;
+                } finally {
+                    lock.unlock();
+                }
+            }, "scheme-sweep");
+            worker.setDaemon(true);
+            worker.start();
+            final long deadline = System.currentTimeMillis() + TIMEOUT_MS;
+            long answered = 0;
+            int answers = 0;
+            while (worker.isAlive()) {
+                if (System.currentTimeMillis() > deadline) {
+                    session.close();
+                    throw new AssertionError("stuck after " + answers + " answers; last prompt " + session.getLatestPromptJson());
+                }
+                final String json = session.getLatestPromptJson();
+                if (json != null) {
+                    final JsonObject prompt = JsonParser.parseString(json).getAsJsonObject();
+                    final long id = prompt.get("promptId").getAsLong();
+                    if (id > answered) {
+                        answered = id;
+                        if (++answers > MAX_ANSWERS) {
+                            session.close();
+                            throw new AssertionError("asked more than " + MAX_ANSWERS + " prompts; last " + json);
+                        }
+                        final String type = prompt.getAsJsonObject("input").get("type").getAsString();
+                        final String who = prompt.has("decidingPlayerId") ? prompt.get("decidingPlayerId").getAsString() : "?";
+                        prompts.add(type + "@" + (who.equals("player-0") ? "archenemy" : who.equals("player-1") ? "opponent" : who));
+                        session.submitAction(answer(prompt).toString());
+                    }
+                }
+                Thread.sleep(5);
+            }
+            if (failure[0] != null) {
+                throw new AssertionError("threw " + failure[0], failure[0]);
+            }
+        }
+    }
+}
