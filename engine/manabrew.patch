+            sb.append(sb.length() == 0 ? "" : ", ").append(e.getKey().getName()).append(' ').append(e.getValue());
+        }
+        return sb.toString();
+    }
+
+    private static int count(final List<Card> hosts, final Card card) {
+        int n = 0;
+        for (final Card c : hosts) {
+            if (c.equals(card)) {
+                n++;
+            }
+        }
+        return n;
+    }
+
+    @SuppressWarnings("unchecked")
+    private static List<Card> triggeredHosts(final Fixture f) throws Exception {
+        final List<Card> hosts = new ArrayList<>();
+        final Field waiting = MagicStack.class.getDeclaredField("simultaneousStackEntryList");
+        waiting.setAccessible(true);
+        for (final SpellAbility sa : (List<SpellAbility>) waiting.get(f.game.getStack())) {
+            hosts.add(sa.getHostCard());
+        }
+        for (final SpellAbilityStackInstance si : f.game.getStack()) {
+            hosts.add(si.getSourceCard());
+        }
+        return hosts;
+    }
+
+    private static void resolve(final Fixture f, final SpellAbility sa, final Player activator) throws Exception {
+        sa.setActivatingPlayer(activator);
+        withoutPrompts(f, "resolving " + sa.getHostCard(), () -> AbilityUtils.resolve(sa));
+    }
+
+    private static void withoutPrompts(final Fixture f, final String what, final Runnable step) throws Exception {
+        final Throwable[] failure = new Throwable[1];
+        final Thread runner = new Thread(() -> {
+            try {
+                step.run();
+            } catch (final Throwable thrown) {
+                failure[0] = thrown;
+            }
+        }, what);
+        runner.setDaemon(true);
+        runner.start();
+        runner.join(60_000);
+        if (runner.isAlive()) {
+            throw new AssertionError(what + " asked " + f.session.getLatestPromptJson());
+        }
+        if (failure[0] != null) {
+            throw new AssertionError(what + " failed: " + failure[0], failure[0]);
+        }
+    }
+
+    private static void expect(final boolean condition, final String message) {
+        if (!condition) {
+            throw new AssertionError(message);
+        }
+    }
+
+    private static Card add(final String name, final Player p, final ZoneType zone) {
