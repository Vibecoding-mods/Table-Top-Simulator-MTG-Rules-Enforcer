+    }
+
+    private static JsonObject attacker(final JsonObject input, final Card card) {
+        final String id = SnapshotExtractor.javaCardId(card);
+        for (final JsonElement e : input.getAsJsonArray("attackers")) {
+            if (id.equals(e.getAsJsonObject().get("attackerId").getAsString())) {
+                return e.getAsJsonObject();
+            }
+        }
+        throw new AssertionError(card + " is not offered as an attacker");
+    }
+
+    private static JsonObject damageOf(final JsonObject input, final Card card, final String defenderId) {
+        final JsonObject a = attacker(input, card);
+        if (!a.has("damage")) {
+            throw new AssertionError("no damage on " + a);
+        }
+        for (final JsonElement e : a.getAsJsonArray("damage")) {
+            if (defenderId.equals(e.getAsJsonObject().get("defenderId").getAsString())) {
+                return e.getAsJsonObject();
+            }
+        }
+        throw new AssertionError("no damage at " + defenderId + " on " + a);
